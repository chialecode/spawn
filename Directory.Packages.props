<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET 10 LTS Base & Infrastructure -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.15" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />

    <!-- Desktop UI, Graphics, Audio & Serialization -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="WPF-UI" Version="4.2.1" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.Views.WPF" Version="3.119.4" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="NAudio.Wasapi" Version="2.4.0" />

    <!-- M3 Progress Module & Trainer Worker (MIT, 7-day cooldown verified 2026-11-14) -->
    <PackageVersion Include="SharpCompress" Version="0.50.9" />
    <PackageVersion Include="AngleSharp" Version="1.10.3" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.371" />

    <!-- M4 Save Time Machine & CAS Storage (BSD-2-Clause / MIT, 7-day cooldown verified 2026-11-25) -->
    <PackageVersion Include="Blake3" Version="3.0.2" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />

    <!-- Testing & Gate Verification -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
