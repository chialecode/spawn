<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark Geek Palette (#181B20 / #1B1E24 Sidebar + #14161A Main Panel + #2A2F3A Hairline + #3B82F6 Accent) -->
    <Color x:Key="RailBackgroundColor">#181B20</Color>
    <Color x:Key="SidebarBackgroundColor">#1B1E24</Color>
    <Color x:Key="PageBackgroundColor">#14161A</Color>
    <Color x:Key="SubtleSurfaceColor">#22262F</Color>
    <Color x:Key="CapsuleInputBackgroundColor">#1C2028</Color>
    <Color x:Key="FloatingMenuBackgroundColor">#1E222B</Color>

    <Color x:Key="DividerColor">#2A2F3A</Color>
    <Color x:Key="ControlBorderColor">#363C49</Color>
    <Color x:Key="ItemHoverColor">#262B35</Color>

    <Color x:Key="AccentColor">#3B82F6</Color>
    <Color x:Key="AccentHoverColor">#60A5FA</Color>
    <Color x:Key="AccentPressedColor">#2563EB</Color>
    <Color x:Key="SelectedPillColor">#172B4D</Color>

    <Color x:Key="PrimaryTextColor">#F3F4F6</Color>
    <Color x:Key="SecondaryTextColor">#9CA3AF</Color>
    <Color x:Key="MutedTextColor">#6B7280</Color>

    <SolidColorBrush x:Key="RailBackgroundBrush" Color="{StaticResource RailBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="{StaticResource SubtleSurfaceColor}" />
    <SolidColorBrush x:Key="CapsuleInputBackgroundBrush" Color="{StaticResource CapsuleInputBackgroundColor}" />
    <SolidColorBrush x:Key="FloatingMenuBackgroundBrush" Color="{StaticResource FloatingMenuBackgroundColor}" />

    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}" />
    <SolidColorBrush x:Key="ItemHoverBrush" Color="{StaticResource ItemHoverColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="SelectedPillBrush" Color="{StaticResource SelectedPillColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />

    <!-- Semantic Status & Rarity Brushes -->
    <SolidColorBrush x:Key="RunningGreenBrush" Color="#10B981" />
    <SolidColorBrush x:Key="RunningGreenSoftBrush" Color="#132F26" />
    <SolidColorBrush x:Key="WarningAmberBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="WarningAmberSoftBrush" Color="#332711" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#3B181E" />
    <SolidColorBrush x:Key="RareBadgeForegroundBrush" Color="#C084FC" />
    <SolidColorBrush x:Key="RareBadgeBackgroundBrush" Color="#2E1B46" />
    <SolidColorBrush x:Key="RareBadgeBorderBrush" Color="#583285" />
    <SolidColorBrush x:Key="InfoBannerBackgroundBrush" Color="#17253B" />
    <SolidColorBrush x:Key="InfoBannerBorderBrush" Color="#26436E" />
    <SolidColorBrush x:Key="Tier0BadgeForegroundBrush" Color="#10B981" />
    <SolidColorBrush x:Key="Tier0BadgeBackgroundBrush" Color="#132F26" />
    <SolidColorBrush x:Key="Tier1BadgeForegroundBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="Tier1BadgeBackgroundBrush" Color="#332711" />
    <SolidColorBrush x:Key="Tier23BadgeForegroundBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="Tier23BadgeBackgroundBrush" Color="#3B181E" />
    <SolidColorBrush x:Key="DangerSoftBannerBackgroundBrush" Color="#2C1519" />
    <SolidColorBrush x:Key="DangerSoftBannerBorderBrush" Color="#7F1D1D" />
    <SolidColorBrush x:Key="WarningSoftBannerBackgroundBrush" Color="#2D220E" />
    <SolidColorBrush x:Key="WarningSoftBannerBorderBrush" Color="#78350F" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#374151" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#4B5563" />
</ResourceDictionary>
