<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Clean Light Default Palette (#F7F7F7 Sidebar + #FFFFFF Main Panel + #EAEAEA Hairline + #1677FF Accent) -->
    <Color x:Key="RailBackgroundColor">#F7F7F7</Color>
    <Color x:Key="SidebarBackgroundColor">#F7F7F7</Color>
    <Color x:Key="PageBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SubtleSurfaceColor">#F2F3F5</Color>
    <Color x:Key="CapsuleInputBackgroundColor">#FFFFFF</Color>
    <Color x:Key="FloatingMenuBackgroundColor">#FFFFFF</Color>

    <Color x:Key="DividerColor">#EAEAEA</Color>
    <Color x:Key="ControlBorderColor">#DCDCDC</Color>
    <Color x:Key="ItemHoverColor">#EBEBEB</Color>

    <Color x:Key="AccentColor">#1677FF</Color>
    <Color x:Key="AccentHoverColor">#0958D9</Color>
    <Color x:Key="AccentPressedColor">#003EB3</Color>
    <Color x:Key="SelectedPillColor">#E6F0FF</Color>

    <Color x:Key="PrimaryTextColor">#1F1F1F</Color>
    <Color x:Key="SecondaryTextColor">#6B6B6B</Color>
    <Color x:Key="MutedTextColor">#999999</Color>
    <Color x:Key="DisabledSurfaceColor">#F0F1F2</Color>
    <Color x:Key="DisabledBorderColor">#E2E3E5</Color>
    <Color x:Key="DisabledTextColor">#A8A8A8</Color>

    <SolidColorBrush x:Key="RailBackgroundBrush" Color="{StaticResource RailBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="{StaticResource SubtleSurfaceColor}" />
    <SolidColorBrush x:Key="CapsuleInputBackgroundBrush" Color="{StaticResource CapsuleInputBackgroundColor}" />
    <SolidColorBrush x:Key="FloatingMenuBackgroundBrush" Color="{StaticResource FloatingMenuBackgroundColor}" />

    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}" />
    <SolidColorBrush x:Key="ItemHoverBrush" Color="{StaticResource ItemHoverColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="SelectedPillBrush" Color="{StaticResource SelectedPillColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="{StaticResource DisabledSurfaceColor}" />
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="{StaticResource DisabledBorderColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />

    <!-- Semantic Status & Rarity Brushes -->
    <SolidColorBrush x:Key="RunningGreenBrush" Color="#10B981" />
    <SolidColorBrush x:Key="RunningGreenSoftBrush" Color="#E6F8F1" />
    <SolidColorBrush x:Key="WarningAmberBrush" Color="#D97706" />
    <SolidColorBrush x:Key="WarningAmberSoftBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="RareBadgeForegroundBrush" Color="#7C3AED" />
    <SolidColorBrush x:Key="RareBadgeBackgroundBrush" Color="#F3E8FF" />
    <SolidColorBrush x:Key="RareBadgeBorderBrush" Color="#DDD6FE" />
    <SolidColorBrush x:Key="InfoBannerBackgroundBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="InfoBannerBorderBrush" Color="#BFDBFE" />
    <SolidColorBrush x:Key="Tier0BadgeForegroundBrush" Color="#10B981" />
    <SolidColorBrush x:Key="Tier0BadgeBackgroundBrush" Color="#E6F8F1" />
    <SolidColorBrush x:Key="Tier1BadgeForegroundBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="Tier1BadgeBackgroundBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="Tier23BadgeForegroundBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="Tier23BadgeBackgroundBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="DangerSoftBannerBackgroundBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="DangerSoftBannerBorderBrush" Color="#FECACA" />
    <SolidColorBrush x:Key="WarningSoftBannerBackgroundBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="WarningSoftBannerBorderBrush" Color="#FDE68A" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#D4D4D8" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A1A1AA" />

    <!-- Branching Save Tree Lane Palette (0..7) & Semantic Diff/Tag Brushes -->
    <SolidColorBrush x:Key="SaveBranchLane0Brush" Color="#1677FF" />
    <SolidColorBrush x:Key="SaveBranchLane1Brush" Color="#10B981" />
    <SolidColorBrush x:Key="SaveBranchLane2Brush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="SaveBranchLane3Brush" Color="#F59E0B" />
    <SolidColorBrush x:Key="SaveBranchLane4Brush" Color="#EC4899" />
    <SolidColorBrush x:Key="SaveBranchLane5Brush" Color="#06B6D4" />
    <SolidColorBrush x:Key="SaveBranchLane6Brush" Color="#EF4444" />
    <SolidColorBrush x:Key="SaveBranchLane7Brush" Color="#6366F1" />

    <SolidColorBrush x:Key="SaveBranchLane0SoftBrush" Color="#E6F0FF" />
    <SolidColorBrush x:Key="SaveBranchLane1SoftBrush" Color="#E6F8F1" />
    <SolidColorBrush x:Key="SaveBranchLane2SoftBrush" Color="#F3E8FF" />
    <SolidColorBrush x:Key="SaveBranchLane3SoftBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="SaveBranchLane4SoftBrush" Color="#FCE7F3" />
    <SolidColorBrush x:Key="SaveBranchLane5SoftBrush" Color="#CFFAFE" />
    <SolidColorBrush x:Key="SaveBranchLane6SoftBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="SaveBranchLane7SoftBrush" Color="#E0E7FF" />

    <SolidColorBrush x:Key="SaveHeadRingBrush" Color="#10B981" />
    <SolidColorBrush x:Key="SavePinStarBrush" Color="#D97706" />

    <SolidColorBrush x:Key="SaveTagSaveBgBrush" Color="#E6F0FF" />
    <SolidColorBrush x:Key="SaveTagSaveFgBrush" Color="#1677FF" />
    <SolidColorBrush x:Key="SaveTagConfigBgBrush" Color="#F2F3F5" />
    <SolidColorBrush x:Key="SaveTagConfigFgBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="SaveTagRegistryBgBrush" Color="#F3E8FF" />
    <SolidColorBrush x:Key="SaveTagRegistryFgBrush" Color="#7C3AED" />

    <SolidColorBrush x:Key="DiffAddedBrush" Color="#10B981" />
    <SolidColorBrush x:Key="DiffAddedSoftBrush" Color="#E6F8F1" />
    <SolidColorBrush x:Key="DiffModifiedBrush" Color="#D97706" />
    <SolidColorBrush x:Key="DiffModifiedSoftBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="DiffRemovedBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DiffRemovedSoftBrush" Color="#FEE2E2" />
</ResourceDictionary>
