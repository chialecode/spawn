                                <TextBlock Text="没有匹配的游戏条目"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="18,14,16,0"
                                           Visibility="{Binding HasFilteredTrainerSidebarGames, Converter={StaticResource InvBoolToVis}}" />
                            </StackPanel>
                        </ScrollViewer>
