                                    <Path Data="M7,4 H17 V8.5 C17,11.6 14.8,14 12,14.8 C9.2,14 7,11.6 7,8.5 Z M12,14.8 V18 M8.5,18 H15.5 M7,5.5 H4.5 V7.5 C4.5,9.4 5.6,10.5 7,10.5 M17,5.5 H19.5 V7.5 C19.5,9.4 18.4,10.5 17,10.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="成就与 Steam API" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                         GroupName="SettingsCategoryGroup"
                                         IsChecked="{Binding Settings.SelectedCategory, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:SettingsCategory.OverlayAndSound}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4,6 H20 V18 H4 Z M13,14 H18 V16.5 H13 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="弹窗外观与音效" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                         GroupName="SettingsCategoryGroup"
                                         IsChecked="{Binding Settings.SelectedCategory, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:SettingsCategory.SavesAndCloudSync}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M6,5 V19 M18,7 V10 C18,13 15,14 12,14 H6 M4,5 A2,2 0 1,0 8,5 A2,2 0 1,0 4,5 M16,5 A2,2 0 1,0 20,5 A2,2 0 1,0 16,5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="存档与云同步" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                         GroupName="SettingsCategoryGroup"
                                         IsChecked="{Binding Settings.SelectedCategory, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:SettingsCategory.TrainerAndSandbox}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,2 L19,5 V11 C19,16.2 15.9,20.7 12,22 C8.1,20.7 5,16.2 5,11 V5 Z M9.5,12 L11.2,13.8 L15,10"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="修改器与安全沙箱" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                         GroupName="SettingsCategoryGroup"
                                         IsChecked="{Binding Settings.SelectedCategory, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:SettingsCategory.AppearanceTheme}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,3 A9,9 0 1,0 21,12 A6.8,6.8 0 0,1 12,3 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="外观主题" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                         GroupName="SettingsCategoryGroup"
                                         IsChecked="{Binding Settings.SelectedCategory, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:SettingsCategory.Updates}}">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Path Data="M20,12 A8,8 0 1,1 17.6,6.3 M20,4 V9 H15"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Stretch="Uniform"
                                              Width="15"
                                              Height="15"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="更新" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Ellipse Width="7"
                                             Height="7"
                                             Fill="{DynamicResource RunningGreenBrush}"
                                             DockPanel.Dock="Right"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding Settings.Update.HasReadyUpdate, Converter={StaticResource BoolToVis}}" />
                                </DockPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                         GroupName="SettingsCategoryGroup"
                                         IsChecked="{Binding Settings.SelectedCategory, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:SettingsCategory.AboutAndVersion}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,2 A10,10 0 1,0 22,12 A10,10 0 0,0 12,2 Z M8.5,12.2 L10.8,14.5 L15.8,9.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="关于与版本" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ================================================================== -->
            <!-- COLUMN 3: Right Main Panel (#FFFFFF Pure White / #14161A Dark)     -->
            <!-- ================================================================== -->
            <Grid Grid.Column="2" Background="{DynamicResource PageBackgroundBrush}">
                <Grid.RowDefinitions>
                    <!-- Fixed Top Bar (52px, does NOT scroll) -->
                    <RowDefinition Height="52" />
                    <!-- Optional non-intrusive status strip -->
                    <RowDefinition Height="Auto" />
                    <!-- Independent Viewport -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1. Fixed Non-Scrolling Clean Top Bar (Title + Window Caption Buttons + 2px Global Busy Bar) -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Background="Transparent"
                        MouseLeftButtonDown="OnTitleBarDragMouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <!-- Safe reserve width for Minimize / Maximize / Close -->
                            <ColumnDefinition Width="148" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Narrow sidebar toggle + Page/Game Title (18px SemiBold) -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="24,0,16,0">
                            <Button Style="{StaticResource SubtleIconButtonStyle}"
                                    Margin="0,0,8,0"
                                    ToolTip="展开或收起侧栏"
                                    Command="{Binding ToggleNarrowSidebarCommand}"
                                    Visibility="{Binding IsNarrowWindow, Converter={StaticResource BoolToVis}}">
                                <Path Data="M3,6 H21 M3,12 H21 M3,18 H21"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      Stretch="Uniform"
                                      Width="16"
                                      Height="16" />
                            </Button>

                            <TextBlock Text="{Binding TopBarTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Top-Right Custom Window Caption Buttons (Minimize / Maximize / Close) -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                    ToolTip="最小化"
                                    AutomationProperties.Name="最小化"
                                    Click="OnMinimizeButtonClick">
                                <Path Data="M0,0 H10"
                                      Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.15" />
                            </Button>

                            <Button x:Name="MaximizeRestoreButton"
                                    Style="{StaticResource WindowCaptionButtonStyle}"
                                    ToolTip="最大化 / 还原"
                                    AutomationProperties.Name="最大化"
                                    Click="OnMaximizeRestoreButtonClick">
                                <Path x:Name="MaximizeGlyphPath"
                                      Data="M0,0 H9.5 V9.5 H0 Z"
                                      Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.1" />
                            </Button>

                            <Button Style="{StaticResource WindowCloseButtonStyle}"
                                    ToolTip="关闭"
                                    AutomationProperties.Name="关闭"
                                    Click="OnCloseButtonClick" />
                        </StackPanel>

                        <!-- 2px Slim Global Indeterminate Progress Bar Along Top Bar Bottom Edge -->
                        <ProgressBar Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     VerticalAlignment="Bottom"
                                     Style="{StaticResource SlimIndeterminateProgressBarStyle}"
                                     IsHitTestVisible="False"
                                     Visibility="{Binding IsAnyBusyWorking, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <!-- 2. Global Anti-Cheat Guard Countdown Strip + Non-Intrusive Feedback Strip -->
                <StackPanel Grid.Row="1">
                    <Border Background="{DynamicResource DangerSoftBannerBackgroundBrush}"
                            BorderBrush="{DynamicResource DangerSoftBannerBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="24,7"
                            Visibility="{Binding Trainer.IsGuardLocked, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{DynamicResource Tier23BadgeForegroundBrush}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Trainer.GuardLockBannerText}"
                                       FontFamily="{StaticResource SpawnMonoFont}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Tier23BadgeForegroundBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="UpdateReadyBanner"
                            Background="{DynamicResource InfoBannerBackgroundBrush}"
                            BorderBrush="{DynamicResource InfoBannerBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="24,8"
                            Visibility="{Binding Settings.Update.ShowReadyBanner, Converter={StaticResource BoolToVis}}">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{DynamicResource RunningGreenBrush}"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Settings.Update.ReadyBannerText}"
                                           FontSize="12.8"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="28"
                                        Padding="12,0"
                                        FontSize="12"
                                        Content="更新设置"
                                        Margin="0,0,8,0"
                                        Click="OnOpenUpdateSettingsFromBannerClick" />
                                <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                        Height="28"
                                        Padding="14,0"
                                        FontSize="12"
                                        Content="立即重启更新"
                                        Margin="0,0,6,0"
                                        Command="{Binding Settings.Update.RestartAndUpdateCommand}" />
                                <Button Style="{StaticResource SubtleIconButtonStyle}"
                                        Width="24"
                                        Height="24"
                                        ToolTip="稍后提醒"
                                        Command="{Binding Settings.Update.DismissReadyBannerCommand}">
                                    <Path Data="M0,0 L8,8 M8,0 L0,8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.3"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Global Feedback Strip (Info Auto-Dismisses; Error Persists + Danger Tone + Copy) -->
                    <Border BorderThickness="0,0,0,1"
                            Padding="24,7"
                            Visibility="{Binding StatusBannerMessage, Converter={StaticResource StrNotEmptyToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource InfoBannerBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource InfoBannerBorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusBannerError}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBannerBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerSoftBannerBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Width="14"
                                  Height="14"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M12,2 A10,10 0 1,0 22,12 A10,10 0 0,0 12,2 Z M12,11 V16 M12,8 V8.4" />
                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatusBannerError}" Value="True">
                                                <Setter Property="Data" Value="M12,3 L21,19 H3 Z M12,9 V13.5 M12,16.2 V16.6" />
                                                <Setter Property="Stroke" Value="{DynamicResource Tier23BadgeForegroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding StatusBannerMessage}"
                                       FontSize="12.8"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatusBannerError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Tier23BadgeForegroundBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SubtleIconButtonStyle}"
                                        Width="Auto"
                                        Height="24"
                                        Padding="8,0"
                                        Margin="0,0,4,0"
                                        FontSize="11.5"
                                        Content="复制"
                                        ToolTip="复制提示内容"
                                        Command="{Binding CopyStatusBannerCommand}" />
                                <Button Style="{StaticResource SubtleIconButtonStyle}"
                                        Width="24"
                                        Height="24"
                                        ToolTip="关闭提示"
                                        Command="{Binding DismissStatusBannerCommand}">
                                    <Path Data="M0,0 L8,8 M8,0 L0,8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.3"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ============================================================== -->
                <!-- 3A. Library Empty / Unselected State                           -->
                <!-- ============================================================== -->
                <Grid Grid.Row="2"
                      Visibility="{Binding ShowLibraryEmptyState, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="520">
                        <TextBlock Text="在左侧选择一个游戏，或在「设置 → 常规与游戏库」配置扫描目录或导入游戏"
                                   FontSize="14.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="也可直接将单机游戏文件夹拖入窗口快速导入"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0" />

                        <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                Content="前往设置配置游戏库"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0"
                                Command="{Binding OpenLibrarySettingsCommand}" />

                        <!-- Gentle One-Click Prompt when .local\games has unimported titles -->
                        <Border CornerRadius="14"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                Padding="16,12"
                                Margin="0,22,0,0"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasUnimportedLocalGamesHint, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UnimportedLocalGamesHintText}"
                                           FontSize="13"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0" />
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="30"
                                        Padding="14,0"
                                        Content="一键扫描导入"
                                        Command="{Binding ScanDefaultLibraryCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============================================================== -->
                <!-- 3B. Selected Game Detail + [成就 | 存档 | 游戏数据 | 修改器]    -->
                <!-- ============================================================== -->
                <Grid Grid.Row="2"
                      Margin="28,18,28,0"
                      MaxWidth="1160"
                      Visibility="{Binding ShowLibraryGameWorkbench, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <!-- Game Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Sub-Tab Bar: 成就 (已解锁/总数) | 游戏数据 -->
                        <RowDefinition Height="Auto" />
                        <!-- Active Sub-Tab Viewport (* height preserves VirtualizingStackPanel!) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Restrained Clean Game Header -->
                    <Grid Grid.Row="0" DataContext="{Binding SelectedGame}" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left High-Res Cover / Icon -->
                        <Border Grid.Column="0"
                                Width="88"
                                Height="116"
                                CornerRadius="10"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="{Binding InitialsText}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding CoverImage, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                                <Image Source="{Binding CoverImage}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding CoverImage, Converter={StaticResource NullToVis}}" />
                            </Grid>
                        </Border>

                        <!-- Middle Metadata, Channel Status Dot & Tabular 3-State Playtime -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text=" · "
                                           FontSize="13"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PlatformFullLabel}"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <Border CornerRadius="5"
                                        Padding="7,2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Tier0BadgeBackgroundBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AntiCheatTier}" Value="{x:Static contracts:AntiCheatTier.Tier1}">
                                                    <Setter Property="Background" Value="{DynamicResource Tier1BadgeBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AntiCheatTier}" Value="{x:Static contracts:AntiCheatTier.Tier2}">
                                                    <Setter Property="Background" Value="{DynamicResource Tier23BadgeBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AntiCheatTier}" Value="{x:Static contracts:AntiCheatTier.Tier3}">
                                                    <Setter Property="Background" Value="{DynamicResource Tier23BadgeBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding AntiCheatBadgeText}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Tier0BadgeForegroundBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AntiCheatTier}" Value="{x:Static contracts:AntiCheatTier.Tier1}">
                                                        <Setter Property="Foreground" Value="{DynamicResource Tier1BadgeForegroundBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AntiCheatTier}" Value="{x:Static contracts:AntiCheatTier.Tier2}">
                                                        <Setter Property="Foreground" Value="{DynamicResource Tier23BadgeForegroundBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AntiCheatTier}" Value="{x:Static contracts:AntiCheatTier.Tier3}">
                                                        <Setter Property="Foreground" Value="{DynamicResource Tier23BadgeForegroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <Border CornerRadius="5"
                                        Background="{DynamicResource Tier0BadgeBackgroundBrush}"
                                        Padding="7,2"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasVerifiedOfflineBypassBadge, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding VerifiedOfflineBypassBadgeText}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Tier0BadgeForegroundBrush}" />
                                </Border>

                                <Border CornerRadius="5"
                                        Background="{DynamicResource SelectedPillBrush}"
                                        BorderBrush="{DynamicResource InfoBannerBorderBrush}"
                                        BorderThickness="1"
                                        Padding="7,2"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip="{Binding LaunchModeBadgeToolTip}"
                                        Visibility="{Binding IsSteamLaunchConfigured, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding LaunchModeBadgeText}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </WrapPanel>

                            <!-- Achievement Capture Channel Status Dot -->
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0" VerticalAlignment="Center">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource RunningGreenBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChannelPendingPatch}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningAmberBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding EffectiveChannelStatusText}"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Tabular 3-State Playtime -->
                            <TextBlock Text="{Binding PlaytimeSummaryText}"
                                       FontFamily="{StaticResource SpawnMonoFont}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,7,0,0" />

                            <TextBlock Text="{Binding LastPlayedSummaryText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Right Action Area: SINGLE Primary Button (State Machine) + Simplified Floating ⋯ Popup Menu -->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <Button Style="{StaticResource GameLaunchPrimaryButtonStyle}"
                                    Tag="{Binding DataContext.PrimaryLaunchButtonTag, RelativeSource={RelativeSource AncestorType=Window}}"
                                    IsEnabled="{Binding DataContext.IsPrimaryLaunchButtonEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{Binding DataContext.PrimaryLaunchButtonToolTip, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Command="{Binding DataContext.PrimaryLaunchOrStopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Height="38"
                                    Padding="22,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M1,1 L10,6.5 L1,12 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="9"
                                          Height="11"
                                          Stretch="Uniform"
                                          Margin="0,0,7,0"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding DataContext.ShowPrimaryLaunchPlayGlyph, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding DataContext.PrimaryLaunchButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Running" />
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="停止游戏" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="WaitingSteam" />
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="取消等待" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- Simplified Floating ⋯ Menu (PlacementTarget.Tag bridges RootWindow.DataContext across PopupRoot!) -->
                            <Grid Margin="10,0,0,0" VerticalAlignment="Center">
                                <ToggleButton x:Name="GameHeaderMoreToggle"
                                              Style="{StaticResource MorePopupToggleStyle}"
                                              Tag="{Binding DataContext, ElementName=RootWindow}"
                                              Width="38"
                                              Height="38"
                                              ToolTip="更多操作"
                                              AutomationProperties.Name="更多游戏操作" />
                                <Popup IsOpen="{Binding IsChecked, ElementName=GameHeaderMoreToggle, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=GameHeaderMoreToggle}"
                                       DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                       Placement="Bottom"
                                       HorizontalOffset="-220"
                                       VerticalOffset="6"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       Opened="OnManagedPopupOpened"
                                       Closed="OnManagedPopupClosed">
                                    <Border Width="256"
                                            Margin="10"
                                            Padding="6"
                                            CornerRadius="12"
                                            Background="{DynamicResource FloatingMenuBackgroundBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" Color="#000000" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                    Content="{Binding AlternateLaunchMenuItemText}"
                                                    IsEnabled="{Binding CanExecuteAlternateLaunchForSelected}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    ToolTip="{Binding AlternateLaunchMenuItemToolTip}"
                                                    Click="OnAnyPopupMenuItemClick"
                                                    Command="{Binding LaunchSelectedGameAlternateModeCommand}" />
                                            <Border Height="1"
                                                    Background="{DynamicResource DividerBrush}"
                                                    Margin="6,5" />
                                            <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                    Content="游戏属性与启动设置…"
                                                    Click="OnAnyPopupMenuItemClick"
                                                    Command="{Binding EditGamePropertiesCommand}" />
                                            <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                    Content="打开游戏所在文件夹"
                                                    Click="OnAnyPopupMenuItemClick"
                                                    Command="{Binding OpenSelectedGameFolderCommand}" />
                                            <Border Height="1"
                                                    Background="{DynamicResource DividerBrush}"
                                                    Margin="6,5" />
                                            <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                    Content="存档时间机器（分支存档）"
                                                    Click="OnAnyPopupMenuItemClick"
                                                    Command="{Binding OpenGameSavesSubTabCommand}" />
                                            <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                    Content="管理 / 清理游戏数据"
                                                    Click="OnAnyPopupMenuItemClick"
                                                    Command="{Binding OpenGameDataSubTabCommand}" />
                                            <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                    Content="打开修改器"
                                                    Click="OnAnyPopupMenuItemClick"
                                                    Command="{Binding OpenGameTrainersSubTabCommand}" />
                                            <Border Height="1"
                                                    Background="{DynamicResource DividerBrush}"
                                                    Margin="6,5" />
                                            <Button Style="{StaticResource DangerMenuItemButtonStyle}"
                                                    Content="从游戏库移除…"
                                                    Click="OnAnyPopupMenuItemClick"
                                                    Command="{Binding RemoveSelectedGameFromLibraryCommand}" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Quad Sub-Tab Strip: [成就 (已解锁/总数)] | [存档] | [游戏数据] | [修改器] -->
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                         GroupName="GameDetailPrimarySubTabs"
                                         FontSize="14"
                                         Padding="4,9"
                                         Margin="0,0,24,0"
                                         Content="{Binding AchievementsSubTabHeaderText}"
                                         IsChecked="{Binding SelectedGameSubTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:GameDetailSubTab.Achievements}}" />
                            <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                         GroupName="GameDetailPrimarySubTabs"
                                         FontSize="14"
                                         Padding="4,9"
                                         Margin="0,0,24,0"
                                         Content="存档"
                                         IsChecked="{Binding SelectedGameSubTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:GameDetailSubTab.Saves}}" />
                            <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                         GroupName="GameDetailPrimarySubTabs"
                                         FontSize="14"
                                         Padding="4,9"
                                         Margin="0,0,24,0"
                                         Content="游戏数据"
                                         IsChecked="{Binding SelectedGameSubTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:GameDetailSubTab.GameData}}" />
                            <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                         GroupName="GameDetailPrimarySubTabs"
                                         FontSize="14"
                                         Padding="4,9"
                                         Content="修改器"
                                         IsChecked="{Binding SelectedGameSubTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:GameDetailSubTab.Trainers}}" />
                        </StackPanel>
                    </Border>

                    <!-- Row 2A: Sub-Tab "成就 (已解锁/总数)" (Virtualized Recycling List!) -->
                    <ContentControl Grid.Row="2"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource AchievementManagementListTemplate}"
                                    Visibility="{Binding ShowGameAchievementsSubPanel, Converter={StaticResource BoolToVis}}" />

                    <!-- Row 2A2: Sub-Tab "存档" (Branching Save Tree & Cloud Sync Workbench) -->
                    <savesViews:SaveWorkbenchControl Grid.Row="2"
                                                     DataContext="{Binding Saves}"
                                                     Visibility="{Binding DataContext.ShowGameSavesSubPanel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                    <!-- Row 2B: Sub-Tab "游戏数据" (PCGamingWiki + Engine + Reversible Cleanup) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding ShowGameDataSubPanel, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Responsive Game Data Action Toolbar (Single Primary Button + Undo Restore + Safe-Default Reset Checkbox) -->
                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Height="32"
                                                Padding="13,0"
                                                Margin="0,2,8,2"
                                                Content="刷新 / 同步 PCGamingWiki"
                                                Command="{Binding RefreshGameDataOnlineCommand}"
                                                IsEnabled="{Binding IsInspectingGameData, Converter={StaticResource EqToBool}, ConverterParameter=False}" />
                                        <Button Style="{StaticResource SubtleIconButtonStyle}"
                                                Width="Auto"
                                                Height="28"
                                                Margin="0,2,2,2"
                                                Padding="8,0"
                                                Content="全选"
                                                Command="{Binding SelectAllSafeGameDataCommand}" />
                                        <Button Style="{StaticResource SubtleIconButtonStyle}"
                                                Width="Auto"
                                                Height="28"
                                                Margin="0,2,12,2"
                                                Padding="8,0"
                                                Content="取消全选"
                                                Command="{Binding ClearGameDataSelectionCommand}" />
                                        <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                                  Content="同时重置 SPAWN 成就进度与游玩时长"
                                                  IsChecked="{Binding ResetSpawnStateOnClean, Mode=TwoWay}"
                                                  Margin="0,2,0,2"
                                                  VerticalAlignment="Center" />
                                    </WrapPanel>

                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Height="34"
                                                Margin="0,2,8,2"
                                                Content="恢复上次清理"
                                                ToolTip="{Binding UndoSnapshotToolTipText}"
                                                Command="{Binding RestoreLastCleanupCommand}"
                                                IsEnabled="{Binding IsBusyWorking, Converter={StaticResource EqToBool}, ConverterParameter=False}"
                                                Visibility="{Binding HasUndoSnapshot, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                                Height="34"
                                                Margin="0,2,0,2"
                                                Content="{Binding CleanSelectedButtonText}"
                                                Command="{Binding CleanSelectedGameDataCommand}"
                                                IsEnabled="{Binding IsBusyWorking, Converter={StaticResource EqToBool}, ConverterParameter=False}" />
                                    </WrapPanel>
                                </Grid>

                                <StackPanel Margin="0,8,0,0"
                                            Visibility="{Binding IsInspectingGameData, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar Style="{StaticResource SlimIndeterminateProgressBarStyle}" />
                                    <TextBlock Text="正在探测该游戏的存档、模拟器成就文件与注册表路径…"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Categorized Game Data Paths & Registry Keys -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,8,4,28">
                                <ItemsControl ItemsSource="{Binding GameDataGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GameDataCategoryGroupViewModel}">
                                            <StackPanel Margin="0,12,0,4">
                                                <!-- Category Section Header -->
                                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding CategoryTitle}"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               DockPanel.Dock="Left" />
                                                    <TextBlock Text="{Binding SummaryCountText}"
                                                               FontFamily="{StaticResource SpawnMonoFont}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               DockPanel.Dock="Right" />
                                                </DockPanel>

                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:GameDataItemViewModel}">
                                                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                                                    BorderThickness="0,0,0,1"
                                                                    Padding="2,10">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="26" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <CheckBox Grid.Column="0"
                                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                              IsEnabled="{Binding IsSafeToClean}"
                                                                              VerticalAlignment="Center" />

                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,12,0">
                                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Border CornerRadius="4"
                                                                                    Background="{DynamicResource SubtleSurfaceBrush}"
                                                                                    BorderBrush="{DynamicResource DividerBrush}"
                                                                                    BorderThickness="1"
                                                                                    Padding="6,1"
                                                                                    Margin="0,0,8,0"
                                                                                    VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding SourceBadgeText}"
                                                                                           FontSize="11"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                            </Border>
                                                                            <TextBlock Text="{Binding PathOrRegistryKey}"
                                                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                                                       FontSize="12.5"
                                                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                                                       TextWrapping="Wrap"
                                                                                       VerticalAlignment="Center" />
                                                                        </WrapPanel>
                                                                        <TextBlock Text="{Binding Description}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                   Margin="0,3,0,0"
                                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                                                        <TextBlock Text="{Binding SafetyNote}"
                                                                                   FontSize="11.5"
                                                                                   Foreground="{DynamicResource WarningAmberBrush}"
                                                                                   Margin="0,2,0,0"
                                                                                   Visibility="{Binding HasSafetyNote, Converter={StaticResource BoolToVis}}" />
                                                                    </StackPanel>

                                                                    <!-- Existence Dot + File Count / Byte Size -->
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Ellipse Width="7"
                                                                                 Height="7"
                                                                                 Margin="0,0,6,0"
                                                                                 VerticalAlignment="Center">
                                                                            <Ellipse.Style>
                                                                                <Style TargetType="Ellipse">
                                                                                    <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Exists}" Value="True">
                                                                                            <Setter Property="Fill" Value="{DynamicResource RunningGreenBrush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Ellipse.Style>
                                                                        </Ellipse>
                                                                        <TextBlock Text="{Binding StatusSummaryText}"
                                                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>

                                                                    <!-- Row Quick Actions: Open Folder / Copy Path -->
                                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                                                Height="26"
                                                                                Padding="10,0"
                                                                                FontSize="11.5"
                                                                                Margin="0,0,6,0"
                                                                                Content="打开目录"
                                                                                Command="{Binding OpenLocationCommand}"
                                                                                Visibility="{Binding CanOpenDirectory, Converter={StaticResource BoolToVis}}" />
                                                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                                                Height="26"
                                                                                Padding="10,0"
                                                                                FontSize="11.5"
                                                                                Content="复制路径"
                                                                                Command="{Binding CopyPathCommand}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel HorizontalAlignment="Center"
                                            Margin="0,36,0,0"
                                            MaxWidth="440"
                                            Visibility="{Binding ShowGameDataEmptyState, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="暂未探测到该游戏的存档、配置或注册表路径"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextAlignment="Center" />
                                    <TextBlock Text="可点击上方「刷新 / 同步 PCGamingWiki」在线获取路径规则，或在启动游戏生成本地存档后再来查看。"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Row 2C: Sub-Tab "修改器" (Shared Trainer Workbench Template, synced with Trainers rail view) -->
                    <ContentControl Grid.Row="2"
                                    Content="{Binding Trainer}"
                                    ContentTemplate="{StaticResource TrainerWorkbenchTemplate}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Visibility="{Binding ShowGameTrainersSubPanel, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- ============================================================== -->
                <!-- 3C. Achievements Center: Overview & Recent Unlocks Timeline    -->
                <!-- ============================================================== -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding ShowAchievementsOverviewPanel, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="32,24,32,32" MaxWidth="920">
                        <Border BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,0,0,20">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <StackPanel Margin="0,0,36,0">
                                        <TextBlock Text="已解锁总成就" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding GlobalTotalUnlockedCount}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="24"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text=" / " FontSize="15" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Bottom" Margin="2,0,2,3" />
                                            <TextBlock Text="{Binding GlobalTotalAchievementCount}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="15"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,0,3" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,36,0">
                                        <TextBlock Text="100% 全成就游戏" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding GlobalPlatinumGamesCount}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="稀有成就 (&lt;10%)" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding GlobalRareUnlockedCount}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource RareBadgeForegroundBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <WrapPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                            Margin="0,2,8,2"
                                            Content="弹窗外观设置"
                                            Command="{Binding OpenOverlaySettingsCommand}" />
                                    <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                            Margin="0,2,0,2"
                                            Content="预览当前跳杯弹窗"
                                            Command="{Binding Settings.TriggerTestToastCommand}" />
                                </WrapPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="最近解锁时间线"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,22,0,8" />

                        <ItemsControl ItemsSource="{Binding RecentUnlocks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RecentUnlockItemViewModel}">
                                    <Button Cursor="Hand"
                                            Padding="0"
                                            FocusVisualStyle="{x:Null}"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.OpenRecentUnlockGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding GameId}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="RowBd"
                                                        CornerRadius="8"
                                                        Background="Transparent"
                                                        BorderBrush="{DynamicResource DividerBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="6,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="52" />
                                                            <ColumnDefinition Width="14" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Width="52"
                                                                Height="52"
                                                                CornerRadius="8"
                                                                Background="{DynamicResource SubtleSurfaceBrush}"
                                                                ClipToBounds="True">
                                                            <Image Source="{Binding IconImage}"
                                                                   Stretch="UniformToFill"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                                <TextBlock Text=" · " FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding GameTitle}" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                                <Border CornerRadius="4"
                                                                        Background="{DynamicResource RareBadgeBackgroundBrush}"
                                                                        Padding="6,1"
                                                                        Margin="8,0,0,0"
                                                                        Visibility="{Binding IsRare, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{Binding RareBadgeText}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource RareBadgeForegroundBrush}" />
                                                                </Border>
                                                            </WrapPanel>
                                                            <TextBlock Text="{Binding Description}"
                                                                       FontSize="12.5"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       Margin="0,3,0,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding UnlockedTimeText}"
                                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="尚无最近解锁记录。启动单机游戏达成成就后，实时跳杯记录会显示在这里。"
                                   FontSize="13.5"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,18,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentUnlocks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================================================== -->
                <!-- 3D. Achievements Center: Single Game Selected (Virtualized!)   -->
                <!-- ============================================================== -->
                <Grid Grid.Row="2"
                      Margin="32,16,32,0"
                      MaxWidth="980"
                      Visibility="{Binding ShowAchievementsSingleGamePanel, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedAchievementsGame.EffectiveChannelStatusText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                    Height="30"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,2,8,2"
                                    Content="返回总览"
                                    Command="{Binding SelectAchievementsOverviewCommand}" />
                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                    Height="30"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,2,0,2"
                                    Content="在游戏库中管理与启动"
                                    Command="{Binding JumpToGameInLibraryCommand}"
                                    CommandParameter="{Binding SelectedAchievementsGame.GameId}" />
                        </WrapPanel>
                    </Grid>
                    <ContentControl Grid.Row="1"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource AchievementManagementListTemplate}" />
                </Grid>

                <!-- ============================================================== -->
                <!-- 3D2. Saves Center: Global Saves Vault & Sync Overview          -->
                <!-- ============================================================== -->
                <savesViews:SavesOverviewControl Grid.Row="2"
                                                 Margin="28,18,28,0"
                                                 MaxWidth="1120"
                                                 Visibility="{Binding ShowSavesOverviewPanel, Converter={StaticResource BoolToVis}}" />

                <!-- ============================================================== -->
                <!-- 3D3. Saves Center: Per-Game Branching Save Tree Workbench      -->
                <!-- ============================================================== -->
                <Grid Grid.Row="2"
                      Margin="28,16,28,0"
                      MaxWidth="1160"
                      Visibility="{Binding ShowSavesSingleGamePanel, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Compact Game Context Header -->
                    <Border Grid.Row="0"
                            DataContext="{Binding SelectedSaveGame}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="42"
                                    Height="42"
                                    CornerRadius="8"
                                    Background="{DynamicResource SubtleSurfaceBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="{Binding InitialsText}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding SmallIcon, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                                    <Image Source="{Binding SmallIcon}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding SmallIcon, Converter={StaticResource NullToVis}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text=" · "
                                               FontSize="12.5"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PlatformFullLabel}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center" />
                                </WrapPanel>
                                <TextBlock Text="{Binding PlaytimeSummaryText}"
                                           FontFamily="{StaticResource SpawnMonoFont}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <WrapPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="30"
                                        Padding="12,0"
                                        FontSize="12"
                                        Margin="0,2,8,2"
                                        Content="返回总览"
                                        Command="{Binding DataContext.SelectSavesOverviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="30"
                                        Padding="12,0"
                                        FontSize="12"
                                        Margin="0,2,0,2"
                                        Content="在游戏库中查看"
                                        Command="{Binding DataContext.JumpToGameInLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding GameId}" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Reused Full Branching Save Tree Workbench -->
                    <savesViews:SaveWorkbenchControl Grid.Row="1"
                                                     DataContext="{Binding Saves}" />
                </Grid>

                <!-- ============================================================== -->
                <!-- 3E. Trainers Center: Global Managed Trainers Overview          -->
                <!-- ============================================================== -->
                <Grid Grid.Row="2"
                      Margin="32,20,32,0"
                      MaxWidth="1000"
                      Visibility="{Binding ShowTrainersOverviewPanel, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Flat Summary Strip + Sandbox Path Bar -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,16">
                        <StackPanel>
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,36,6">
                                    <TextBlock Text="已安装修改器" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding TotalManagedTrainersCount}"
                                               FontFamily="{StaticResource SpawnMonoFont}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Margin="0,0,36,6">
                                    <TextBlock Text="已绑定单机游戏" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding BoundTrainerGamesCount}"
                                               FontFamily="{StaticResource SpawnMonoFont}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Margin="0,0,24,6">
                                    <TextBlock Text="运行状态" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0" VerticalAlignment="Center">
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAnyRunningTrainer}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource RunningGreenBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsGuardCooldownOrProtected}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource Tier23BadgeForegroundBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding TrainerOverviewRuntimeStatusText}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAnyRunningTrainer}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource RunningGreenBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsGuardCooldownOrProtected}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Tier23BadgeForegroundBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </WrapPanel>

                            <!-- Sandbox Directory Path Strip -->
                            <Border CornerRadius="8"
                                    Background="{DynamicResource SubtleSurfaceBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    Padding="12,9"
                                    Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="修改器隔离沙箱目录（唯一建议配置 Defender 排除的目录）"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Settings.EffectiveTrainerSandboxRoot}"
                                                   ToolTip="{Binding Settings.EffectiveTrainerSandboxRoot}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Height="28"
                                                Padding="12,0"
                                                FontSize="12"
                                                Margin="0,2,8,2"
                                                Content="打开沙箱目录"
                                                Command="{Binding OpenTrainerSandboxRootFolderCommand}" />
                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Height="28"
                                                Padding="12,0"
                                                FontSize="12"
                                                Margin="0,2,0,2"
                                                Content="Defender 排除与沙箱设置"
                                                Command="{Binding OpenTrainerSandboxSettingsCommand}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <!-- Concise Provenance & External Website Boundary Note -->
                            <TextBlock Text="{Binding Settings.TrainerOverviewProvenanceSummary}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Row 1: Active Running Trainer Banner (visible ONLY when a trainer session is running) -->
                    <Border Grid.Row="1"
                            CornerRadius="10"
                            Background="{DynamicResource RunningGreenSoftBrush}"
                            BorderBrush="{DynamicResource RunningGreenBrush}"
                            BorderThickness="1"
                            Padding="16,12"
                            Margin="0,14,0,0"
                            Visibility="{Binding HasAnyRunningTrainer, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{DynamicResource RunningGreenBrush}"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="正在隔离沙箱中运行"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource RunningGreenBrush}"
                                               VerticalAlignment="Center" />
                                    <Border CornerRadius="4"
                                            Background="{DynamicResource PageBackgroundBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1"
                                            Padding="6,1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActiveRunningTrainerElevationText}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </Border>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding ActiveRunningTrainerGameTitle}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text=" · "
                                               FontSize="14"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding ActiveRunningTrainerDisplayName}"
                                               FontSize="14"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </WrapPanel>
                            </StackPanel>

                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="32"
                                        Padding="12,0"
                                        FontSize="12.5"
                                        Margin="0,2,8,2"
                                        Content="进入工作台"
                                        Command="{Binding OpenActiveRunningTrainerWorkbenchCommand}" />
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="32"
                                        Padding="12,0"
                                        FontSize="12.5"
                                        Margin="0,2,8,2"
                                        Content="{Binding Trainer.OriginalWindowToggleButtonText}"
                                        Command="{Binding ToggleActiveRunningTrainerWindowCommand}" />
                                <Button Style="{StaticResource RunningPrimaryCapsuleButtonStyle}"
                                        Height="32"
                                        Padding="16,0"
                                        FontSize="12.5"
                                        Margin="0,2,0,2"
                                        Content="停止修改器"
                                        Command="{Binding StopActiveRunningTrainerCommand}" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: All Installed Trainers List Header -->
                    <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,18,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="全部已安装修改器"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ManagedTrainersCountBadgeText}"
                                       FontFamily="{StaticResource SpawnMonoFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="在左侧点击任意游戏可进入完整工作台管理热键与存档快照"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Right" />
                    </DockPanel>

                    <!-- Row 3 (*): Virtualized Recycling Managed Trainers ListBox + Empty State -->
                    <Grid Grid.Row="3">
                        <ListBox ItemsSource="{Binding ManagedTrainers}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0,0,4,24"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="1,1"
                                 VirtualizingPanel.CacheLengthUnit="Page"
                                 Visibility="{Binding HasManagedTrainers, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel IsVirtualizing="True"
                                                            VirtualizationMode="Recycling" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="Stretch" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ManagedTrainerItemViewModel}">
                                    <Border BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Game Icon + Active Running Ring -->
                                            <Grid Grid.Column="0" Width="42" Height="42" VerticalAlignment="Center">
                                                <Border CornerRadius="8"
                                                        Background="{DynamicResource SubtleSurfaceBrush}"
                                                        BorderBrush="{DynamicResource DividerBrush}"
                                                        BorderThickness="1"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock Text="{Binding GameInitials}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding GameIcon, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                                                        <Image Source="{Binding GameIcon}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding GameIcon, Converter={StaticResource NullToVis}}" />
                                                    </Grid>
                                                </Border>
                                                <Border CornerRadius="9"
                                                        Margin="-2"
                                                        BorderBrush="{DynamicResource RunningGreenBrush}"
                                                        BorderThickness="2"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                            </Grid>

                                            <!-- Game Title, Trainer Display Name/Version, Provider/SHA-256, Last Launched -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GameTitle}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text=" · "
                                                               FontSize="13"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TrainerDisplayName}"
                                                               FontSize="13.5"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <Border CornerRadius="4"
                                                            Background="{DynamicResource SubtleSurfaceBrush}"
                                                            BorderBrush="{DynamicResource DividerBrush}"
                                                            BorderThickness="1"
                                                            Padding="6,1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding VersionLabelText}"
                                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </Border>
                                                    <Border CornerRadius="4"
                                                            Background="{DynamicResource RunningGreenSoftBrush}"
                                                            Padding="6,1"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="运行中"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource RunningGreenBrush}" />
                                                    </Border>
                                                    <Border CornerRadius="4"
                                                            Background="{DynamicResource SubtleSurfaceBrush}"
                                                            BorderBrush="{DynamicResource DividerBrush}"
                                                            BorderThickness="1"
                                                            Padding="6,1"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding HasSafetyHintBadge, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding SafetyHintBadgeText}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </Border>
                                                </WrapPanel>

                                                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                                    <Border CornerRadius="4"
                                                            BorderThickness="1"
                                                            Padding="6,1"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center"
                                                            ToolTip="{Binding SourceDetailedDisclosureText}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExternalWebsiteSource}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource InfoBannerBackgroundBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource InfoBannerBorderBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ProviderLabel}"
                                                                   FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExternalWebsiteSource}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Text="SHA-256: "
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ShortSha256}"
                                                               ToolTip="{Binding FullSha256}"
                                                               FontFamily="{StaticResource SpawnMonoFont}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text=" · "
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding FileMetaShortText}"
                                                               FontFamily="{StaticResource SpawnMonoFont}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text=" · "
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding LastLaunchedText}"
                                                               FontFamily="{StaticResource SpawnMonoFont}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               VerticalAlignment="Center" />
                                                </WrapPanel>

                                                <TextBlock Text="{Binding SourceOriginSummaryText}"
                                                           ToolTip="{Binding SourceDetailedDisclosureText}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>

                                            <!-- Row Primary Launch/Stop Button + Floating ⋯ Menu (PlacementTarget.Tag bridge!) -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Height="30"
                                                        Padding="14,0"
                                                        FontSize="12.5"
                                                        Content="{Binding PrimaryActionText}"
                                                        Command="{Binding PrimaryLaunchOrStopCommand}"
                                                        IsEnabled="{Binding CanExecutePrimaryAction}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryCapsuleButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource RunningGreenBrush}" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Grid Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <ToggleButton x:Name="ManagedTrainerRowMoreBtn"
                                                                  Style="{StaticResource RowMorePopupToggleStyle}"
                                                                  Tag="{Binding}"
                                                                  ToolTip="更多修改器操作"
                                                                  AutomationProperties.Name="更多修改器操作" />
                                                    <Popup IsOpen="{Binding IsChecked, ElementName=ManagedTrainerRowMoreBtn, Mode=TwoWay}"
                                                           PlacementTarget="{Binding ElementName=ManagedTrainerRowMoreBtn}"
                                                           DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                                           Placement="Bottom"
                                                           HorizontalOffset="-184"
                                                           VerticalOffset="4"
                                                           StaysOpen="False"
                                                           AllowsTransparency="True"
                                                           PopupAnimation="Fade"
                                                           Opened="OnManagedPopupOpened"
                                                           Closed="OnManagedPopupClosed">
                                                        <Border Width="218"
                                                                Margin="8"
                                                                Padding="5"
                                                                CornerRadius="10"
                                                                Background="{DynamicResource FloatingMenuBackgroundBrush}"
                                                                BorderBrush="{DynamicResource DividerBrush}"
                                                                BorderThickness="1">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.14" Color="#000000" />
                                                            </Border.Effect>
                                                            <StackPanel>
                                                                <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                                        Content="进入该游戏工作台"
                                                                        Click="OnAnyPopupMenuItemClick"
                                                                        Command="{Binding OpenWorkbenchCommand}" />
                                                                <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                                        Content="打开沙箱目录"
                                                                        Click="OnAnyPopupMenuItemClick"
                                                                        Command="{Binding OpenSandboxFolderCommand}" />
                                                                <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                                        Content="在浏览器打开来源网页"
                                                                        Click="OnAnyPopupMenuItemClick"
                                                                        Command="{Binding OpenSourcePageCommand}"
                                                                        Visibility="{Binding HasValidSourcePageUrl, Converter={StaticResource BoolToVis}}" />
                                                                <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                                        Content="复制来源网页链接"
                                                                        Click="OnAnyPopupMenuItemClick"
                                                                        Command="{Binding CopySourcePageUrlCommand}"
                                                                        Visibility="{Binding HasValidSourcePageUrl, Converter={StaticResource BoolToVis}}" />
                                                                <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                                        Content="校验 SHA-256"
                                                                        Click="OnAnyPopupMenuItemClick"
                                                                        Command="{Binding VerifyIntegrityCommand}" />
                                                                <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                                        Content="在 VirusTotal 查看哈希"
                                                                        Click="OnAnyPopupMenuItemClick"
                                                                        Command="{Binding OpenVirusTotalCommand}" />
                                                                <Border Height="1"
                                                                        Background="{DynamicResource DividerBrush}"
                                                                        Margin="6,5" />
                                                                <Button Style="{StaticResource DangerMenuItemButtonStyle}"
                                                                        Content="移除"
                                                                        Click="OnAnyPopupMenuItemClick"
                                                                        Command="{Binding RemoveCommand}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Helpful Empty State when no trainers are installed yet -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="520"
                                    Margin="0,0,0,28"
                                    Visibility="{Binding HasManagedTrainers, Converter={StaticResource InvBoolToVis}}">
                            <Border Width="52"
                                    Height="52"
                                    CornerRadius="14"
                                    Background="{DynamicResource SubtleSurfaceBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <Path Data="M6,4 V8 M6,12 V20 M12,4 V13 M12,17 V20 M18,4 V7 M18,11 V20 M4,10 A2,2 0 1,0 8,10 A2,2 0 1,0 4,10 M10,15 A2,2 0 1,0 14,15 A2,2 0 1,0 10,15 M16,9 A2,2 0 1,0 20,9 A2,2 0 1,0 16,9"
                                      Stroke="{DynamicResource MutedTextBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="24"
                                      Height="24"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="尚未安装任何外部修改器"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="{Binding Settings.TrainerOverviewEmptyStateDescription}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                            <WrapPanel Orientation="Horizontal"
                                       HorizontalAlignment="Center"
                                       Margin="0,18,0,0">
                                <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                        Content="选择单机游戏开始匹配"
                                        Margin="0,0,8,6"
                                        Command="{Binding SelectFirstEligibleTrainerGameCommand}"
                                        Visibility="{Binding HasEligibleTrainerGame, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                        Content="前往设置配置游戏库"
                                        Margin="0,0,8,6"
                                        Command="{Binding OpenLibrarySettingsCommand}"
                                        Visibility="{Binding HasEligibleTrainerGame, Converter={StaticResource InvBoolToVis}}" />
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="36"
                                        Margin="0,0,0,6"
                                        Content="配置沙箱与 Defender 排除"
                                        Command="{Binding OpenTrainerSandboxSettingsCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ============================================================== -->
                <!-- 3F. Trainers Center: Per-Game Full Workbench (Reused Template) -->
                <!-- ============================================================== -->
                <Grid Grid.Row="2"
                      Margin="32,16,32,0"
                      MaxWidth="1000"
                      Visibility="{Binding ShowTrainersSingleGamePanel, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Compact Game Context Header (Single Primary Button remains inside TrainerWorkbenchTemplate) -->
                    <Border Grid.Row="0"
                            DataContext="{Binding SelectedTrainerGame}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="46" Height="46" VerticalAlignment="Center">
                                <Border CornerRadius="8"
                                        Background="{DynamicResource SubtleSurfaceBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding InitialsText}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding SmallIcon, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                                        <Image Source="{Binding SmallIcon}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding SmallIcon, Converter={StaticResource NullToVis}}" />
                                    </Grid>
                                </Border>
                                <Border CornerRadius="9"
                                        Margin="-2"
                                        BorderBrush="{DynamicResource RunningGreenBrush}"
                                        BorderThickness="1.8"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text=" · "
                                               FontSize="12.5"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PlatformFullLabel}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <Border CornerRadius="5"
                                            Padding="7,2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Tier0BadgeBackgroundBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AntiCheatTier}" Value="{x:Static contracts:AntiCheatTier.Tier1}">
                                                        <Setter Property="Background" Value="{DynamicResource Tier1BadgeBackgroundBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AntiCheatTier}" Value="{x:Static contracts:AntiCheatTier.Tier2}">
                                                        <Setter Property="Background" Value="{DynamicResource Tier23BadgeBackgroundBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AntiCheatTier}" Value="{x:Static contracts:AntiCheatTier.Tier3}">
                                                        <Setter Property="Background" Value="{DynamicResource Tier23BadgeBackgroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding AntiCheatBadgeText}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Tier0BadgeForegroundBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AntiCheatTier}" Value="{x:Static contracts:AntiCheatTier.Tier1}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Tier1BadgeForegroundBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AntiCheatTier}" Value="{x:Static contracts:AntiCheatTier.Tier2}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Tier23BadgeForegroundBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AntiCheatTier}" Value="{x:Static contracts:AntiCheatTier.Tier3}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Tier23BadgeForegroundBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <Border CornerRadius="5"
                                            Background="{DynamicResource Tier0BadgeBackgroundBrush}"
                                            Padding="7,2"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasVerifiedOfflineBypassBadge, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding VerifiedOfflineBypassBadgeText}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Tier0BadgeForegroundBrush}" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{Binding LastPlayedSummaryText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <WrapPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="30"
                                        Padding="12,0"
                                        FontSize="12"
                                        Margin="0,2,8,2"
                                        Command="{Binding DataContext.LaunchOrStopSpecificGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="启动游戏" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Text" Value="运行中 · 停止" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="30"
                                        Padding="12,0"
                                        FontSize="12"
                                        Margin="0,2,8,2"
                                        Content="返回总览"
                                        Command="{Binding DataContext.SelectTrainersOverviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="30"
                                        Padding="12,0"
                                        FontSize="12"
                                        Margin="0,2,0,2"
                                        Content="在游戏库中查看"
                                        Command="{Binding DataContext.JumpToGameInLibraryTrainersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding GameId}" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Reused Full Trainer Workbench (Matching, Download, Drag-Drop Import, Safety Gate, Hotkeys, Pre-Trainer Snapshots) -->
                    <ContentControl Grid.Row="1"
                                    Content="{Binding Trainer}"
                                    ContentTemplate="{StaticResource TrainerWorkbenchTemplate}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </Grid>

                <!-- ============================================================== -->
                <!-- 3G. Settings Panel (MaxWidth 860px, Responsive Grid(*, Auto))  -->
                <!-- ============================================================== -->
                <ScrollViewer x:Name="SettingsContentScrollViewer"
                              Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding ShowSettingsPanel, Converter={StaticResource BoolToVis}}">
                    <StackPanel DataContext="{Binding Settings}"
                                Margin="32,20,32,36"
                                MaxWidth="860"
                                HorizontalAlignment="Stretch">

                        <!-- Category 1: General & Game Library (Unified Library Scan Directories + Manual Import!) -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqToVis}, ConverterParameter=GeneralAndLibrary}">
                            <!-- Scan Directories -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,12,0,18">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="游戏库扫描目录" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ScanDirectoriesSubtitleText}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Content="添加目录"
                                                    Command="{Binding AddScanDirectoryCommand}"
                                                    Margin="0,2,8,2" />
                                            <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                                    Content="立即扫描游戏库"
                                                    Command="{Binding ScanAllConfiguredDirectoriesCommand}"
                                                    Margin="0,2,0,2" />
                                        </WrapPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding ScanDirectories}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ScanDirectoryEntry}">
                                                <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                                        CornerRadius="8"
                                                        Padding="12,8"
                                                        Margin="0,4,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Path}"
                                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                                       FontSize="12.5"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding SourceNote}"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                                Height="26"
                                                                Padding="10,0"
                                                                FontSize="12"
                                                                Content="移除"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.RemoveScanDirectoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Manual Single-Game Folder / EXE Import -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16,0,18">
                                <StackPanel>
                                    <TextBlock Text="手动导入单款游戏（目录或主程序 .exe）" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="输入或浏览选择单机游戏目录 / .exe 路径导入游戏库；也可随时将文件夹直接拖入主窗口"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Height="34"
                                                Margin="0,0,10,0"
                                                CornerRadius="17"
                                                Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1"
                                                Padding="14,0">
                                            <Grid>
                                                <TextBlock Text="粘贴游戏安装目录或主程序 .exe 路径…"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding ManualGameImportPathText, Converter={StaticResource StrNotEmptyToVis}, ConverterParameter=Invert}" />
                                                <TextBox x:Name="SettingsManualImportTextBox"
                                                         Text="{Binding ManualGameImportPathText, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                                         CaretBrush="{DynamicResource AccentBrush}"
                                                         FontSize="12.5"
                                                         VerticalContentAlignment="Center"
                                                         PreviewKeyDown="OnSettingsManualImportTextBoxPreviewKeyDown" />
                                            </Grid>
                                        </Border>
                                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Height="34"
                                                    Padding="12,0"
                                                    Content="浏览目录"
                                                    Command="{Binding BrowseAndImportSingleGameFolderCommand}" />
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Height="34"
                                                    Padding="12,0"
                                                    Margin="6,0,0,0"
                                                    Content="选择 .exe"
                                                    Command="{Binding BrowseAndImportSingleGameExeCommand}" />
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Height="34"
                                                    Padding="14,0"
                                                    Margin="6,0,0,0"
                                                    Content="导入游戏"
                                                    Command="{Binding ImportManualGamePathCommand}" />
                                        </WrapPanel>
                                    </Grid>

                                    <!-- Post-Import Quick Jump Strip (stays on Settings so batch manual imports stay smooth!) -->
                                    <Border CornerRadius="8"
                                            Background="{DynamicResource InfoBannerBackgroundBrush}"
                                            BorderBrush="{DynamicResource InfoBannerBorderBrush}"
                                            BorderThickness="1"
                                            Padding="12,7"
                                            Margin="0,10,0,0"
                                            Visibility="{Binding HasLastImportedGame, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding LastImportedGameHintText}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0" />
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Height="28"
                                                    Padding="12,0"
                                                    FontSize="12"
                                                    Content="查看该游戏"
                                                    Command="{Binding OpenLastImportedGameCommand}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Steam Client & Steam Input Launch Settings -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16,0,18">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Steam 客户端与手柄映射启动"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <Border CornerRadius="5"
                                                        Padding="7,2"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource WarningSoftBannerBackgroundBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningSoftBannerBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SteamDetectionStatusKind}" Value="Auto">
                                                                    <Setter Property="Background" Value="{DynamicResource Tier0BadgeBackgroundBrush}" />
                                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SteamDetectionStatusKind}" Value="Manual">
                                                                    <Setter Property="Background" Value="{DynamicResource InfoBannerBackgroundBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource InfoBannerBorderBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding SteamDetectionStatusBadgeText}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningAmberBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SteamDetectionStatusKind}" Value="Auto">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Tier0BadgeForegroundBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SteamDetectionStatusKind}" Value="Manual">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <Border CornerRadius="5"
                                                        Background="{DynamicResource SubtleSurfaceBrush}"
                                                        BorderBrush="{DynamicResource DividerBrush}"
                                                        BorderThickness="1"
                                                        Padding="7,2"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        ToolTip="{Binding SteamRunningStatusToolTip}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="7"
                                                                 Height="7"
                                                                 Margin="0,0,5,0"
                                                                 VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSteamClientRunning}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource RunningGreenBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding SteamRunningStatusText}"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="自动检测本机 Steam 客户端与本地账号，支持通过 Steam Input 为单机或非手柄游戏启用手柄映射与社区布局"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>

                                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Height="32"
                                                    Padding="12,0"
                                                    FontSize="12.5"
                                                    Content="重新检测"
                                                    Command="{Binding RedetectSteamClientCommand}"
                                                    Margin="0,2,6,2" />
                                            <Grid Margin="0,2,6,2">
                                                <Button x:Name="SteamBrowseButton"
                                                        Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                        Tag="{Binding}"
                                                        IsHitTestVisible="{Binding IsOpen, ElementName=SteamBrowsePopup, Converter={StaticResource EqToBool}, ConverterParameter=False}"
                                                        Height="32"
                                                        Padding="12,0"
                                                        FontSize="12.5"
                                                        Content="浏览指定…"
                                                        Click="OnSteamBrowseMenuButtonClick" />
                                                <Popup x:Name="SteamBrowsePopup"
                                                       PlacementTarget="{Binding ElementName=SteamBrowseButton}"
                                                       DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                                       Placement="Bottom"
                                                       VerticalOffset="6"
                                                       StaysOpen="False"
                                                       AllowsTransparency="True"
                                                       PopupAnimation="Fade"
                                                       Opened="OnManagedPopupOpened"
                                                       Closed="OnManagedPopupClosed">
                                                    <Border Width="212"
                                                            Margin="8"
                                                            Padding="5"
                                                            CornerRadius="10"
                                                            Background="{DynamicResource FloatingMenuBackgroundBrush}"
                                                            BorderBrush="{DynamicResource DividerBrush}"
                                                            BorderThickness="1">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16" Color="#000000" />
                                                        </Border.Effect>
                                                        <StackPanel>
                                                            <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                                    Content="选择 Steam 安装文件夹…"
                                                                    Click="OnAnyPopupMenuItemClick"
                                                                    Command="{Binding BrowseSteamInstallFolderCommand}" />
                                                            <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                                    Content="选择 steam.exe 文件…"
                                                                    Click="OnAnyPopupMenuItemClick"
                                                                    Command="{Binding BrowseSteamExecutableCommand}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Height="32"
                                                    Padding="12,0"
                                                    FontSize="12.5"
                                                    Content="恢复自动"
                                                    Command="{Binding ResetSteamInstallDirectoryOverrideCommand}"
                                                    IsEnabled="{Binding HasSteamInstallDirectoryOverride}"
                                                    Margin="0,2,0,2" />
                                        </WrapPanel>
                                    </Grid>

                                    <!-- Resolved Steam Executable / Directory Card -->
                                    <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                            CornerRadius="8"
                                            Padding="12,9"
                                            Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SteamResolvedPathText}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SteamDetectionDetailText}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0"
                                                       Visibility="{Binding SteamDetectionDetailText, Converter={StaticResource StrNotEmptyToVis}}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Inline Validation Error for Manual Override -->
                                    <Border CornerRadius="8"
                                            Background="{DynamicResource DangerSoftBannerBackgroundBrush}"
                                            BorderBrush="{DynamicResource DangerSoftBannerBorderBrush}"
                                            BorderThickness="1"
                                            Padding="11,8"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding HasSteamPathValidationError, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding SteamPathValidationErrorText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource DangerTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Target Steam Account Selector -->
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="目标 Steam 账号"
                                                       FontSize="13.5"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="写入非 Steam 快捷方式（shortcuts.vdf）时使用的本地 Steam 账号，默认优先当前活跃或最近登录账号"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding SteamAccountsEmptyHintText}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0"
                                                       Visibility="{Binding HasSteamAccounts, Converter={StaticResource InvBoolToVis}}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  Width="256"
                                                  Height="32"
                                                  VerticalAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding SteamAccounts}"
                                                  DisplayMemberPath="DisplayLabel"
                                                  SelectedItem="{Binding SelectedSteamAccount, Mode=TwoWay}"
                                                  IsEnabled="{Binding HasSteamAccounts}" />
                                    </Grid>

                                    <!-- Suppress Duplicate Achievement Toast Toggle -->
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="通过 Steam 启动正版 Steam 游戏时静默 SPAWN 成就弹窗（避免与 Steam 弹窗双响）"
                                                       FontSize="13.5"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="开启后后台仍完整记录成就与解锁时间，仅静默 OverlayHost 弹窗提示；非 Steam 单机与 GOG 游戏不受影响"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                                  IsChecked="{Binding SteamSuppressDuplicateAchievementToast, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Close Window Behavior (System Tray) -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="关闭窗口时最小化到系统托盘（推荐）" FontSize="14" TextWrapping="Wrap" />
                                        <TextBlock Text="保持后台离线成就监听与游戏内跳杯运行；右键托盘图标可随时完全退出"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                              IsChecked="{Binding CloseWindowToTray, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Auto-Start Silent to System Tray -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="开机静默启动到系统托盘" FontSize="14" TextWrapping="Wrap" />
                                        <TextBlock Text="登录 Windows 后自动在后台启动 SPAWN 并驻留系统托盘，不弹出主窗口、不打扰桌面"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                              IsChecked="{Binding StartWithWindowsMinimizedToTray, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- AFK Idle Timeout -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="挂机（AFK）判定静默时长" FontSize="14" TextWrapping="Wrap" />
                                        <TextBlock Text="游戏在前台但键鼠与手柄连续无输入超过该时长时，自动归入挂机时长"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Width="168"
                                              Height="32"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              ItemsSource="{Binding AfkTimeoutOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedAfkTimeoutSec, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <!-- Anti-Cheat Guard Live Status -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="反作弊安全守卫状态"
                                                   FontSize="14"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="自动监控受保护网游及其守护进程，必要时物理清场并进入 15 秒安全冷却"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AntiCheatStatusSummary}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="320"
                                               TextAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource RunningGreenBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAntiCheatGuardWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningAmberBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAntiCheatGuardLocked}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Tier23BadgeForegroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Category 2: Achievements & Steam Web API -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqToVis}, ConverterParameter=AchievementAndSteamApi}">
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,14,0,18">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Steam Web API Key"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Button Style="{StaticResource AccentLinkButtonStyle}"
                                                    Content="前往 Steam 官方申请"
                                                    FontSize="12"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding OpenSteamApiKeyRegistrationCommand}" />
                                        </WrapPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Fill="{DynamicResource RunningGreenBrush}"
                                                     Margin="0,0,7,0"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding IsSteamApiKeyConfigured, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding SteamApiKeyStatusText}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="用于加速拉取官方成就名称、描述与图标。自定义密钥须为 32 位十六进制字符，仅保存在本机并按当前 Windows 账户加密，绝不写入明文日志。"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,8,0,12"
                                               TextWrapping="Wrap" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Height="34"
                                                Margin="0,0,10,0"
                                                CornerRadius="17"
                                                Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1"
                                                Padding="14,0">
                                            <Grid>
                                                <TextBlock Text="粘贴 32 位十六进制 Steam Web API Key…"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding CustomSteamApiKeyInput, Converter={StaticResource StrNotEmptyToVis}, ConverterParameter=Invert}" />
                                                <PasswordBox x:Name="SteamApiKeyPasswordBox"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                                             CaretBrush="{DynamicResource AccentBrush}"
                                                             FontFamily="{StaticResource SpawnMonoFont}"
                                                             FontSize="12.5"
                                                             VerticalContentAlignment="Center"
                                                             PasswordChanged="OnSteamApiKeyPasswordChanged"
                                                             Visibility="{Binding ShowCustomSteamApiKey, Converter={StaticResource InvBoolToVis}}" />
                                                <TextBox Text="{Binding CustomSteamApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                                         CaretBrush="{DynamicResource AccentBrush}"
                                                         FontFamily="{StaticResource SpawnMonoFont}"
                                                         FontSize="12.5"
                                                         VerticalContentAlignment="Center"
                                                         Visibility="{Binding ShowCustomSteamApiKey, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="显示"
                                                      Margin="0,0,10,0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding ShowCustomSteamApiKey, Mode=TwoWay}" />
                                            <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                                    Height="34"
                                                    Content="加密保存密钥"
                                                    Command="{Binding SaveCustomSteamApiKeyCommand}" />
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Height="34"
                                                    Margin="8,0,0,0"
                                                    Content="清除自定义"
                                                    Command="{Binding ClearCustomSteamApiKeyCommand}" />
                                        </WrapPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Achievement Language Preference -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="成就名称与描述语言偏好" FontSize="14" TextWrapping="Wrap" />
                                        <TextBlock Text="同步 Steam 官方成就元数据时优先请求该语言，切换后可在游戏成就页点击刷新元数据生效"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Width="188"
                                              Height="32"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding AchievementLanguageOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedAchievementLanguage, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="默认显示隐藏成就达成条件（剧透开关）" FontSize="14" TextWrapping="Wrap" />
                                        <TextBlock Text="关闭时，未解锁的隐藏成就默认折叠条件，点击单条时再展开"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                              IsChecked="{Binding GlobalRevealSpoilers, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Category 3: Overlay Theme, Position & Sound -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqToVis}, ConverterParameter=OverlayAndSound}">
                            <!-- Master Overlay DND Toggle -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="启用游戏内成就弹窗（关闭即进入免打扰）" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="关闭后游玩期间不再弹出屏幕跳杯通知，成就进度仍在后台照常记录"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                              IsChecked="{Binding OverlayEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="游戏内跳杯弹窗样式" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="选择 PS5 奖杯主题时，集齐最后一项达成 100% 将自动连发「白金奖杯」庆典弹窗"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Width="248"
                                              Height="32"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              ItemsSource="{Binding OverlayThemeOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedOverlayTheme, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="弹窗屏幕显示位置"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0" />
                                    <ComboBox Grid.Column="1"
                                              Width="188"
                                              Height="32"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              ItemsSource="{Binding OverlayPositionOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedOverlayPosition, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="解锁提示音效" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,4,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding ShowSteamSoundStatus, Converter={StaticResource BoolToVis}}">
                                                <Ellipse Width="7"
                                                         Height="7"
                                                         Fill="{DynamicResource RunningGreenBrush}"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding IsSteamSoundDetected, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding SteamSoundStatusText}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  Width="248"
                                                  Height="32"
                                                  VerticalAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding OverlaySoundPresetOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedOverlaySoundPreset, Mode=TwoWay}" />
                                    </Grid>

                                    <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                            CornerRadius="8"
                                            Padding="12,9"
                                            Margin="0,12,0,0"
                                            Visibility="{Binding ShowCustomWavPicker, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding CustomWavDisplayStatus}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0" />
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Height="28"
                                                    Padding="12,0"
                                                    FontSize="12.5"
                                                    Content="选择 .wav 文件"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding BrowseCustomOverlayWavCommand}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="弹窗音频输出设备" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding AudioRoutingStatusText}"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox Width="256"
                                                  Height="32"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding AudioOutputDeviceOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedAudioOutputDeviceId, Mode=TwoWay}" />
                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Height="32"
                                                Padding="12,0"
                                                Margin="8,0,0,0"
                                                Content="刷新设备"
                                                Command="{Binding RefreshAudioOutputDevicesCommand}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="解锁提示音音量" FontSize="14" TextWrapping="Wrap" />
                                        <TextBlock Text="Steam 原版音效按原始响度播放（100% 与 Steam 一致），静音状态下拖动滑块将自动取消静音"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                                  Content="静音"
                                                  IsChecked="{Binding OverlayMuteSound, Mode=TwoWay}"
                                                  Margin="0,0,14,0" />
                                        <Slider Width="144"
                                                Minimum="0"
                                                Maximum="100"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="False"
                                                Opacity="{Binding OverlayVolumeSliderOpacity}"
                                                Value="{Binding OverlayVolumePercent, Mode=TwoWay}"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding OverlayVolumeDisplayText}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12.5"
                                                   Width="62"
                                                   TextAlignment="Right"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Padding="0,18,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="实时跳杯效果实测" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="预览当前主题、显示位置与提示音效果，弹窗采用点击穿透设计，绝不抢占游戏画面焦点"
                                                       ToolTip="技术实现：独立 OverlayHost 进程搭配 WS_EX_NOACTIVATE + WS_EX_TRANSPARENT 置顶分层窗口"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Content="预览 PS5 白金连发"
                                                    Command="{Binding TriggerPlatinumChainTestCommand}"
                                                    Margin="0,2,8,2" />
                                            <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                                    Content="立即弹出测试成就"
                                                    Command="{Binding TriggerTestToastCommand}"
                                                    Margin="0,2,0,2" />
                                        </WrapPanel>
                                    </Grid>
                                    <TextBlock Text="提示：建议在游戏画面设置中选择「无边框窗口化」以获得最佳游戏内弹窗显示效果（独占全屏模式下系统可能屏蔽外部置顶层）。"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Category 6: Trainer & Security Sandbox (SettingsCategory.TrainerAndSandbox) -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqToVis}, ConverterParameter=TrainerAndSandbox}">
                            <!-- 0. Trainer Source Provenance & External Website Boundary Disclosure -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,12,0,16">
                                <StackPanel>
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TrainerSourceProvenanceTitle}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Border CornerRadius="4"
                                                Background="{DynamicResource InfoBannerBackgroundBrush}"
                                                BorderBrush="{DynamicResource InfoBannerBorderBrush}"
                                                BorderThickness="1"
                                                Padding="7,1.5"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="非 SPAWN 内置 · 外部网站按需直连 / 本地导入"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding TrainerSourceProvenanceDescription}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="在线检索外部站点白名单：https://flingtrainer.com · https://archive.flingtrainer.com（Opt-in） | 本地文件标识：本地导入 · 用户手动添加"
                                               FontFamily="{StaticResource SpawnMonoFont}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 1. Pure-ASCII Custom Sandbox Root -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,12,0,18">
                                <StackPanel>
                                    <TextBlock Text="修改器隔离沙箱根目录（建议纯英文路径）" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="所有已导入修改器均集中存放于此沙箱目录，是唯一允许配置杀软排除的目录。当前生效路径："
                                               FontSize="12.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,4" />
                                    <TextBlock Text="{Binding EffectiveTrainerSandboxRoot}"
                                               FontFamily="{StaticResource SpawnMonoFont}"
                                               FontSize="12"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10" />

                                    <!-- Gentle Non-ASCII Sandbox Path Notice -->
                                    <Border CornerRadius="8"
                                            Background="{DynamicResource WarningSoftBannerBackgroundBrush}"
                                            BorderBrush="{DynamicResource WarningSoftBannerBorderBrush}"
                                            BorderThickness="1"
                                            Padding="12,8"
                                            Margin="0,0,0,10"
                                            Visibility="{Binding HasNonAsciiTrainerSandboxPath, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding NonAsciiTrainerSandboxNoticeText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Height="34"
                                                Margin="0,0,10,0"
                                                CornerRadius="17"
                                                Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1"
                                                Padding="14,0">
                                            <Grid>
                                                <TextBlock Text="留空使用默认目录，或填纯英文路径（如 D:\SpawnSandbox\Trainers）"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding TrainerCustomSandboxRootInput, Converter={StaticResource StrNotEmptyToVis}, ConverterParameter=Invert}" />
                                                <TextBox Text="{Binding TrainerCustomSandboxRootInput, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                                         CaretBrush="{DynamicResource AccentBrush}"
                                                         FontFamily="{StaticResource SpawnMonoFont}"
                                                         FontSize="12"
                                                         VerticalContentAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Height="34"
                                                    Padding="12,0"
                                                    Content="浏览…"
                                                    Command="{Binding BrowseCustomSandboxRootCommand}" />
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Height="34"
                                                    Padding="12,0"
                                                    Margin="6,0,0,0"
                                                    Content="应用并迁移"
                                                    Command="{Binding ApplyCustomSandboxRootCommand}" />
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Height="34"
                                                    Padding="12,0"
                                                    Margin="6,0,0,0"
                                                    Content="恢复默认"
                                                    Command="{Binding ResetDefaultSandboxRootCommand}"
                                                    Visibility="{Binding HasCustomTrainerSandboxRoot, Converter={StaticResource BoolToVis}}" />
                                        </WrapPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2. Windows Defender Single-Folder Exclusion Assistant & Smart App Control Diagnostics -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16,0,18">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Windows Defender 单一沙箱排除助手"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border CornerRadius="5"
                                                    Background="{DynamicResource SubtleSurfaceBrush}"
                                                    BorderBrush="{DynamicResource DividerBrush}"
                                                    BorderThickness="1"
                                                    Padding="7,2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DefenderStatusBadgeText}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </Border>
                                        </WrapPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Height="30"
                                                Padding="12,0"
                                                FontSize="12"
                                                Content="检测状态"
                                                Command="{Binding InspectDefenderExclusionCommand}"
                                                IsEnabled="{Binding IsDefenderWorking, Converter={StaticResource EqToBool}, ConverterParameter=False}" />
                                    </Grid>

                                    <TextBlock Text="{Binding DefenderStatusMessage}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,10" />

                                    <WrapPanel Orientation="Horizontal">
                                        <!-- Primary CTA only when NOT yet excluded; demoted to Secondary once excluded -->
                                        <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                                Height="34"
                                                Padding="16,0"
                                                Margin="0,0,8,6"
                                                Content="添加沙箱目录排除（单次管理员确认）"
                                                ToolTip="仅通过 Windows 原生 WMI 为单一修改器沙箱目录添加 Defender 排除项"
                                                Command="{Binding RequestDefenderExclusionCommand}"
                                                IsEnabled="{Binding IsDefenderWorking, Converter={StaticResource EqToBool}, ConverterParameter=False}"
                                                Visibility="{Binding IsDefenderNotExcluded, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Height="34"
                                                Padding="14,0"
                                                Margin="0,0,8,6"
                                                Content="已排除 · 重新配置"
                                                Command="{Binding RequestDefenderExclusionCommand}"
                                                IsEnabled="{Binding IsDefenderWorking, Converter={StaticResource EqToBool}, ConverterParameter=False}"
                                                Visibility="{Binding IsDefenderExcluded, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Height="34"
                                                Padding="12,0"
                                                Margin="0,0,8,6"
                                                Content="复制沙箱路径"
                                                Command="{Binding CopySandboxPathCommand}" />
                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Height="34"
                                                Padding="12,0"
                                                Margin="0,0,0,6"
                                                Content="打开 Defender 排除设置"
                                                Command="{Binding OpenDefenderSettingsCommand}" />
                                    </WrapPanel>

                                    <!-- Manual Guidance Card when Defender Tamper Protection / 3rd-party AV / UAC cancel occurs -->
                                    <Border CornerRadius="8"
                                            Background="{DynamicResource InfoBannerBackgroundBrush}"
                                            BorderBrush="{DynamicResource InfoBannerBorderBrush}"
                                            BorderThickness="1"
                                            Padding="12,10"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding ShowDefenderManualGuidance, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="手动添加沙箱排除目录指引"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="1. 点击上方「复制沙箱路径」复制修改器隔离目录；&#x0a;2. 点击「打开 Defender 排除设置」（或在您的第三方安全软件中打开信任区/白名单）；&#x0a;3. 选择「添加排除项 → 文件夹」，粘贴沙箱目录并保存后，点击「检测状态」验证。"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Smart App Control Transparent Notice Card -->
                                    <Border CornerRadius="8"
                                            Background="{DynamicResource WarningSoftBannerBackgroundBrush}"
                                            BorderBrush="{DynamicResource WarningSoftBannerBorderBrush}"
                                            BorderThickness="1"
                                            Padding="12,10"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding ShowSmartAppControlCard, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="Windows 11 智能应用控制（Smart App Control）提示"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Tier1BadgeForegroundBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="智能应用控制处于强制模式时，Defender 排除项无法绕过系统拦截，且 SPAWN 绝不会尝试通过程序关闭该保护。"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Height="30"
                                                    Padding="12,0"
                                                    FontSize="12"
                                                    Content="微软官方说明"
                                                    Command="{Binding OpenSmartAppControlLearnMoreCommand}"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 3. Zero-Injection Audio Mute & Pre-Launch Mute Config -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="修改器静音策略（零注入）" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="默认完全静音，防止修改器背景音乐和刺耳提示音打扰游戏；“保留提示音”为实验性选项，仅对新版 FLiNG 生效"
                                                       ToolTip="技术机制：A0 启动前预写（INI 关音乐 + 27B 静音 MIDI）+ MTA WASAPI 全端点会话静音"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  Width="268"
                                                  Height="32"
                                                  VerticalAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding TrainerAudioModeOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedTrainerAudioMode, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Margin="0,12,0,0"
                                          Visibility="{Binding ShowTrainerCueVolumeSlider, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="实验性提示音音量"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider Width="160"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    Value="{Binding TrainerCueVolumePercent, Mode=TwoWay}"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TrainerCueVolumeDisplayText}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="12.5"
                                                       Width="48"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                                  Content="启动前自动静音修改器背景音乐（自动备份原配置，随时可还原）"
                                                  ToolTip="技术机制：A0 启动前预写（修改器 INI 静音 + 27B 纯静音 MIDI，并自动生成 .spawn_bak 备份）"
                                                  IsChecked="{Binding TrainerEnableA0PreMute, Mode=TwoWay}"
                                                  Margin="0,0,12,0"
                                                  VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Height="30"
                                                Padding="12,0"
                                                FontSize="12"
                                                Content="还原静音备份"
                                                ToolTip="还原 A0 启动前预写备份的原始修改器配置文件"
                                                Command="{Binding RestoreTrainerA0BackupsCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 4. Hotkey Hold Duration, ScanCode Mode & Lifecycle Coupling -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="无小键盘热键代理按压时长（50–120 ms）" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="默认 75 ms，兼顾热键识别率与响应速度；若修改器偶发漏识别按键可适当调高"
                                                       ToolTip="默认时序：修饰键 20 ms 前置 + 75 ms 保持 + 20 ms 释放"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider Width="156"
                                                    Minimum="50"
                                                    Maximum="120"
                                                    TickFrequency="5"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding TrainerHotkeyHoldMs, Mode=TwoWay}"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TrainerHotkeyHoldMsDisplayText}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="12.5"
                                                       Width="56"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                              Content="硬件扫描码兼容模式（仅极少数旧游戏热键无响应时开启，默认关闭）"
                                              ToolTip="技术机制：启用 KEYEVENTF_SCANCODE 纯硬件扫描码发送模式以兼容旧版 DirectInput 工具"
                                              IsChecked="{Binding TrainerDefaultScanCodeMode, Mode=TwoWay}"
                                              Margin="0,12,0,0" />

                                    <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                              Content="游戏退出时自动停止修改器并清理沙箱进程树（推荐）"
                                              IsChecked="{Binding TrainerStopWithGameExit, Mode=TwoWay}"
                                              Margin="0,10,0,0" />

                                    <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                              Content="启动修改器后自动隐藏其原窗口（仍可随时点击「显示原窗口」）"
                                              IsChecked="{Binding TrainerHideOriginalWindowOnLaunch, Mode=TwoWay}"
                                              Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 5. Pre-Trainer Lightweight Save Snapshots -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="启动修改器前自动备份当前存档（轻量快照）" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="超体积阈值或存档被占用时自动跳过，绝不阻断修改器启动；回滚前自动创建安全备份"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                                  IsChecked="{Binding TrainerCreatePreSnapshot, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                    </Grid>

                                    <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,4" VerticalAlignment="Center">
                                            <TextBlock Text="每游戏滚动保留份数："
                                                       FontSize="13"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       VerticalAlignment="Center" />
                                            <ComboBox Width="148"
                                                      Height="30"
                                                      Margin="6,0,0,0"
                                                      ItemsSource="{Binding TrainerSnapshotRetentionOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding SelectedTrainerSnapshotRetentionCount, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                            <TextBlock Text="单次跳过阈值："
                                                       FontSize="13"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       VerticalAlignment="Center" />
                                            <ComboBox Width="148"
                                                      Height="30"
                                                      Margin="6,0,0,0"
                                                      ItemsSource="{Binding TrainerSnapshotMaxSizeMbOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding SelectedTrainerSnapshotMaxSizeMb, Mode=TwoWay}" />
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- 6. Discovery Archive Opt-in & vgk.sys Strict Mode -->
                            <Border Padding="0,16,0,0">
                                <StackPanel>
                                    <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                              Content="检索修改器时包含第三方外部网站 FLiNG 归档站历史索引（archive.flingtrainer.com · Opt-in，7 天本地缓存，默认关闭）"
                                              IsChecked="{Binding TrainerIncludeFlingArchive, Mode=TwoWay}" />

                                    <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                              Content="vgk.sys 严格模式：检测到 Riot Vanguard 驱动驻留时一律禁止启动任何修改器"
                                              IsChecked="{Binding TrainerStrictVanguardMode, Mode=TwoWay}"
                                              Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Category 8: Save Time Machine & Cloud Sync (SettingsCategory.SavesAndCloudSync) -->
                        <savesViews:SavesSettingsControl Visibility="{Binding SelectedCategory, Converter={StaticResource EqToVis}, ConverterParameter=SavesAndCloudSync}" />

                        <!-- Category 4: Appearance Theme (Follow Windows System / Light / Dark Geek) -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqToVis}, ConverterParameter=AppearanceTheme}">
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,14,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="界面色彩主题" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="支持跟随 Windows 系统深浅色自动切换，或手动锁定清透浅色 / 极客深色"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                                     GroupName="UiThemeRadioGroup"
                                                     Padding="14,0"
                                                     Margin="0,2,6,2"
                                                     Content="跟随 Windows 系统"
                                                     IsChecked="{Binding SelectedUiThemeMode, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:UiThemePreferenceMode.System}}" />
                                        <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                                     GroupName="UiThemeRadioGroup"
                                                     Padding="14,0"
                                                     Margin="0,2,6,2"
                                                     Content="☀ 清透浅色"
                                                     IsChecked="{Binding SelectedUiThemeMode, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:UiThemePreferenceMode.Light}}" />
                                        <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                                     GroupName="UiThemeRadioGroup"
                                                     Padding="14,0"
                                                     Margin="0,2,0,2"
                                                     Content="☾ 极客深色"
                                                     IsChecked="{Binding SelectedUiThemeMode, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:UiThemePreferenceMode.Dark}}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Category 7: Updates (SettingsCategory.Updates) -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqToVis}, ConverterParameter=Updates}">
                            <!-- Current Version / Channel / Commit & Single Primary Action -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,14,0,18">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="当前版本"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Update.CurrentVersionText}"
                                                           FontFamily="{StaticResource SpawnMonoFont}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center" />
                                                <Border CornerRadius="5"
                                                        Background="{DynamicResource SubtleSurfaceBrush}"
                                                        BorderBrush="{DynamicResource DividerBrush}"
                                                        BorderThickness="1"
                                                        Padding="7,1.5"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Update.ChannelBadgeText}"
                                                               FontFamily="{StaticResource SpawnMonoFont}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </Border>
                                                <TextBlock Text=" · "
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Update.CommitShortShaText}"
                                                           FontFamily="{StaticResource SpawnMonoFont}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Update.ChannelDescriptionText}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>

                                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Content="发布说明"
                                                    Margin="0,2,8,2"
                                                    Command="{Binding Update.OpenReleaseNotesCommand}"
                                                    Visibility="{Binding Update.HasReleaseNotesUrl, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                                    Margin="0,2,0,2"
                                                    Content="{Binding Update.PrimaryActionButtonText}"
                                                    Command="{Binding Update.PrimaryActionCommand}"
                                                    IsEnabled="{Binding Update.CanExecutePrimaryAction}" />
                                        </WrapPanel>
                                    </Grid>

                                    <!-- Dev / Source Channel Notice -->
                                    <Border CornerRadius="10"
                                            Background="{DynamicResource WarningSoftBannerBackgroundBrush}"
                                            BorderBrush="{DynamicResource WarningSoftBannerBorderBrush}"
                                            BorderThickness="1"
                                            Padding="14,10"
                                            Margin="0,12,0,0"
                                            Visibility="{Binding Update.IsDevOrSourceChannel, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Update.DevChannelNoticeText}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource WarningAmberBrush}" />
                                            <TextBlock Text="仅正式版（release 通道）会检查 GitHub Releases 签名更新；开发版与源码运行永不向远端发起更新请求。"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Download Progress Bar -->
                                    <ProgressBar Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding Update.DownloadProgressPercent, Mode=OneWay}"
                                                 Height="6"
                                                 Margin="0,12,0,0"
                                                 BorderThickness="0"
                                                 Background="{DynamicResource SubtleSurfaceBrush}"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 Visibility="{Binding Update.IsDownloading, Converter={StaticResource BoolToVis}}">
                                        <ProgressBar.Template>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Border x:Name="PART_Track"
                                                        CornerRadius="3"
                                                        Background="{TemplateBinding Background}"
                                                        ClipToBounds="True">
                                                    <Border x:Name="PART_Indicator"
                                                            CornerRadius="3"
                                                            HorizontalAlignment="Left"
                                                            Background="{TemplateBinding Foreground}" />
                                                </Border>
                                            </ControlTemplate>
                                        </ProgressBar.Template>
                                    </ProgressBar>
                                </StackPanel>
                            </Border>

                            <!-- Auto-Check & Auto-Install Policy Toggles -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <StackPanel>
                                    <TextBlock Text="更新策略" FontSize="14" FontWeight="SemiBold" />
                                    <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                              Content="自动检查正式版更新（启动后 60 秒检查一次，之后每 24 小时检查一次）"
                                              IsChecked="{Binding Update.AutoCheckEnabled, Mode=TwoWay}"
                                              IsEnabled="{Binding Update.IsUpdateSupported}"
                                              Margin="0,12,0,0" />
                                    <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                              Content="空闲且仅驻留系统托盘时自动静默安装（关闭后改为「仅提醒」）"
                                              IsChecked="{Binding Update.AutoInstallWhenIdle, Mode=TwoWay}"
                                              IsEnabled="{Binding Update.IsUpdateSupported}"
                                              Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding Update.InstallPolicyDescriptionText}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Check Timestamps & Latest Status -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="上次检查时间" FontSize="13.5" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding Update.LastCheckTimeText}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Right" />
                                    </DockPanel>
                                    <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                        <TextBlock Text="下次计划检查" FontSize="13.5" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding Update.NextCheckTimeText}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Right" />
                                    </DockPanel>
                                    <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                        <TextBlock Text="当前状态与结果" FontSize="13.5" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding Update.StatusSummaryText}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="520"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Latest 20 Update History Records -->
                            <Border Padding="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="最近更新记录（最多保留 20 条）"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="暂无更新记录。"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,10,0,0"
                                               Visibility="{Binding Update.HasHistory, Converter={StaticResource InvBoolToVis}}" />

                                    <ItemsControl ItemsSource="{Binding Update.HistoryItems}"
                                                  Margin="0,10,0,0"
                                                  Visibility="{Binding Update.HasHistory, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:UpdateHistoryItemViewModel}">
                                                <Border BorderBrush="{DynamicResource DividerBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,10">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="False">
                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding VersionTransitionText}"
                                                                           FontFamily="{StaticResource SpawnMonoFont}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" />
                                                                <Border CornerRadius="4"
                                                                        Background="{DynamicResource SubtleSurfaceBrush}"
                                                                        Padding="6,1"
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TriggerLabel}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                </Border>
                                                                <Border CornerRadius="4"
                                                                        Padding="6,1"
                                                                        Margin="6,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource Tier0BadgeBackgroundBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource Tier23BadgeBackgroundBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsDeferred}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource WarningAmberSoftBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding ResultLabel}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource Tier0BadgeForegroundBrush}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource Tier23BadgeForegroundBrush}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsDeferred}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningAmberBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </StackPanel>

                                                            <TextBlock Text="{Binding TimestampText}"
                                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       VerticalAlignment="Center"
                                                                       DockPanel.Dock="Right" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Detail}"
                                                                   FontSize="12.5"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Category 5: About & Build Version -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqToVis}, ConverterParameter=AboutAndVersion}">
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,14,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BuildProductName}"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                            <Border x:Name="AboutBuildChannelBadge"
                                                    CornerRadius="5"
                                                    Background="#F3A115"
                                                    Padding="7,2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsDevOrSourceBuild, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding BuildChannelBadgeText}"
                                                           FontFamily="{StaticResource SpawnMonoFont}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#202124" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ChannelDisplayName}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                            Content="复制诊断摘要"
                                            VerticalAlignment="Center"
                                            Command="{Binding CopyVersionDiagnosticsCommand}" />
                                </Grid>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="版本号与构建提交" FontSize="14" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BuildVersionText}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text=" · Commit " FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BuildCommitShaText}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text=" · " FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BuildTimeUtcText}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="应用安装目录" FontSize="14" />
                                        <TextBlock Text="{Binding InstallDirectoryPath}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                            Content="打开安装目录"
                                            VerticalAlignment="Center"
                                            Command="{Binding OpenInstallDirectoryCommand}" />
                                </Grid>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="应用数据与运行目录" FontSize="14" />
                                        <TextBlock Text="{Binding DataRootPath}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Content="打开数据目录"
                                                Margin="0,2,8,2"
                                                Command="{Binding OpenDataDirectoryCommand}" />
                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Content="打开日志目录"
                                                Margin="0,2,8,2"
                                                Command="{Binding OpenLogsDirectoryCommand}" />
                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Content="打开回收站目录"
                                                Margin="0,2,0,2"
                                                Command="{Binding OpenTrashDirectoryCommand}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16"
                                    Visibility="{Binding ShowDevWorkspaceBridge, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="开发工作区桥接路径 (dev-workspace.json)" FontSize="14" />
                                    <TextBlock Text="{Binding WorkspaceBridgeSummaryText}"
                                               FontFamily="{StaticResource SpawnMonoFont}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Drag & Drop Visual Overlay -->
                <Border x:Name="DragDropOverlay"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Margin="16"
                        CornerRadius="16"
                        Background="{DynamicResource InfoBannerBackgroundBrush}"
                        Opacity="0.94"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="2"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="松开鼠标导入单机游戏目录或外部修改器"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="游戏库视图将自动入库并同步成就；「修改器」页面或游戏详情修改器子页签将自动校验魔数与 SHA-256 并导入沙箱"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
