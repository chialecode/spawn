                                        <DataTemplate DataType="{x:Type vm:AchievementSidebarItemViewModel}">
                                            <Button Cursor="Hand"
                                                    Margin="8,1.5"
                                                    Padding="0"
                                                    FocusVisualStyle="{x:Null}"
                                                    Command="{Binding DataContext.SelectAchievementSidebarGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="RowBd"
                                                                Height="48"
                                                                CornerRadius="8"
                                                                Padding="9,0,9,0"
                                                                Background="Transparent">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="9" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0"
                                                                        Width="28"
                                                                        Height="28"
                                                                        CornerRadius="6"
                                                                        Background="{DynamicResource SubtleSurfaceBrush}"
                                                                        BorderBrush="{DynamicResource DividerBrush}"
                                                                        BorderThickness="1"
                                                                        ClipToBounds="True"
                                                                        VerticalAlignment="Center">
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding InitialsText}"
