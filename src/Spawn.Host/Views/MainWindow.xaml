                                    <Path Data="M19,8 A7.5,7.5 0 1,0 20,13.5 M19,3.8 V8.2 H14.6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Fixed Top Overview Row + IME-Guarded Search Box -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,2,0,4">
                            <Button Cursor="Hand"
                                    Margin="8,1,8,8"
                                    Padding="0"
                                    FocusVisualStyle="{x:Null}"
