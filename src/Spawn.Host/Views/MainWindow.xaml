                                             PreviewKeyDown="OnSaveSidebarSearchPreviewKeyDown" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            Width="20"
                                            Height="20"
                                            ToolTip="清空筛选"
                                            Command="{Binding ClearSaveSidebarSearchCommand}"
                                            Visibility="{Binding SaveSidebarSearchText, Converter={StaticResource StrNotEmptyToVis}}">
                                        <Path Data="M0,0 L7,7 M7,0 L0,7"
                                              Stroke="{DynamicResource MutedTextBrush}"
                                              StrokeThickness="1.3"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
