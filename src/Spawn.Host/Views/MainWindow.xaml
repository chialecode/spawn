                                           FontSize="12.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="18,14,16,0"
                                           Visibility="{Binding HasFilteredSaveSidebarGames, Converter={StaticResource InvBoolToVis}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Context B2: Trainers Manager Sidebar -->
                    <DockPanel Visibility="{Binding ActiveSection, Converter={StaticResource EqToVis}, ConverterParameter=Trainers}">
