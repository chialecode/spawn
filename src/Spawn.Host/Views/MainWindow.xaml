<Window x:Class="Spawn.Host.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Spawn.Host.Converters"
        xmlns:vm="clr-namespace:Spawn.Host.ViewModels"
        xmlns:contracts="clr-namespace:Spawn.Contracts;assembly=Spawn.Contracts"
        Title="SPAWN"
        Width="1220"
        Height="780"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{StaticResource SpawnUiFont}"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop"
        SizeChanged="OnWindowSizeChanged"
        StateChanged="OnWindowStateChanged"
        Closing="OnWindowClosing"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="1"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:EqualityToVisibilityConverter x:Key="EqToVis" />
        <conv:EqualityToBooleanConverter x:Key="EqToBool" />

        <!-- Subtle ⋯ ToggleButton Style for Floating Menus -->
        <Style x:Key="MorePopupToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource CapsuleInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                CornerRadius="18"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Ellipse Width="3.4" Height="3.4" Fill="{TemplateBinding Foreground}" Margin="1.4,0" />
                                <Ellipse Width="3.4" Height="3.4" Fill="{TemplateBinding Foreground}" Margin="1.4,0" />
                                <Ellipse Width="3.4" Height="3.4" Fill="{TemplateBinding Foreground}" Margin="1.4,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Row ⋯ ToggleButton Style -->
        <Style x:Key="RowMorePopupToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource MorePopupToggleStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Sidebar Game Row DataTemplate -->
        <DataTemplate x:Key="SidebarGameItemTemplate" DataType="{x:Type vm:GameListItemViewModel}">
            <Button Cursor="Hand"
                    Margin="8,1.5"
                    Padding="0"
                    FocusVisualStyle="{x:Null}"
                    Command="{Binding DataContext.SelectLibraryGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBd"
                                Height="40"
                                CornerRadius="8"
                                Padding="9,0,10,0"
                                Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Game rounded icon + green active ring -->
                                <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                                    <Border CornerRadius="6"
                                            Background="{DynamicResource SubtleSurfaceBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding InitialsText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding SmallIcon, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                                            <Image Source="{Binding SmallIcon}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding SmallIcon, Converter={StaticResource NullToVis}}" />
                                        </Grid>
                                    </Border>
                                    <Border CornerRadius="7"
                                            Margin="-2"
                                            BorderBrush="{DynamicResource RunningGreenBrush}"
                                            BorderThickness="1.8"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                </Grid>

                                <!-- Game Title -->
                                <TextBlock x:Name="TitleTxt"
                                           Grid.Column="2"
                                           Text="{Binding Title}"
                                           FontSize="13.5"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- Source / Running Tag -->
                                <TextBlock x:Name="TagTxt"
                                           Grid.Column="3"
                                           Text="{Binding SidebarRightTag}"
                                           FontSize="11.5"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter TargetName="TagTxt" Property="Foreground" Value="{DynamicResource RunningGreenBrush}" />
                                <Setter TargetName="TagTxt" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                <Setter TargetName="TitleTxt" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="TitleTxt" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- High-Performance Recycling Virtualized Achievement List Template (220+ items smooth!) -->
        <DataTemplate x:Key="AchievementManagementListTemplate" DataType="{x:Type vm:MainWindowViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Overall Progress Bar & Ratio -->
                <Grid Grid.Row="0" Margin="0,14,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="6" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <TextBlock Text="成就收集总进度"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding CurrentGameProgressSummaryText}"
                                   FontFamily="{StaticResource SpawnMonoFont}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   DockPanel.Dock="Right" />
                    </DockPanel>
                    <ProgressBar Grid.Row="2"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding CurrentGameCompletionPercent, Mode=OneWay}"
                                 Height="6"
                                 BorderThickness="0"
                                 Background="{DynamicResource SubtleSurfaceBrush}"
                                 Foreground="{DynamicResource AccentBrush}">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border x:Name="PART_Track"
                                        CornerRadius="3"
                                        Background="{TemplateBinding Background}"
                                        ClipToBounds="True">
                                    <Border x:Name="PART_Indicator"
                                            CornerRadius="3"
                                            HorizontalAlignment="Left"
                                            Background="{TemplateBinding Foreground}" />
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </Grid>

                <!-- Filter Tabs + Spoiler Switch + Search Filter -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="0,2,0,0">
                    <DockPanel LastChildFill="False">
                        <!-- Filter Tabs -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Bottom">
                            <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                         GroupName="AchFilterTabs"
                                         Content="全部"
                                         IsChecked="{Binding SelectedAchievementTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:AchievementFilterTab.All}}" />
                            <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                         GroupName="AchFilterTabs"
                                         Content="已解锁"
                                         IsChecked="{Binding SelectedAchievementTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:AchievementFilterTab.Unlocked}}" />
                            <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                         GroupName="AchFilterTabs"
                                         Content="未解锁"
                                         IsChecked="{Binding SelectedAchievementTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:AchievementFilterTab.Locked}}" />
                            <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                         GroupName="AchFilterTabs"
                                         Content="隐藏成就"
                                         IsChecked="{Binding SelectedAchievementTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:AchievementFilterTab.Hidden}}" />
                        </StackPanel>

                        <!-- Search Box + Spoiler Toggle -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,0,6">
                            <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                      Content="显示隐藏成就剧透"
                                      IsChecked="{Binding RevealHiddenSpoilers, Mode=TwoWay}"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center" />

                            <Border Width="204"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Data="M6.5,1 A5.5,5.5 0 1,0 6.5,12 A5.5,5.5 0 1,0 6.5,1 M10.6,10.6 L14.2,14.2"
                                          Stroke="{DynamicResource MutedTextBrush}"
                                          StrokeThickness="1.4"
                                          Stretch="Uniform"
                                          Width="13"
                                          Height="13"
                                          VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="搜索成就名称或条件…"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding AchievementSearchText, Converter={StaticResource StrNotEmptyToVis}, ConverterParameter=Invert}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding AchievementSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             CaretBrush="{DynamicResource AccentBrush}"
                                             FontSize="12.5"
                                             VerticalContentAlignment="Center"
                                             Margin="4,0,0,0" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Virtualized Recycling Achievement ListBox (Constrained * height enables true container recycling!) -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding FilteredAchievements}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,0,4,20"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.CacheLength="1,1"
                         VirtualizingPanel.CacheLengthUnit="Page">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True"
                                                    VirtualizationMode="Recycling" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AchievementRowViewModel}">
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 56x56 Color / Grayscale Achievement Icon -->
                                    <Border Grid.Column="0"
                                            Width="56"
                                            Height="56"
                                            CornerRadius="8"
                                            Background="{DynamicResource SubtleSurfaceBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Path Data="M12,3 L14.6,8.3 L20.5,9.1 L16.2,13.3 L17.2,19.1 L12,16.4 L6.8,19.1 L7.8,13.3 L3.5,9.1 L9.4,8.3 Z"
                                                  Stroke="{DynamicResource MutedTextBrush}"
                                                  StrokeThickness="1.5"
                                                  Stretch="Uniform"
                                                  Width="22"
                                                  Height="22"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding IconImage, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                                            <Image Source="{Binding IconImage}"
                                                   Opacity="{Binding IconOpacity}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding IconImage, Converter={StaticResource NullToVis}}" />
                                        </Grid>
                                    </Border>

                                    <!-- Name, Rare Badge, Global Rate & Spoiler-Aware Description -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center" />

                                            <!-- Rare (<10%) Badge -->
                                            <Border CornerRadius="4"
                                                    Background="{DynamicResource RareBadgeBackgroundBrush}"
                                                    BorderBrush="{DynamicResource RareBadgeBorderBrush}"
                                                    BorderThickness="1"
                                                    Padding="6,1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsRare, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding RareBadgeText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource RareBadgeForegroundBrush}" />
                                            </Border>

                                            <!-- Hidden Tag -->
                                            <TextBlock Text="· 隐藏"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}" />

                                            <!-- Global Percent -->
                                            <TextBlock Text="{Binding GlobalPercentText}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasGlobalPercent, Converter={StaticResource BoolToVis}}" />
                                        </WrapPanel>

                                        <!-- Normal / Revealed Description -->
                                        <TextBlock Text="{Binding EffectiveDescription}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,4,12,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding CanClickToRevealSpoiler, Converter={StaticResource InvBoolToVis}}" />

                                        <!-- Hidden Spoiler Click-to-Reveal Chip -->
                                        <Button Command="{Binding RevealRowSpoilerCommand}"
                                                Cursor="Hand"
                                                HorizontalAlignment="Left"
                                                Margin="0,4,0,0"
                                                FocusVisualStyle="{x:Null}"
                                                Visibility="{Binding CanClickToRevealSpoiler, Converter={StaticResource BoolToVis}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Chip"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource SubtleSurfaceBrush}"
                                                            Padding="8,3">
                                                        <TextBlock Text="隐藏成就 · 点击展开查看条件"
                                                                   FontSize="12.5"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>

                                    <!-- Unlock Timestamp / Status -->
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Fill="{DynamicResource RunningGreenBrush}"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding UnlockedStatusText}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Per-Achievement Floating ⋯ Menu -->
                                    <Grid Grid.Column="5" VerticalAlignment="Center">
                                        <ToggleButton x:Name="RowMoreBtn"
                                                      Style="{StaticResource RowMorePopupToggleStyle}"
                                                      Tag="{Binding}"
                                                      ToolTip="更多成就操作"
                                                      AutomationProperties.Name="更多成就操作" />
                                        <Popup IsOpen="{Binding IsChecked, ElementName=RowMoreBtn, Mode=TwoWay}"
                                               PlacementTarget="{Binding ElementName=RowMoreBtn}"
                                               DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                               Placement="Bottom"
                                               HorizontalOffset="-142"
                                               VerticalOffset="4"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Width="176"
                                                    Margin="8"
                                                    Padding="5"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource FloatingMenuBackgroundBrush}"
                                                    BorderBrush="{DynamicResource DividerBrush}"
                                                    BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.14" Color="#000000" />
                                                </Border.Effect>
                                                <StackPanel>
                                                    <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                            Content="标记为已解锁"
                                                            Click="OnAnyPopupMenuItemClick"
                                                            Command="{Binding MarkUnlockedCommand}"
                                                            Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                            Content="重置为未解锁"
                                                            Click="OnAnyPopupMenuItemClick"
                                                            Command="{Binding ResetUnlockedCommand}"
                                                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                            Content="在弹窗中预览此成就"
                                                            Click="OnAnyPopupMenuItemClick"
                                                            Command="{Binding PreviewToastCommand}" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty Filtered State -->
                <TextBlock Grid.Row="2"
                           Text="没有符合当前筛选条件的成就条目"
                           FontSize="13.5"
                           Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,36,0,0"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredAchievements.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Root Shell Border (Compensates maximized borderless thickness) -->
    <Border x:Name="WindowOuterBorder"
            Background="{DynamicResource PageBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Column 1: Leftmost Narrow Icon Rail (52px) -->
                <ColumnDefinition Width="52" />
                <!-- Column 2: Context Sidebar (264px on >=1000px, auto-collapsed on narrow) -->
                <ColumnDefinition Width="Auto" />
                <!-- Column 3: Main Panel (Remaining width) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================================================================== -->
            <!-- COLUMN 1: 52px Narrow Icon Rail (#F7F7F7 Light / #181B20 Dark)     -->
            <!-- ================================================================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource RailBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <!-- Top Brand Mark "S" (also supports drag-to-move) -->
                    <Grid DockPanel.Dock="Top"
                          Height="52"
                          Background="Transparent"
                          MouseLeftButtonDown="OnTitleBarDragMouseDown">
                        <TextBlock Text="S"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Bottom Fixed Security Badge + Settings Gear -->
                    <StackPanel DockPanel.Dock="Bottom"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                        <!-- Anti-Cheat Guard & Channel Status Badge -->
                        <Border Width="34"
                                Height="34"
                                CornerRadius="17"
                                Margin="0,0,0,8"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                ToolTip="{Binding GuardRailToolTip}"
                                AutomationProperties.Name="{Binding GuardRailToolTip}">
                            <Grid>
                                <Path Data="M12,2 L19,5 V11 C19,16.2 15.9,20.7 12,22 C8.1,20.7 5,16.2 5,11 V5 Z"
                                      Stroke="{DynamicResource RunningGreenBrush}"
                                      StrokeThickness="1.6"
                                      Stretch="Uniform"
                                      Width="16"
                                      Height="16"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="{DynamicResource WarningAmberBrush}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,2,2,0"
                                         Visibility="{Binding IsGuardCooldownOrProtected, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>

                        <!-- Settings (⚙ Linear Gear Icon) -->
                        <RadioButton Style="{StaticResource IconRailButtonStyle}"
                                     GroupName="PrimaryRailGroup"
                                     ToolTip="设置"
                                     AutomationProperties.Name="设置"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:PrimaryNavSection.Settings}}">
                            <Path Data="M12,8.6 A3.4,3.4 0 1,0 12,15.4 A3.4,3.4 0 1,0 12,8.6 M19.4,13 A7.6,7.6 0 0,0 19.4,11 L21.2,9.6 L19.4,6.5 L17.2,7.3 A7.4,7.4 0 0,0 15.5,6.3 L15.2,4 H11.6 L11.3,6.3 A7.4,7.4 0 0,0 9.6,7.3 L7.4,6.5 L5.6,9.6 L7.4,11 A7.6,7.6 0 0,0 7.4,13 L5.6,14.4 L7.4,17.5 L9.6,16.7 A7.4,7.4 0 0,0 11.3,17.7 L11.6,20 H15.2 L15.5,17.7 A7.4,7.4 0 0,0 17.2,16.7 L19.4,17.5 L21.2,14.4 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  Stretch="Uniform"
                                  Width="19"
                                  Height="19" />
                        </RadioButton>
                    </StackPanel>

                    <!-- Primary Navigation Items (Strictly M2 Ready Views Only!) -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,2,0,0">
                        <!-- 1. Game Library (Spawn) + Green Running Dot -->
                        <RadioButton Style="{StaticResource IconRailButtonStyle}"
                                     GroupName="PrimaryRailGroup"
                                     ToolTip="{Binding LibraryRailToolTip}"
                                     AutomationProperties.Name="游戏库"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:PrimaryNavSection.Library}}">
                            <Grid Width="24" Height="24">
                                <Path Data="M4,5.5 A2.5,2.5 0 0,1 6.5,3 H17.5 A2.5,2.5 0 0,1 20,5.5 V18.5 A2.5,2.5 0 0,1 17.5,21 H6.5 A2.5,2.5 0 0,1 4,18.5 Z M10,8.5 L15.5,12 L10,15.5 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.65"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="19"
                                      Height="19"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                                <!-- Green Running Status Dot -->
                                <Border Width="9"
                                        Height="9"
                                        CornerRadius="4.5"
                                        Background="{DynamicResource RunningGreenBrush}"
                                        BorderBrush="{DynamicResource RailBackgroundBrush}"
                                        BorderThickness="1.5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-2,-2,0"
                                        Visibility="{Binding HasAnyRunningGame, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </RadioButton>

                        <!-- 2. Achievements Center -->
                        <RadioButton Style="{StaticResource IconRailButtonStyle}"
                                     GroupName="PrimaryRailGroup"
                                     ToolTip="成就中心"
                                     AutomationProperties.Name="成就中心"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:PrimaryNavSection.Achievements}}">
                            <Path Data="M7,4 H17 V8.5 C17,11.6 14.8,14 12,14.8 C9.2,14 7,11.6 7,8.5 Z M12,14.8 V18 M8.5,18 H15.5 M7,5.5 H4.5 V7.5 C4.5,9.4 5.6,10.5 7,10.5 M17,5.5 H19.5 V7.5 C19.5,9.4 18.4,10.5 17,10.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.65"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Width="19"
                                  Height="19" />
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ================================================================== -->
            <!-- COLUMN 2: 264px Context Sidebar (#F7F7F7 + 1px Right Hairline)     -->
            <!-- ================================================================== -->
            <Border Grid.Column="1"
                    Width="264"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <!-- Context A: Game Library Sidebar -->
                    <DockPanel Visibility="{Binding ActiveSection, Converter={StaticResource EqToVis}, ConverterParameter=Library}">
                        <Border DockPanel.Dock="Top"
                                Height="52"
                                Padding="16,0,10,0"
                                Background="Transparent"
                                MouseLeftButtonDown="OnTitleBarDragMouseDown">
                            <Grid>
                                <TextBlock Text="游戏库"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource SubtleIconButtonStyle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ToolTip="扫描本地游戏目录"
                                        AutomationProperties.Name="扫描本地游戏目录"
                                        Command="{Binding ScanDefaultLibraryCommand}">
                                    <Path Data="M19,8 A7.5,7.5 0 1,0 20,13.5 M19,3.8 V8.2 H14.6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15" />
                                </Button>
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,2,0,14">
                                <ItemsControl ItemsSource="{Binding LibraryGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GameSourceGroupViewModel}">
                                            <StackPanel Margin="0,2">
                                                <!-- Collapsible Group Header -->
                                                <Button Cursor="Hand"
                                                        Margin="8,1"
                                                        Padding="8,7"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        FocusVisualStyle="{x:Null}"
                                                        Command="{Binding ToggleExpandedCommand}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="GrpBd"
                                                                    CornerRadius="7"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Background="Transparent">
                                                                <DockPanel LastChildFill="False">
                                                                    <Path x:Name="Chevron"
                                                                          Data="M1,1 L5.5,5.5 L1,10"
                                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                                          StrokeThickness="1.5"
                                                                          StrokeStartLineCap="Round"
                                                                          StrokeEndLineCap="Round"
                                                                          StrokeLineJoin="Round"
                                                                          Width="7"
                                                                          Height="10"
                                                                          Stretch="Uniform"
                                                                          VerticalAlignment="Center"
                                                                          RenderTransformOrigin="0.5,0.5"
                                                                          DockPanel.Dock="Left">
                                                                        <Path.RenderTransform>
                                                                            <RotateTransform Angle="0" />
                                                                        </Path.RenderTransform>
                                                                    </Path>
                                                                    <TextBlock Text="{Binding HeaderTitle}"
                                                                               FontSize="13.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                                               Margin="8,0,0,0"
                                                                               VerticalAlignment="Center"
                                                                               DockPanel.Dock="Left" />
                                                                    <TextBlock Text="{Binding Count}"
                                                                               FontFamily="{StaticResource SpawnMonoFont}"
                                                                               FontSize="11.5"
                                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                                               VerticalAlignment="Center"
                                                                               DockPanel.Dock="Right" />
                                                                </DockPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="GrpBd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="90" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Group Children -->
                                                <ItemsControl ItemsSource="{Binding Items}"
                                                              ItemTemplate="{StaticResource SidebarGameItemTemplate}"
                                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty Sidebar Hint -->
                                <TextBlock Text="暂无已入库游戏"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="18,16,16,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AllGames.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Context B: Achievements Center Sidebar -->
                    <DockPanel Visibility="{Binding ActiveSection, Converter={StaticResource EqToVis}, ConverterParameter=Achievements}">
                        <Border DockPanel.Dock="Top"
                                Height="52"
                                Padding="16,0"
                                Background="Transparent"
                                MouseLeftButtonDown="OnTitleBarDragMouseDown">
                            <TextBlock Text="成就"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,2,0,14">
                                <!-- Recent Unlocks Overview Entry -->
                                <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                             GroupName="AchSidebarGroup"
                                             IsChecked="{Binding IsAchievementsOverviewSelected, Mode=OneWay}"
                                             Command="{Binding SelectAchievementsOverviewCommand}">
                                    <DockPanel LastChildFill="False">
                                        <Path Data="M12,3 L14.6,8.3 L20.5,9.1 L16.2,13.3 L17.2,19.1 L12,16.4 L6.8,19.1 L7.8,13.3 L3.5,9.1 L9.4,8.3 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.55"
                                              Stretch="Uniform"
                                              Width="15"
                                              Height="15"
                                              VerticalAlignment="Center"
                                              DockPanel.Dock="Left" />
                                        <TextBlock Text="最近解锁总览"
                                                   Margin="9,0,0,0"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Left" />
                                    </DockPanel>
                                </RadioButton>

                                <TextBlock Text="各游戏完成度"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="18,12,0,4" />

                                <ItemsControl ItemsSource="{Binding AllGames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GameListItemViewModel}">
                                            <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                                         GroupName="AchSidebarGroup"
                                                         Height="48"
                                                         Command="{Binding DataContext.SelectAchievementsGameItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         CommandParameter="{Binding}">
                                                <Grid Width="226">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="9" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="28"
                                                            Height="28"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource SubtleSurfaceBrush}"
                                                            ClipToBounds="True"
                                                            VerticalAlignment="Center">
                                                        <Image Source="{Binding SmallIcon}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="13"
                                                                       MaxWidth="122"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       DockPanel.Dock="Left" />
                                                            <TextBlock Text="{Binding AchievementRatioText}"
                                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       DockPanel.Dock="Right" />
                                                        </DockPanel>
                                                        <ProgressBar Minimum="0"
                                                                     Maximum="100"
                                                                     Value="{Binding CompletionPercent, Mode=OneWay}"
                                                                     Height="3.5"
                                                                     Margin="0,5,0,0"
                                                                     BorderThickness="0"
                                                                     Background="{DynamicResource DividerBrush}"
                                                                     Foreground="{DynamicResource AccentBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Context C: Settings Categories Sidebar (5 Clean Categories) -->
                    <DockPanel Visibility="{Binding ActiveSection, Converter={StaticResource EqToVis}, ConverterParameter=Settings}">
                        <Border DockPanel.Dock="Top"
                                Height="52"
                                Padding="10,0,16,0"
                                Background="Transparent"
                                MouseLeftButtonDown="OnTitleBarDragMouseDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SubtleIconButtonStyle}"
                                        ToolTip="返回上一视图"
                                        AutomationProperties.Name="返回"
                                        Command="{Binding ReturnFromSettingsCommand}"
                                        Margin="0,0,4,0">
                                    <Path Data="M15,4 L7,12 L15,20 M7.5,12 H20"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15" />
                                </Button>
                                <TextBlock Text="设置"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,4,0,0">
                            <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                         GroupName="SettingsCategoryGroup"
                                         IsChecked="{Binding Settings.SelectedCategory, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:SettingsCategory.GeneralAndLibrary}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,6 H21 M3,12 H21 M3,18 H21 M8,4 V8 M16,10 V14 M11,16 V20"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="常规与游戏库" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                         GroupName="SettingsCategoryGroup"
                                         IsChecked="{Binding Settings.SelectedCategory, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:SettingsCategory.AchievementAndSteamApi}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M7,4 H17 V8.5 C17,11.6 14.8,14 12,14.8 C9.2,14 7,11.6 7,8.5 Z M12,14.8 V18 M8.5,18 H15.5 M7,5.5 H4.5 V7.5 C4.5,9.4 5.6,10.5 7,10.5 M17,5.5 H19.5 V7.5 C19.5,9.4 18.4,10.5 17,10.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="成就与 Steam API" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                         GroupName="SettingsCategoryGroup"
                                         IsChecked="{Binding Settings.SelectedCategory, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:SettingsCategory.OverlayAndSound}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4,6 H20 V18 H4 Z M13,14 H18 V16.5 H13 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="弹窗外观与音效" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                         GroupName="SettingsCategoryGroup"
                                         IsChecked="{Binding Settings.SelectedCategory, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:SettingsCategory.AppearanceTheme}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,3 A9,9 0 1,0 21,12 A6.8,6.8 0 0,1 12,3 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="外观主题" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                         GroupName="SettingsCategoryGroup"
                                         IsChecked="{Binding Settings.SelectedCategory, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:SettingsCategory.AboutAndVersion}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,2 A10,10 0 1,0 22,12 A10,10 0 0,0 12,2 Z M8.5,12.2 L10.8,14.5 L15.8,9.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="关于与版本" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ================================================================== -->
            <!-- COLUMN 3: Right Main Panel (#FFFFFF Pure White / #14161A Dark)     -->
            <!-- ================================================================== -->
            <Grid Grid.Column="2" Background="{DynamicResource PageBackgroundBrush}">
                <Grid.RowDefinitions>
                    <!-- Fixed Top Bar (52px, does NOT scroll) -->
                    <RowDefinition Height="52" />
                    <!-- Optional non-intrusive status strip -->
                    <RowDefinition Height="Auto" />
                    <!-- Independent Viewport -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1. Fixed Non-Scrolling Top Bar + Capsule Quick Import + Caption Buttons -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Background="Transparent"
                        MouseLeftButtonDown="OnTitleBarDragMouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <!-- Safe reserve width for Minimize / Maximize / Close -->
                            <ColumnDefinition Width="148" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Narrow sidebar toggle + Page/Game Title (18px SemiBold) -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="24,0,16,0">
                            <Button Style="{StaticResource SubtleIconButtonStyle}"
                                    Margin="0,0,8,0"
                                    ToolTip="展开或收起侧栏"
                                    Command="{Binding ToggleNarrowSidebarCommand}"
                                    Visibility="{Binding IsNarrowWindow, Converter={StaticResource BoolToVis}}">
                                <Path Data="M3,6 H21 M3,12 H21 M3,18 H21"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      Stretch="Uniform"
                                      Width="16"
                                      Height="16" />
                            </Button>

                            <TextBlock Text="{Binding TopBarTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Right (before caption buttons): Full-Pill Capsule Quick Import Bar -->
                        <Border Grid.Column="1"
                                Height="36"
                                MinWidth="368"
                                MaxWidth="430"
                                CornerRadius="18"
                                Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                Padding="12,0,4,0"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Visibility="{Binding ShowQuickImportCapsule, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Folder Browse Icon Button -->
                                <Button Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTip="浏览选择游戏文件夹…"
                                        AutomationProperties.Name="浏览选择游戏文件夹"
                                        Command="{Binding BrowseAndImportFolderCommand}">
                                    <Path Data="M3,6.5 A1.5,1.5 0 0,1 4.5,5 H9 L11,7.2 H19.5 A1.5,1.5 0 0,1 21,8.7 V17.5 A1.5,1.5 0 0,1 19.5,19 H4.5 A1.5,1.5 0 0,1 3,17.5 Z"
                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                          StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15" />
                                </Button>

                                <!-- Input + Placeholder -->
                                <Grid Grid.Column="1" Margin="6,0,8,0">
                                    <TextBlock Text="输入游戏目录路径，或扫描 .local\games"
                                               FontSize="12.8"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding QuickImportPathText, Converter={StaticResource StrNotEmptyToVis}, ConverterParameter=Invert}" />
                                    <TextBox x:Name="QuickImportTextBox"
                                             Text="{Binding QuickImportPathText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             CaretBrush="{DynamicResource AccentBrush}"
                                             FontSize="12.8"
                                             VerticalContentAlignment="Center"
                                             PreviewKeyDown="OnQuickImportTextBoxPreviewKeyDown" />
                                </Grid>

                                <!-- Capsule Accent Primary Button "添加 / 扫描" -->
                                <Button Grid.Column="2"
                                        Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                        Height="28"
                                        Padding="14,0"
                                        FontSize="12.5"
                                        Content="添加 / 扫描"
                                        Command="{Binding QuickImportOrScanCommand}" />
                            </Grid>
                        </Border>

                        <!-- Top-Right Custom Window Caption Buttons (Minimize / Maximize / Close) -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                    ToolTip="最小化"
                                    AutomationProperties.Name="最小化"
                                    Click="OnMinimizeButtonClick">
                                <Path Data="M0,0 H10"
                                      Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.15" />
                            </Button>

                            <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                    ToolTip="最大化 / 还原"
                                    AutomationProperties.Name="最大化"
                                    Click="OnMaximizeRestoreButtonClick">
                                <Path x:Name="MaximizeGlyphPath"
                                      Data="M0,0 H9.5 V9.5 H0 Z"
                                      Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.1" />
                            </Button>

                            <Button Style="{StaticResource WindowCloseButtonStyle}"
                                    ToolTip="关闭"
                                    AutomationProperties.Name="关闭"
                                    Click="OnCloseButtonClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Non-Intrusive Feedback Strip -->
                <Border Grid.Row="1"
                        Background="{DynamicResource InfoBannerBackgroundBrush}"
                        BorderBrush="{DynamicResource InfoBannerBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="24,7"
                        Visibility="{Binding StatusBannerMessage, Converter={StaticResource StrNotEmptyToVis}}">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding StatusBannerMessage}"
                                   FontSize="12.8"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left" />
                        <Button Style="{StaticResource SubtleIconButtonStyle}"
                                Width="24"
                                Height="24"
                                ToolTip="关闭提示"
                                Command="{Binding DismissStatusBannerCommand}"
                                DockPanel.Dock="Right">
                            <Path Data="M0,0 L8,8 M8,0 L0,8"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.3"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Button>
                    </DockPanel>
                </Border>

                <!-- ============================================================== -->
                <!-- 3A. Library Empty / Unselected State                           -->
                <!-- ============================================================== -->
                <Grid Grid.Row="2"
                      Visibility="{Binding ShowLibraryEmptyState, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="480">
                        <TextBlock Text="在左侧选择一个游戏，或在右上角添加/扫描游戏目录"
                                   FontSize="14.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextAlignment="Center" />
                        <TextBlock Text="也可直接将单机游戏文件夹拖入窗口快速导入"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0" />

                        <!-- Gentle One-Click Prompt when .local\games has unimported titles -->
                        <Border CornerRadius="14"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                Padding="16,12"
                                Margin="0,22,0,0"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasUnimportedLocalGamesHint, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UnimportedLocalGamesHintText}"
                                           FontSize="13"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0" />
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="30"
                                        Padding="14,0"
                                        Content="一键扫描导入"
                                        Command="{Binding ScanDefaultLibraryCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============================================================== -->
                <!-- 3B. Selected Game Detail + [成就 | 游戏数据] Dual Sub-Tabs      -->
                <!-- ============================================================== -->
                <Grid Grid.Row="2"
                      Margin="32,20,32,0"
                      MaxWidth="1000"
                      Visibility="{Binding ShowLibraryGameWorkbench, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <!-- Game Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Sub-Tab Bar: 成就 (已解锁/总数) | 游戏数据 -->
                        <RowDefinition Height="Auto" />
                        <!-- Active Sub-Tab Viewport (* height preserves VirtualizingStackPanel!) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Restrained Clean Game Header -->
                    <Grid Grid.Row="0" DataContext="{Binding SelectedGame}" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left High-Res Cover / Icon -->
                        <Border Grid.Column="0"
                                Width="88"
                                Height="116"
                                CornerRadius="10"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="{Binding InitialsText}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding CoverImage, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                                <Image Source="{Binding CoverImage}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding CoverImage, Converter={StaticResource NullToVis}}" />
                            </Grid>
                        </Border>

                        <!-- Middle Metadata, Channel Status Dot & Tabular 3-State Playtime -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text=" · "
                                           FontSize="13"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PlatformFullLabel}"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <Border CornerRadius="5"
                                        Background="{DynamicResource RunningGreenSoftBrush}"
                                        Padding="7,2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AntiCheatBadgeText}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource RunningGreenBrush}" />
                                </Border>
                            </WrapPanel>

                            <!-- Achievement Capture Channel Status Dot -->
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0" VerticalAlignment="Center">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource RunningGreenBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChannelPendingPatch}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningAmberBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding EffectiveChannelStatusText}"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Tabular 3-State Playtime -->
                            <TextBlock Text="{Binding PlaytimeSummaryText}"
                                       FontFamily="{StaticResource SpawnMonoFont}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,7,0,0" />

                            <TextBlock Text="{Binding LastPlayedSummaryText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Right Action Area: SINGLE Primary Button + Floating ⋯ Popup Menu -->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <Button Command="{Binding DataContext.PrimaryLaunchOrStopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Height="38"
                                    Padding="22,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryCapsuleButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource RunningGreenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M1,1 L10,6.5 L1,12 Z"
                                          Fill="#FFFFFF"
                                          Width="9"
                                          Height="11"
                                          Stretch="Uniform"
                                          Margin="0,0,7,0"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding IsRunning, Converter={StaticResource InvBoolToVis}}" />
                                    <TextBlock Text="{Binding DataContext.PrimaryLaunchButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Floating ⋯ Menu (PlacementTarget.Tag bridges RootWindow.DataContext across PopupRoot!) -->
                            <Grid Margin="10,0,0,0" VerticalAlignment="Center">
                                <ToggleButton x:Name="GameHeaderMoreToggle"
                                              Style="{StaticResource MorePopupToggleStyle}"
                                              Tag="{Binding DataContext, ElementName=RootWindow}"
                                              Width="38"
                                              Height="38"
                                              ToolTip="更多操作"
                                              AutomationProperties.Name="更多游戏操作" />
                                <Popup IsOpen="{Binding IsChecked, ElementName=GameHeaderMoreToggle, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=GameHeaderMoreToggle}"
                                       DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                       Placement="Bottom"
                                       HorizontalOffset="-230"
                                       VerticalOffset="6"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Width="272"
                                            Margin="10"
                                            Padding="6"
                                            CornerRadius="12"
                                            Background="{DynamicResource FloatingMenuBackgroundBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" Color="#000000" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                    Content="打开游戏所在文件夹"
                                                    Click="OnAnyPopupMenuItemClick"
                                                    Command="{Binding OpenSelectedGameFolderCommand}" />
                                            <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                    Content="管理 / 清理游戏数据"
                                                    Click="OnAnyPopupMenuItemClick"
                                                    Command="{Binding OpenGameDataSubTabCommand}" />
                                            <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                    Content="刷新中文成就元数据"
                                                    Click="OnAnyPopupMenuItemClick"
                                                    Command="{Binding RefreshChineseSchemaCommand}" />
                                            <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                    Content="测试游戏内跳杯弹窗"
                                                    Click="OnAnyPopupMenuItemClick"
                                                    Command="{Binding TestInGameOverlayToastCommand}" />
                                            <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                    Content="一键切换为 gbe_fork 增强成就补丁"
                                                    Click="OnAnyPopupMenuItemClick"
                                                    Command="{Binding ActivateGbeForkPatchCommand}"
                                                    Visibility="{Binding CanActivateGbeForkOnSelected, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                    Content="还原原始 DLL"
                                                    Click="OnAnyPopupMenuItemClick"
                                                    Command="{Binding RestoreOriginalDllCommand}"
                                                    Visibility="{Binding CanRestoreDllOnSelected, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                    Content="重新扫描本地成就记录"
                                                    Click="OnAnyPopupMenuItemClick"
                                                    Command="{Binding RescanLocalAchievementsCommand}" />
                                            <Border Height="1"
                                                    Background="{DynamicResource DividerBrush}"
                                                    Margin="6,5" />
                                            <Button Style="{StaticResource DangerMenuItemButtonStyle}"
                                                    Content="从游戏库移除"
                                                    Click="OnAnyPopupMenuItemClick"
                                                    Command="{Binding RemoveSelectedGameFromLibraryCommand}" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Dual Sub-Tab Strip: [成就 (已解锁/总数)] | [游戏数据] -->
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                         GroupName="GameDetailPrimarySubTabs"
                                         FontSize="14"
                                         Padding="4,9"
                                         Margin="0,0,26,0"
                                         Content="{Binding AchievementsSubTabHeaderText}"
                                         IsChecked="{Binding SelectedGameSubTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:GameDetailSubTab.Achievements}}" />
                            <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                         GroupName="GameDetailPrimarySubTabs"
                                         FontSize="14"
                                         Padding="4,9"
                                         Content="游戏数据"
                                         IsChecked="{Binding SelectedGameSubTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:GameDetailSubTab.GameData}}" />
                        </StackPanel>
                    </Border>

                    <!-- Row 2A: Sub-Tab "成就 (已解锁/总数)" (Virtualized Recycling List!) -->
                    <ContentControl Grid.Row="2"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource AchievementManagementListTemplate}"
                                    Visibility="{Binding ShowGameAchievementsSubPanel, Converter={StaticResource BoolToVis}}" />

                    <!-- Row 2B: Sub-Tab "游戏数据" (PCGamingWiki + Engine + Reversible Cleanup) -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding ShowGameDataSubPanel, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Game Data Action Toolbar (Single Primary Button + Undo Restore + Reset Checkbox) -->
                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,12">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                            Height="32"
                                            Padding="13,0"
                                            Content="刷新 / 同步 PCGamingWiki"
                                            Command="{Binding RefreshGameDataOnlineCommand}" />
                                    <Button Style="{StaticResource SubtleIconButtonStyle}"
                                            Width="Auto"
                                            Height="28"
                                            Margin="10,0,0,0"
                                            Padding="8,0"
                                            Content="全选"
                                            Command="{Binding SelectAllSafeGameDataCommand}" />
                                    <Button Style="{StaticResource SubtleIconButtonStyle}"
                                            Width="Auto"
                                            Height="28"
                                            Margin="2,0,14,0"
                                            Padding="8,0"
                                            Content="取消全选"
                                            Command="{Binding ClearGameDataSelectionCommand}" />
                                    <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                              Content="同时重置 SPAWN 成就进度与游玩时长"
                                              IsChecked="{Binding ResetSpawnStateOnClean, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                            Height="34"
                                            Margin="0,0,10,0"
                                            Content="恢复上次清理"
                                            ToolTip="{Binding UndoSnapshotToolTipText}"
                                            Command="{Binding RestoreLastCleanupCommand}"
                                            Visibility="{Binding HasUndoSnapshot, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                            Height="34"
                                            Content="{Binding CleanSelectedButtonText}"
                                            Command="{Binding CleanSelectedGameDataCommand}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Categorized Game Data Paths & Registry Keys -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,8,4,28">
                                <ItemsControl ItemsSource="{Binding GameDataGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GameDataCategoryGroupViewModel}">
                                            <StackPanel Margin="0,12,0,4">
                                                <!-- Category Section Header -->
                                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding CategoryTitle}"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               DockPanel.Dock="Left" />
                                                    <TextBlock Text="{Binding SummaryCountText}"
                                                               FontFamily="{StaticResource SpawnMonoFont}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               DockPanel.Dock="Right" />
                                                </DockPanel>

                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:GameDataItemViewModel}">
                                                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                                                    BorderThickness="0,0,0,1"
                                                                    Padding="2,10">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="26" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <CheckBox Grid.Column="0"
                                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                              IsEnabled="{Binding IsSafeToClean}"
                                                                              VerticalAlignment="Center" />

                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,12,0">
                                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Border CornerRadius="4"
                                                                                    Background="{DynamicResource SubtleSurfaceBrush}"
                                                                                    BorderBrush="{DynamicResource DividerBrush}"
                                                                                    BorderThickness="1"
                                                                                    Padding="6,1"
                                                                                    Margin="0,0,8,0"
                                                                                    VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding SourceBadgeText}"
                                                                                           FontSize="11"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                            </Border>
                                                                            <TextBlock Text="{Binding PathOrRegistryKey}"
                                                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                                                       FontSize="12.5"
                                                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                                                       TextWrapping="Wrap"
                                                                                       VerticalAlignment="Center" />
                                                                        </WrapPanel>
                                                                        <TextBlock Text="{Binding Description}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                   Margin="0,3,0,0"
                                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                                                        <TextBlock Text="{Binding SafetyNote}"
                                                                                   FontSize="11.5"
                                                                                   Foreground="{DynamicResource WarningAmberBrush}"
                                                                                   Margin="0,2,0,0"
                                                                                   Visibility="{Binding HasSafetyNote, Converter={StaticResource BoolToVis}}" />
                                                                    </StackPanel>

                                                                    <!-- Existence Dot + File Count / Byte Size -->
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Ellipse Width="7"
                                                                                 Height="7"
                                                                                 Margin="0,0,6,0"
                                                                                 VerticalAlignment="Center">
                                                                            <Ellipse.Style>
                                                                                <Style TargetType="Ellipse">
                                                                                    <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Exists}" Value="True">
                                                                                            <Setter Property="Fill" Value="{DynamicResource RunningGreenBrush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Ellipse.Style>
                                                                        </Ellipse>
                                                                        <TextBlock Text="{Binding StatusSummaryText}"
                                                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>

                                                                    <!-- Row Quick Actions: Open Folder / Copy Path -->
                                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                                                Height="26"
                                                                                Padding="10,0"
                                                                                FontSize="11.5"
                                                                                Margin="0,0,6,0"
                                                                                Content="打开目录"
                                                                                Command="{Binding OpenLocationCommand}"
                                                                                Visibility="{Binding CanOpenDirectory, Converter={StaticResource BoolToVis}}" />
                                                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                                                Height="26"
                                                                                Padding="10,0"
                                                                                FontSize="11.5"
                                                                                Content="复制路径"
                                                                                Command="{Binding CopyPathCommand}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="正在探测该游戏的存档、模拟器成就文件与注册表路径…"
                                           FontSize="13"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,32,0,0"
                                           Visibility="{Binding IsInspectingGameData, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ============================================================== -->
                <!-- 3C. Achievements Center: Overview & Recent Unlocks Timeline    -->
                <!-- ============================================================== -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding ShowAchievementsOverviewPanel, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="32,24,32,32" MaxWidth="920">
                        <Border BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,0,0,20">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <StackPanel Margin="0,0,36,0">
                                        <TextBlock Text="已解锁总成就" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding GlobalTotalUnlockedCount}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="24"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text=" / " FontSize="15" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Bottom" Margin="2,0,2,3" />
                                            <TextBlock Text="{Binding GlobalTotalAchievementCount}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="15"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,0,3" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,36,0">
                                        <TextBlock Text="100% 全成就游戏" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding GlobalPlatinumGamesCount}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="稀有成就 (&lt;10%)" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding GlobalRareUnlockedCount}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource RareBadgeForegroundBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        DockPanel.Dock="Right"
                                        VerticalAlignment="Center"
                                        Content="预览当前跳杯弹窗"
                                        Command="{Binding Settings.TriggerTestToastCommand}" />
                            </DockPanel>
                        </Border>

                        <TextBlock Text="最近解锁时间线"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,22,0,8" />

                        <ItemsControl ItemsSource="{Binding RecentUnlocks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RecentUnlockItemViewModel}">
                                    <Border BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="52"
                                                    Height="52"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource SubtleSurfaceBrush}"
                                                    ClipToBounds="True">
                                                <Image Source="{Binding IconImage}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Text=" · " FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding GameTitle}" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                                    <Border CornerRadius="4"
                                                            Background="{DynamicResource RareBadgeBackgroundBrush}"
                                                            Padding="6,1"
                                                            Margin="8,0,0,0"
                                                            Visibility="{Binding IsRare, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding RareBadgeText}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource RareBadgeForegroundBrush}" />
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding UnlockedTimeText}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="尚无最近解锁记录。启动单机游戏达成成就后，实时跳杯记录会显示在这里。"
                                   FontSize="13.5"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,18,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentUnlocks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================================================== -->
                <!-- 3D. Achievements Center: Single Game Selected (Virtualized!)   -->
                <!-- ============================================================== -->
                <Grid Grid.Row="2"
                      Margin="32,16,32,0"
                      MaxWidth="980"
                      Visibility="{Binding ShowAchievementsSingleGamePanel, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,2,0,2">
                        <TextBlock Text="{Binding SelectedAchievementsGame.EffectiveChannelStatusText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left" />
                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Content="在游戏库中管理与启动"
                                Command="{Binding JumpToGameInLibraryCommand}"
                                CommandParameter="{Binding SelectedAchievementsGame.GameId}"
                                DockPanel.Dock="Right" />
                    </DockPanel>
                    <ContentControl Grid.Row="1"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource AchievementManagementListTemplate}" />
                </Grid>

                <!-- ============================================================== -->
                <!-- 3E. Settings Panel (MaxWidth 860px, Hairline Separated, Clean) -->
                <!-- ============================================================== -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding ShowSettingsPanel, Converter={StaticResource BoolToVis}}">
                    <StackPanel DataContext="{Binding Settings}"
                                Margin="32,20,32,36"
                                MaxWidth="860"
                                HorizontalAlignment="Left"
                                Width="800">

                        <!-- Category 1: General & Game Library -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqToVis}, ConverterParameter=GeneralAndLibrary}">
                            <!-- Scan Directories -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,12,0,18">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="默认游戏库扫描路径" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="扫描时自动识别 GOG 离线版（goggame-*.info）与嵌套目录 Steamrip 免安装游戏"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Content="添加目录"
                                                    Command="{Binding AddScanDirectoryCommand}"
                                                    Margin="0,0,10,0" />
                                            <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                                    Content="立即扫描全部"
                                                    Command="{Binding ScanAllConfiguredDirectoriesCommand}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding ScanDirectories}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ScanDirectoryEntry}">
                                                <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                                        CornerRadius="8"
                                                        Padding="12,8"
                                                        Margin="0,4,0,0">
                                                    <DockPanel LastChildFill="False">
                                                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Path}"
                                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                                       FontSize="12.5" />
                                                            <TextBlock Text="{Binding SourceNote}"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                                Height="26"
                                                                Padding="10,0"
                                                                FontSize="12"
                                                                Content="移除"
                                                                DockPanel.Dock="Right"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.RemoveScanDirectoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVis}}" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Close Window Behavior (System Tray) -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="关闭窗口时最小化到系统托盘（推荐）" FontSize="14" />
                                        <TextBlock Text="保持后台离线成就监听与游戏内跳杯运行；右键托盘图标可随时完全退出"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                              IsChecked="{Binding CloseWindowToTray, Mode=TwoWay}"
                                              DockPanel.Dock="Right"
                                              VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <!-- AFK Idle Timeout -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="挂机（AFK）判定静默时长" FontSize="14" />
                                        <TextBlock Text="游戏在前台但键鼠与手柄连续无输入超过该时长时，自动归入挂机时长"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ComboBox DockPanel.Dock="Right"
                                              Width="168"
                                              Height="32"
                                              VerticalContentAlignment="Center"
                                              ItemsSource="{Binding AfkTimeoutOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedAfkTimeoutSec, Mode=TwoWay}" />
                                </DockPanel>
                            </Border>

                            <!-- Anti-Cheat Guard Status -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Anti-Cheat Guard 物理隔离状态"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left" />
                                    <TextBlock Text="{Binding AntiCheatStatusSummary}"
                                               FontSize="13"
                                               Foreground="{DynamicResource RunningGreenBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Right" />
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- Category 2: Achievements & Steam Web API -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqToVis}, ConverterParameter=AchievementAndSteamApi}">
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,14,0,18">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="Steam Web API Key 当前状态"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Left" />
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Fill="{DynamicResource RunningGreenBrush}"
                                                     Margin="0,0,7,0"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding IsSteamApiKeyConfigured, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding SteamApiKeyStatusText}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBlock Text="用于加速拉取官方简体中文成就名称与图标。自定义密钥仅保存在本机并按当前 Windows 用户 DPAPI 加密，绝不写入明文日志。"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,8,0,12"
                                               TextWrapping="Wrap" />

                                    <DockPanel LastChildFill="True">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="10,0,0,0">
                                            <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                                    Height="34"
                                                    Content="加密保存密钥"
                                                    Command="{Binding SaveCustomSteamApiKeyCommand}" />
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Height="34"
                                                    Margin="8,0,0,0"
                                                    Content="清除自定义"
                                                    Command="{Binding ClearCustomSteamApiKeyCommand}" />
                                        </StackPanel>

                                        <Border Height="34"
                                                CornerRadius="17"
                                                Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1"
                                                Padding="14,0">
                                            <Grid>
                                                <TextBlock Text="粘贴 32 位 Steam Web API Key 覆盖默认配置…"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding CustomSteamApiKeyInput, Converter={StaticResource StrNotEmptyToVis}, ConverterParameter=Invert}" />
                                                <TextBox Text="{Binding CustomSteamApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                                         CaretBrush="{DynamicResource AccentBrush}"
                                                         FontFamily="{StaticResource SpawnMonoFont}"
                                                         FontSize="12.5"
                                                         VerticalContentAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="默认显示隐藏成就达成条件（剧透开关）" FontSize="14" />
                                        <TextBlock Text="关闭时，未解锁的隐藏成就默认折叠条件，点击单条时再展开"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                              IsChecked="{Binding GlobalRevealSpoilers, Mode=TwoWay}"
                                              DockPanel.Dock="Right"
                                              VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- Category 3: Overlay Theme, Position & Sound -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqToVis}, ConverterParameter=OverlayAndSound}">
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,14">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="游戏内跳杯弹窗样式" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="选择 PS5 奖杯主题时，集齐最后一项达成 100% 将自动连发「白金奖杯」庆典弹窗"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ComboBox DockPanel.Dock="Right"
                                              Width="248"
                                              Height="32"
                                              VerticalContentAlignment="Center"
                                              ItemsSource="{Binding OverlayThemeOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedOverlayTheme, Mode=TwoWay}" />
                                </DockPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="弹窗屏幕四角位置"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left" />
                                    <ComboBox DockPanel.Dock="Right"
                                              Width="188"
                                              Height="32"
                                              VerticalContentAlignment="Center"
                                              ItemsSource="{Binding OverlayPositionOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedOverlayPosition, Mode=TwoWay}" />
                                </DockPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="解锁提示音效" FontSize="14" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                                <Ellipse Width="7"
                                                         Height="7"
                                                         Fill="{DynamicResource RunningGreenBrush}"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding IsSteamSoundDetected, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding SteamSoundStatusText}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ComboBox DockPanel.Dock="Right"
                                                  Width="248"
                                                  Height="32"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding OverlaySoundPresetOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedOverlaySoundPreset, Mode=TwoWay}" />
                                    </DockPanel>

                                    <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                            CornerRadius="8"
                                            Padding="12,9"
                                            Margin="0,12,0,0"
                                            Visibility="{Binding ShowCustomWavPicker, Converter={StaticResource BoolToVis}}">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{Binding CustomWavDisplayStatus}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       VerticalAlignment="Center"
                                                       DockPanel.Dock="Left" />
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Height="28"
                                                    Padding="12,0"
                                                    FontSize="12.5"
                                                    Content="选择 .wav 文件"
                                                    DockPanel.Dock="Right"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding BrowseCustomOverlayWavCommand}" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="420">
                                        <TextBlock Text="弹窗音频输出设备" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AudioRoutingStatusText}"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <ComboBox Width="288"
                                                  Height="32"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding AudioOutputDeviceOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedAudioOutputDeviceId, Mode=TwoWay}" />
                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Height="32"
                                                Padding="12,0"
                                                Margin="8,0,0,0"
                                                Content="刷新设备"
                                                Command="{Binding RefreshAudioOutputDevicesCommand}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="解锁提示音音量" FontSize="14" />
                                        <TextBlock Text="经 WASAPI 共享模式按声卡原生采样率三次插值混音播放，设为 0% 或勾选静音时零发声"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                                  Content="静音"
                                                  IsChecked="{Binding OverlayMuteSound, Mode=TwoWay}"
                                                  Margin="0,0,16,0" />
                                        <Slider Width="150"
                                                Minimum="0"
                                                Maximum="100"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="False"
                                                Value="{Binding OverlayVolumePercent, Mode=TwoWay}"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding OverlayVolumeDisplayText}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12.5"
                                                   Width="62"
                                                   TextAlignment="Right"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Padding="0,20,0,0">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="实时跳杯效果实测" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="验证 WS_EX_NOACTIVATE 穿透置顶窗口不打断前台输入焦点"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Content="预览 PS5 白金连发"
                                                Command="{Binding TriggerPlatinumChainTestCommand}"
                                                Margin="0,0,10,0" />
                                        <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                                Content="立即弹出测试成就"
                                                Command="{Binding TriggerTestToastCommand}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- Category 4: Appearance Theme (Light Default / Dark Geek) -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqToVis}, ConverterParameter=AppearanceTheme}">
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,14,0,20">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="界面色彩主题" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="默认采用清透浅色（#F7F7F7 侧栏 + #FFFFFF 主面板），支持一键实时切换极客深色"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                                     GroupName="UiThemeRadioGroup"
                                                     Padding="16,0"
                                                     Margin="0,0,8,0"
                                                     Content="☀ 清透浅色（默认）"
                                                     IsChecked="{Binding SelectedUiTheme, Converter={StaticResource EqToBool}, ConverterParameter={x:Static contracts:SpawnUiThemeKind.Light}}" />
                                        <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                                     GroupName="UiThemeRadioGroup"
                                                     Padding="16,0"
                                                     Content="☾ 极客深色"
                                                     IsChecked="{Binding SelectedUiTheme, Converter={StaticResource EqToBool}, ConverterParameter={x:Static contracts:SpawnUiThemeKind.Dark}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- Category 5: About & Build Version -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqToVis}, ConverterParameter=AboutAndVersion}">
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,14,0,18">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BuildProductName}"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                            <Border CornerRadius="5"
                                                    Background="{DynamicResource WarningAmberSoftBrush}"
                                                    Padding="7,2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsDevOrSourceBuild, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding BuildChannelBadgeText}"
                                                           FontFamily="{StaticResource SpawnMonoFont}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource WarningAmberBrush}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ChannelDisplayName}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>

                                    <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                            Content="复制诊断摘要"
                                            DockPanel.Dock="Right"
                                            VerticalAlignment="Center"
                                            Command="{Binding CopyVersionDiagnosticsCommand}" />
                                </DockPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="版本号与构建提交" FontSize="14" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BuildVersionText}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text=" · Commit " FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BuildCommitShaText}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text=" · " FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BuildTimeUtcText}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="应用安装目录" FontSize="14" />
                                        <TextBlock Text="{Binding InstallDirectoryPath}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                            Content="打开安装目录"
                                            DockPanel.Dock="Right"
                                            VerticalAlignment="Center"
                                            Command="{Binding OpenInstallDirectoryCommand}" />
                                </DockPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="通道物理隔离数据目录" FontSize="14" />
                                        <TextBlock Text="{Binding DataRootPath}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                            Content="打开数据目录"
                                            DockPanel.Dock="Right"
                                            VerticalAlignment="Center"
                                            Command="{Binding OpenDataDirectoryCommand}" />
                                </DockPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,16">
                                <StackPanel>
                                    <TextBlock Text="开发工作区桥接路径 (dev-workspace.json)" FontSize="14" />
                                    <TextBlock Text="{Binding WorkspaceBridgeSummaryText}"
                                               FontFamily="{StaticResource SpawnMonoFont}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Drag & Drop Visual Overlay -->
                <Border x:Name="DragDropOverlay"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Margin="16"
                        CornerRadius="16"
                        Background="#E8F0F7FF"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="2"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="松开鼠标导入单机游戏目录"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="将自动提取离线封面资产并同步中文成就进度"
                                   FontSize="13"
                                   Foreground="#4B5563"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
