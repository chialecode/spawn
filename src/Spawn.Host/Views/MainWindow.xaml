                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Fixed Top Overview Row + IME-Guarded Search Box -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,2,0,4">
