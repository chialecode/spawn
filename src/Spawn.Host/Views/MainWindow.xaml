                                                          Stretch="Uniform"
                                                          Width="14.5"
                                                          Height="14.5"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock x:Name="OverviewText"
                                                               Text="全部修改器总览"
                                                               FontSize="13.5"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               Margin="9,0,0,0"
                                                               VerticalAlignment="Center" />
