<Window x:Class="Spawn.Host.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Spawn.Host.Converters"
        xmlns:vm="clr-namespace:Spawn.Host.ViewModels"
        xmlns:savesVm="clr-namespace:Spawn.Host.ViewModels.Saves"
        xmlns:savesViews="clr-namespace:Spawn.Host.Views.Saves"
        xmlns:contracts="clr-namespace:Spawn.Contracts;assembly=Spawn.Contracts"
        Title="SPAWN"
        Width="1220"
        Height="780"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource SpawnUiFont}"
        Typography.NumeralAlignment="Tabular"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop"
        SizeChanged="OnWindowSizeChanged"
        StateChanged="OnWindowStateChanged"
        Closing="OnWindowClosing"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="1"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:EqualityToVisibilityConverter x:Key="EqToVis" />
        <conv:EqualityToBooleanConverter x:Key="EqToBool" />

        <!-- Subtle ⋯ ToggleButton Style for Floating Menus -->
        <Style x:Key="MorePopupToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource CapsuleInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                CornerRadius="18"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Ellipse Width="3.4" Height="3.4" Fill="{TemplateBinding Foreground}" Margin="1.4,0" />
                                <Ellipse Width="3.4" Height="3.4" Fill="{TemplateBinding Foreground}" Margin="1.4,0" />
                                <Ellipse Width="3.4" Height="3.4" Fill="{TemplateBinding Foreground}" Margin="1.4,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Row ⋯ ToggleButton Style -->
        <Style x:Key="RowMorePopupToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource MorePopupToggleStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Sidebar Game Row DataTemplate -->
        <DataTemplate x:Key="SidebarGameItemTemplate" DataType="{x:Type vm:GameListItemViewModel}">
            <Button Cursor="Hand"
                    Margin="8,1.5"
                    Padding="0"
                    FocusVisualStyle="{x:Null}"
                    Command="{Binding DataContext.SelectLibraryGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBd"
                                Height="40"
                                CornerRadius="8"
                                Padding="9,0,10,0"
                                Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Game rounded icon + green active ring -->
                                <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                                    <Border CornerRadius="6"
                                            Background="{DynamicResource SubtleSurfaceBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding InitialsText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding SmallIcon, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                                            <Image Source="{Binding SmallIcon}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding SmallIcon, Converter={StaticResource NullToVis}}" />
                                        </Grid>
                                    </Border>
                                    <Border CornerRadius="7"
                                            Margin="-2"
                                            BorderBrush="{DynamicResource RunningGreenBrush}"
                                            BorderThickness="1.8"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                </Grid>

                                <!-- Game Title -->
                                <TextBlock x:Name="TitleTxt"
                                           Grid.Column="2"
                                           Text="{Binding Title}"
                                           FontSize="13.5"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- Source / Running Tag -->
                                <TextBlock x:Name="TagTxt"
                                           Grid.Column="3"
                                           Text="{Binding SidebarRightTag}"
                                           FontSize="11.5"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter TargetName="TagTxt" Property="Foreground" Value="{DynamicResource RunningGreenBrush}" />
                                <Setter TargetName="TagTxt" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                <Setter TargetName="TitleTxt" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="TitleTxt" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Saves Contextual Sidebar Game Row DataTemplate -->
        <DataTemplate x:Key="SaveSidebarGameItemTemplate" DataType="{x:Type savesVm:SaveSidebarGameItemViewModel}">
            <Button Cursor="Hand"
                    Margin="8,1.5"
                    Padding="0"
                    FocusVisualStyle="{x:Null}"
                    Command="{Binding DataContext.SelectSaveSidebarGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBd"
                                Height="48"
                                CornerRadius="8"
                                Padding="9,0,9,0"
                                Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="9" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                                    <Border CornerRadius="6"
                                            Background="{DynamicResource SubtleSurfaceBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding InitialsText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding SmallIcon, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                                            <Image Source="{Binding SmallIcon}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding SmallIcon, Converter={StaticResource NullToVis}}" />
                                        </Grid>
                                    </Border>
                                    <Border CornerRadius="7"
                                            Margin="-2"
                                            BorderBrush="{DynamicResource RunningGreenBrush}"
                                            BorderThickness="1.8"
                                            Visibility="{Binding IsStatusWatching, Converter={StaticResource BoolToVis}}" />
                                </Grid>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right"
                                                CornerRadius="4"
                                                Padding="5,1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStatusConflict}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource WarningAmberSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsStatusWatching}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource RunningGreenSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsStatusHasSaves}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusPillText}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStatusConflict}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningAmberBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsStatusWatching}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource RunningGreenBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsStatusHasSaves}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock x:Name="TitleTxt"
                                                   Text="{Binding Title}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding SubtitleText}"
                                               FontFamily="{StaticResource SpawnMonoFont}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                <Setter TargetName="TitleTxt" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="TitleTxt" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Trainers Contextual Sidebar Game Row DataTemplate -->
        <DataTemplate x:Key="TrainerSidebarGameItemTemplate" DataType="{x:Type vm:TrainerSidebarGameItemViewModel}">
            <Button Cursor="Hand"
                    Margin="8,1.5"
                    Padding="0"
                    FocusVisualStyle="{x:Null}"
                    Command="{Binding DataContext.SelectTrainerSidebarGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBd"
                                Height="48"
                                CornerRadius="8"
                                Padding="9,0,9,0"
                                Background="Transparent"
                                Opacity="{Binding RowOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="9" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Game rounded icon + emerald green ring when trainer is actively running -->
                                <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                                    <Border CornerRadius="6"
                                            Background="{DynamicResource SubtleSurfaceBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding InitialsText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding SmallIcon, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                                            <Image Source="{Binding SmallIcon}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding SmallIcon, Converter={StaticResource NullToVis}}" />
                                        </Grid>
                                    </Border>
                                    <Border CornerRadius="7"
                                            Margin="-2"
                                            BorderBrush="{DynamicResource RunningGreenBrush}"
                                            BorderThickness="1.8"
                                            Visibility="{Binding HasRunningTrainer, Converter={StaticResource BoolToVis}}" />
                                </Grid>

                                <!-- Title + Status Pill + Subtitle -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <DockPanel LastChildFill="True">
                                        <Border x:Name="PillBd"
                                                DockPanel.Dock="Right"
                                                CornerRadius="4"
                                                Padding="5,1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStatusRunning}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource RunningGreenSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsStatusBound}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsStatusOfflineReady}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Tier0BadgeBackgroundBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsStatusHybridPending}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource WarningAmberSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsStatusLocked}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Tier23BadgeBackgroundBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusPillText}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStatusRunning}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource RunningGreenBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsStatusBound}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsStatusOfflineReady}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Tier0BadgeForegroundBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsStatusHybridPending}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningAmberBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsStatusLocked}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Tier23BadgeForegroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock x:Name="TitleTxt"
                                                   Text="{Binding Title}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding SubtitleText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                <Setter TargetName="RowBd" Property="Opacity" Value="1.0" />
                                <Setter TargetName="TitleTxt" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="TitleTxt" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- High-Performance Recycling Virtualized Achievement List Template (220+ items smooth!) -->
        <DataTemplate x:Key="AchievementManagementListTemplate" DataType="{x:Type vm:MainWindowViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Overall Progress Bar & Ratio -->
                <Grid Grid.Row="0" Margin="0,14,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="6" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <TextBlock Text="成就收集总进度"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding CurrentGameProgressSummaryText}"
                                   FontFamily="{StaticResource SpawnMonoFont}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   DockPanel.Dock="Right" />
                    </DockPanel>
                    <ProgressBar Grid.Row="2"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding CurrentGameCompletionPercent, Mode=OneWay}"
                                 Height="6"
                                 BorderThickness="0"
                                 Background="{DynamicResource SubtleSurfaceBrush}"
                                 Foreground="{DynamicResource AccentBrush}">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border x:Name="PART_Track"
                                        CornerRadius="3"
                                        Background="{TemplateBinding Background}"
                                        ClipToBounds="True">
                                    <Border x:Name="PART_Indicator"
                                            CornerRadius="3"
                                            HorizontalAlignment="Left"
                                            Background="{TemplateBinding Foreground}" />
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </Grid>

                <!-- Filter Tabs + Spoiler Switch + Search Filter -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="0,2,0,0">
                    <DockPanel LastChildFill="False">
                        <!-- Filter Tabs -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Bottom">
                            <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                         GroupName="AchFilterTabs"
                                         Content="全部"
                                         IsChecked="{Binding SelectedAchievementTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:AchievementFilterTab.All}}" />
                            <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                         GroupName="AchFilterTabs"
                                         Content="已解锁"
                                         IsChecked="{Binding SelectedAchievementTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:AchievementFilterTab.Unlocked}}" />
                            <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                         GroupName="AchFilterTabs"
                                         Content="未解锁"
                                         IsChecked="{Binding SelectedAchievementTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:AchievementFilterTab.Locked}}" />
                            <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                         GroupName="AchFilterTabs"
                                         Content="隐藏成就"
                                         IsChecked="{Binding SelectedAchievementTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:AchievementFilterTab.Hidden}}" />
                        </StackPanel>

                        <!-- Search Box + Spoiler Toggle -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,0,6">
                            <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                      Content="显示隐藏成就剧透"
                                      IsChecked="{Binding RevealHiddenSpoilers, Mode=TwoWay}"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center" />

                            <Border Width="204"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Data="M6.5,1 A5.5,5.5 0 1,0 6.5,12 A5.5,5.5 0 1,0 6.5,1 M10.6,10.6 L14.2,14.2"
                                          Stroke="{DynamicResource MutedTextBrush}"
                                          StrokeThickness="1.4"
                                          Stretch="Uniform"
                                          Width="13"
                                          Height="13"
                                          VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="搜索成就名称或条件…"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding AchievementSearchText, Converter={StaticResource StrNotEmptyToVis}, ConverterParameter=Invert}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding AchievementSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             CaretBrush="{DynamicResource AccentBrush}"
                                             FontSize="12.5"
                                             VerticalContentAlignment="Center"
                                             Margin="4,0,0,0" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Virtualized Recycling Achievement ListBox (Constrained * height enables true container recycling!) -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding FilteredAchievements}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,0,4,20"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.CacheLength="1,1"
                         VirtualizingPanel.CacheLengthUnit="Page">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True"
                                                    VirtualizationMode="Recycling" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AchievementRowViewModel}">
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 56x56 Color / Grayscale Achievement Icon -->
                                    <Border Grid.Column="0"
                                            Width="56"
                                            Height="56"
                                            CornerRadius="8"
                                            Background="{DynamicResource SubtleSurfaceBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Path Data="M12,3 L14.6,8.3 L20.5,9.1 L16.2,13.3 L17.2,19.1 L12,16.4 L6.8,19.1 L7.8,13.3 L3.5,9.1 L9.4,8.3 Z"
                                                  Stroke="{DynamicResource MutedTextBrush}"
                                                  StrokeThickness="1.5"
                                                  Stretch="Uniform"
                                                  Width="22"
                                                  Height="22"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding IconImage, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                                            <Image Source="{Binding IconImage}"
                                                   Opacity="{Binding IconOpacity}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding IconImage, Converter={StaticResource NullToVis}}" />
                                        </Grid>
                                    </Border>

                                    <!-- Name, Rare Badge, Global Rate & Spoiler-Aware Description -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center" />

                                            <!-- Rare (<10%) Badge -->
                                            <Border CornerRadius="4"
                                                    Background="{DynamicResource RareBadgeBackgroundBrush}"
                                                    BorderBrush="{DynamicResource RareBadgeBorderBrush}"
                                                    BorderThickness="1"
                                                    Padding="6,1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsRare, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding RareBadgeText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource RareBadgeForegroundBrush}" />
                                            </Border>

                                            <!-- Hidden Tag -->
                                            <TextBlock Text="· 隐藏"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}" />

                                            <!-- Global Percent -->
                                            <TextBlock Text="{Binding GlobalPercentText}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasGlobalPercent, Converter={StaticResource BoolToVis}}" />
                                        </WrapPanel>

                                        <!-- Normal / Revealed Description -->
                                        <TextBlock Text="{Binding EffectiveDescription}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,4,12,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding CanClickToRevealSpoiler, Converter={StaticResource InvBoolToVis}}" />

                                        <!-- Hidden Spoiler Click-to-Reveal Chip -->
                                        <Button Command="{Binding RevealRowSpoilerCommand}"
                                                Cursor="Hand"
                                                HorizontalAlignment="Left"
                                                Margin="0,4,0,0"
                                                FocusVisualStyle="{x:Null}"
                                                Visibility="{Binding CanClickToRevealSpoiler, Converter={StaticResource BoolToVis}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Chip"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource SubtleSurfaceBrush}"
                                                            Padding="8,3">
                                                        <TextBlock Text="隐藏成就 · 点击展开查看条件"
                                                                   FontSize="12.5"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>

                                    <!-- Unlock Timestamp / Status -->
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Fill="{DynamicResource RunningGreenBrush}"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding UnlockedStatusText}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Per-Achievement Floating ⋯ Menu -->
                                    <Grid Grid.Column="5" VerticalAlignment="Center">
                                        <ToggleButton x:Name="RowMoreBtn"
                                                      Style="{StaticResource RowMorePopupToggleStyle}"
                                                      Tag="{Binding}"
                                                      ToolTip="更多成就操作"
                                                      AutomationProperties.Name="更多成就操作" />
                                        <Popup IsOpen="{Binding IsChecked, ElementName=RowMoreBtn, Mode=TwoWay}"
                                               PlacementTarget="{Binding ElementName=RowMoreBtn}"
                                               DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                               Placement="Bottom"
                                               HorizontalOffset="-142"
                                               VerticalOffset="4"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade"
                                               Opened="OnManagedPopupOpened"
                                               Closed="OnManagedPopupClosed">
                                            <Border Width="176"
                                                    Margin="8"
                                                    Padding="5"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource FloatingMenuBackgroundBrush}"
                                                    BorderBrush="{DynamicResource DividerBrush}"
                                                    BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.14" Color="#000000" />
                                                </Border.Effect>
                                                <StackPanel>
                                                    <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                            Content="标记为已解锁"
                                                            Click="OnAnyPopupMenuItemClick"
                                                            Command="{Binding MarkUnlockedCommand}"
                                                            Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                            Content="重置为未解锁"
                                                            Click="OnAnyPopupMenuItemClick"
                                                            Command="{Binding ResetUnlockedCommand}"
                                                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                            Content="在弹窗中预览此成就"
                                                            Click="OnAnyPopupMenuItemClick"
                                                            Command="{Binding PreviewToastCommand}" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty Filtered State -->
                <TextBlock Grid.Row="2"
                           Text="没有符合当前筛选条件的成就条目"
                           FontSize="13.5"
                           Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,36,0,0"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredAchievements.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- Shared Single-Player External Trainer Safe Manager + Pre-Trainer Snapshots Workbench Template -->
        <DataTemplate x:Key="TrainerWorkbenchTemplate" DataType="{x:Type vm:TrainerWorkbenchViewModel}">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Status / Security Fence / Hybrid Offline Panel / Primary Action Bar -->
            <StackPanel Grid.Row="0" Margin="0,12,0,8">
                <!-- Collapsible Amber vgk.sys Idle Warning Strip -->
                <Border CornerRadius="8"
                        Background="{DynamicResource WarningSoftBannerBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningSoftBannerBorderBrush}"
                        BorderThickness="1"
                        Padding="12,8"
                        Margin="0,0,0,10"
                        Visibility="{Binding ShowVanguardIdleWarning, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="{Binding VanguardWarningSummaryText}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Tier1BadgeForegroundBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       MaxWidth="680"
                                       DockPanel.Dock="Left" />
                            <Button Style="{StaticResource SubtleIconButtonStyle}"
                                    Width="Auto"
                                    Height="24"
                                    Padding="8,0"
                                    FontSize="12"
                                    Content="详情"
                                    Command="{Binding ToggleVanguardWarningCommand}"
                                    DockPanel.Dock="Right" />
                        </DockPanel>
                        <TextBlock Text="Riot Vanguard 内核驱动 (vgk.sys) 在开机时常驻。只要 vgc.exe 未活跃且未开启严格模式，您仍可为纯单机游戏托管修改器；若随后启动 Valorant/LoL，建议先重启系统或保持严格模式开启。"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding IsVanguardWarningExpanded, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- STATE A: Protected Online Game Security Fence Card (Physically NO download/launch controls!) -->
                <Border CornerRadius="10"
                        Background="{DynamicResource DangerSoftBannerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerSoftBannerBorderBrush}"
                        BorderThickness="1"
                        Padding="18,16"
                        Visibility="{Binding ShowProtectedFenceCard, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ProtectedFenceTitleText}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Tier23BadgeForegroundBrush}" />
                        <TextBlock Text="{Binding ProtectedFenceDescriptionText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="安全红线：SPAWN 严禁对 Tier 1 / Tier 3 或无单人模式的 Tier 2 联网游戏执行修改器检索、下载、沙箱启动或热键注入。"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- STATE B: Permitted Single-Player / Hybrid Single-Player Controls -->
                <StackPanel Visibility="{Binding ShowTrainerWorkspaceControls, Converter={StaticResource BoolToVis}}">
                    <!-- Hybrid Single-Player Expandable Offline Verification Panel (Tier 2 with Single-Player Mode) -->
                    <Border CornerRadius="10"
                            Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            Padding="14,10"
                            Margin="0,0,0,10"
                            Visibility="{Binding ShowHybridOfflinePanel, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <WrapPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="混合单机离线无 AC 校验面板"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <Border CornerRadius="4"
                                            Background="{DynamicResource Tier0BadgeBackgroundBrush}"
                                            Padding="6,1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HybridOfflineStatusBadgeText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Tier0BadgeForegroundBrush}" />
                                    </Border>
                                </WrapPanel>
                                <Button Style="{StaticResource SubtleIconButtonStyle}"
                                        Width="Auto"
                                        Height="26"
                                        Padding="8,0"
                                        FontSize="12"
                                        Content="展开 / 收起"
                                        Command="{Binding ToggleOfflinePanelCommand}"
                                        DockPanel.Dock="Right" />
                            </DockPanel>

                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding IsOfflinePanelExpanded, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LiveAntiCheatStatusText}"
                                           FontFamily="{StaticResource SpawnMonoFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="此游戏的静态安全分级将始终保持 Tier 2 不被覆盖。仅当您以离线/无反作弊方式游玩单人内容且实时核验 AC 进程与会话驱动为 0 时，方可临时放行修改器。"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,8" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                            Height="28"
                                            Padding="12,0"
                                            FontSize="12"
                                            Margin="0,0,8,4"
                                            Content="重新探测 AC 状态"
                                            Command="{Binding RefreshLiveAntiCheatProbeCommand}" />
                                    <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                            Height="28"
                                            Padding="12,0"
                                            FontSize="12"
                                            Margin="0,0,8,4"
                                            Content="确认已处于离线无 AC 模式（启用放行）"
                                            Command="{Binding ConfirmOfflineBypassCommand}"
                                            Visibility="{Binding IsOfflineBypassConfirmed, Converter={StaticResource InvBoolToVis}}" />
                                    <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                            Height="28"
                                            Padding="12,0"
                                            FontSize="12"
                                            Margin="0,0,0,4"
                                            Content="撤销离线放行确认"
                                            Command="{Binding RevokeOfflineBypassCommand}"
                                            Visibility="{Binding IsOfflineBypassConfirmed, Converter={StaticResource BoolToVis}}" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Trainer Header & Single Primary Button 3-State Action Strip -->
                    <Border BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,4,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Active Trainer Metadata OR Search Override Input -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Visibility="{Binding HasBoundTrainer, Converter={StaticResource BoolToVis}}">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TrainerDisplayTitle}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border CornerRadius="4"
                                                BorderThickness="1"
                                                Padding="6,1.5"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding TrainerSourceProvenanceNoteText}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActiveTrainerExternalWebSource}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource InfoBannerBackgroundBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource InfoBannerBorderBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TrainerSourceDomainText}"
                                                       FontSize="11.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActiveTrainerExternalWebSource}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding TrainerVersionAndDateText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </WrapPanel>
                                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding TrainerFileMetaText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text=" · SHA-256: "
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding TrainerPinnedSha256Short}"
                                                   ToolTip="{Binding TrainerPinnedSha256Full}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding TrainerSourceProvenanceNoteText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding TrainerSourcePageDisplayLine}"
                                               ToolTip="{Binding TrainerSourcePageUrl}"
                                               FontFamily="{StaticResource SpawnMonoFont}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding HasValidExternalSourceUrl, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasBoundTrainer, Converter={StaticResource InvBoolToVis}}">
                                    <TextBlock Text="尚未绑定外部修改器"
                                               FontSize="14.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="点击右侧「匹配修改器」按英文标准名检索第三方外部网站 FLiNG Trainer (flingtrainer.com)，或点击「导入本地文件」/ 直接拖入本机 .exe .zip .rar .7z"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding UnboundProvenanceHintText}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: SINGLE Primary Button + Context Secondary / ⋯ Popup Menu -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <!-- Secondary: Unbound "导入本地文件" -->
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="36"
                                        Margin="0,0,8,0"
                                        Content="导入本地文件"
                                        Command="{Binding ImportLocalTrainerCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource EqToBool}, ConverterParameter=False}"
                                        Visibility="{Binding ShowUnboundSecondaryImportButton, Converter={StaticResource BoolToVis}}" />

                                <!-- Secondary: Running "显示 / 隐藏原窗口" -->
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="36"
                                        Margin="0,0,8,0"
                                        Content="{Binding OriginalWindowToggleButtonText}"
                                        Command="{Binding ToggleOriginalWindowVisibilityCommand}"
                                        Visibility="{Binding ShowRunningWindowToggleButton, Converter={StaticResource BoolToVis}}" />

                                <!-- SINGLE Primary Action Button (3-State: 匹配修改器 / 启动修改器 / 运行中 · 停止修改器) -->
                                <Button Height="36"
                                        Padding="18,0"
                                        Content="{Binding PrimaryActionButtonText}"
                                        Command="{Binding ExecutePrimaryActionCommand}"
                                        IsEnabled="{Binding IsPrimaryActionButtonEnabled}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryCapsuleButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPrimaryButtonRunningStyle}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource RunningGreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Ready State Floating ⋯ Menu (STRICTLY PlacementTarget.Tag bridge!) -->
                                <Grid Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding ShowReadyMoreMenuButton, Converter={StaticResource BoolToVis}}">
                                    <ToggleButton x:Name="TrainerMoreToggle"
                                                  Style="{StaticResource MorePopupToggleStyle}"
                                                  Tag="{Binding}"
                                                  ToolTip="更多修改器操作"
                                                  AutomationProperties.Name="更多修改器操作" />
                                    <Popup IsOpen="{Binding IsChecked, ElementName=TrainerMoreToggle, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=TrainerMoreToggle}"
                                           DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                           Placement="Bottom"
                                           HorizontalOffset="-206"
                                           VerticalOffset="6"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade"
                                       Opened="OnManagedPopupOpened"
                                       Closed="OnManagedPopupClosed">
                                        <Border Width="244"
                                                Margin="10"
                                                Padding="6"
                                                CornerRadius="12"
                                                Background="{DynamicResource FloatingMenuBackgroundBrush}"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="1">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" Color="#000000" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                        Content="重新匹配"
                                                        Click="OnAnyPopupMenuItemClick"
                                                        Command="{Binding MatchTrainersCommand}" />
                                                <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                        Content="导入覆盖"
                                                        Click="OnAnyPopupMenuItemClick"
                                                        Command="{Binding ImportLocalTrainerCommand}" />
                                                <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                        Content="打开沙箱目录"
                                                        Click="OnAnyPopupMenuItemClick"
                                                        Command="{Binding OpenTrainerSandboxFolderCommand}" />
                                                <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                        Content="在浏览器打开来源网页"
                                                        Click="OnAnyPopupMenuItemClick"
                                                        Command="{Binding OpenActiveTrainerSourcePageCommand}"
                                                        Visibility="{Binding HasValidExternalSourceUrl, Converter={StaticResource BoolToVis}}" />
                                                <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                        Content="复制来源网页链接"
                                                        Click="OnAnyPopupMenuItemClick"
                                                        Command="{Binding CopyActiveTrainerSourceUrlCommand}"
                                                        Visibility="{Binding HasValidExternalSourceUrl, Converter={StaticResource BoolToVis}}" />
                                                <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                        Content="校验 SHA-256"
                                                        Click="OnAnyPopupMenuItemClick"
                                                        Command="{Binding VerifyTrainerIntegrityCommand}" />
                                                <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                        Content="重置开关显示"
                                                        Click="OnAnyPopupMenuItemClick"
                                                        Command="{Binding ResetHotkeyProxyStatesCommand}" />
                                                <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                        Content="在 VirusTotal 查看此哈希"
                                                        Click="OnAnyPopupMenuItemClick"
                                                        Command="{Binding OpenVirusTotalHashCommand}" />
                                                <Border Height="1"
                                                        Background="{DynamicResource DividerBrush}"
                                                        Margin="6,5" />
                                                <Button Style="{StaticResource DangerMenuItemButtonStyle}"
                                                        Content="移除"
                                                        Click="OnAnyPopupMenuItemClick"
                                                        Command="{Binding RemoveTrainerCommand}" />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Optional English Search Override Strip -->
                    <DockPanel LastChildFill="True" Margin="0,8,0,0">
                        <TextBlock Text="{Binding EffectiveSearchQueryLabel}"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   DockPanel.Dock="Right"
                                   Visibility="{Binding EffectiveSearchQueryLabel, Converter={StaticResource StrNotEmptyToVis}}" />
                        <Border Height="30"
                                MaxWidth="320"
                                HorizontalAlignment="Left"
                                CornerRadius="15"
                                Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                Padding="12,0">
                            <Grid>
                                <TextBlock Text="自定义英文检索词（留空自动用英文标准名）…"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding SearchOverrideText, Converter={StaticResource StrNotEmptyToVis}, ConverterParameter=Invert}" />
                                <TextBox Text="{Binding SearchOverrideText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         FontSize="12"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </Border>
                    </DockPanel>

                    <!-- Game Version Fingerprint Drift Gentle Notice -->
                    <Border CornerRadius="8"
                            Background="{DynamicResource WarningSoftBannerBackgroundBrush}"
                            BorderBrush="{DynamicResource WarningSoftBannerBorderBrush}"
                            BorderThickness="1"
                            Padding="10,7"
                            Margin="0,8,0,0"
                            Visibility="{Binding HasGameUpdateDriftNotice, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding GameUpdateDriftNotice}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Download Progress Strip -->
                    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding DownloadStageText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding DownloadProgressPercent, Mode=OneWay}"
                                     Height="5"
                                     Margin="0,4,0,0"
                                     BorderThickness="0"
                                     Background="{DynamicResource SubtleSurfaceBrush}"
                                     Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>

                    <!-- 403 / Challenge Browser Fallback Card -->
                    <Border CornerRadius="8"
                            Background="{DynamicResource WarningSoftBannerBackgroundBrush}"
                            BorderBrush="{DynamicResource WarningSoftBannerBorderBrush}"
                            BorderThickness="1"
                            Padding="12,10"
                            Margin="0,8,0,0"
                            Visibility="{Binding ShowBrowserFallbackCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="源站触发人机验证（403 / Challenge）— 已安全回退浏览器"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Tier1BadgeForegroundBrush}" />
                            <TextBlock Text="{Binding BrowserFallbackMessage}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,8" />
                            <WrapPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="28"
                                        Padding="12,0"
                                        FontSize="12"
                                        Margin="0,0,8,0"
                                        Content="在默认浏览器打开原页"
                                        Command="{Binding OpenFallbackBrowserCommand}" />
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="28"
                                        Padding="12,0"
                                        FontSize="12"
                                        Content="导入下载后的本地文件"
                                        Command="{Binding ImportLocalTrainerCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 225 / 226 Antivirus Quarantine & Smart App Control Diagnostic Card -->
                    <Border CornerRadius="8"
                            Background="{DynamicResource DangerSoftBannerBackgroundBrush}"
                            BorderBrush="{DynamicResource DangerSoftBannerBorderBrush}"
                            BorderThickness="1"
                            Padding="12,10"
                            Margin="0,8,0,0"
                            Visibility="{Binding ShowQuarantineCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="修改器文件被安全软件隔离或受系统策略拦截"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Tier23BadgeForegroundBrush}" />
                            <TextBlock Text="{Binding QuarantineDiagnosticMessage}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,8" />
                            <WrapPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="28"
                                        Padding="12,0"
                                        FontSize="12"
                                        Margin="0,0,8,0"
                                        Content="打开修改器与安全沙箱设置"
                                        Command="{Binding OpenTrainerSettingsCommand}" />
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="28"
                                        Padding="12,0"
                                        FontSize="12"
                                        Content="查看微软 Smart App Control 官方说明"
                                        Command="{Binding OpenSmartAppControlDocsCommand}"
                                        Visibility="{Binding IsSmartAppControlBlocked, Converter={StaticResource BoolToVis}}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Multi-EXE Archive Selection Card -->
                    <Border CornerRadius="8"
                            Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            Padding="12,10"
                            Margin="0,8,0,0"
                            Visibility="{Binding ShowMultiExecutablePicker, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="压缩包内发现多个可执行程序，请选择要托管的主修改器（其余辅助 EXE 绝不自动执行）"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ComboBox Width="340"
                                          Height="30"
                                          Margin="0,0,8,4"
                                          ItemsSource="{Binding PendingExecutableChoices}"
                                          SelectedItem="{Binding SelectedExecutableChoice, Mode=TwoWay}"
                                          DisplayMemberPath="RelativePath" />
                                <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                        Height="30"
                                        Padding="14,0"
                                        FontSize="12.5"
                                        Margin="0,0,6,4"
                                        Content="确认导入所选主程序"
                                        Command="{Binding ConfirmExecutableChoiceCommand}" />
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="30"
                                        Padding="12,0"
                                        FontSize="12.5"
                                        Margin="0,0,0,4"
                                        Content="取消"
                                        Command="{Binding CancelExecutableChoiceCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Discovery Candidates List -->
                    <Border CornerRadius="8"
                            Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            Padding="10,8"
                            Margin="0,8,0,0"
                            MaxHeight="248"
                            Visibility="{Binding HasMatchCandidates, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- External Website Provenance Banner -->
                            <Border Grid.Row="0"
                                    CornerRadius="6"
                                    Background="{DynamicResource InfoBannerBackgroundBrush}"
                                    BorderBrush="{DynamicResource InfoBannerBorderBrush}"
                                    BorderThickness="1"
                                    Padding="10,7"
                                    Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding OnlineDiscoveryDisclosureTitle}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding OnlineDiscoveryDisclosureBody}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding MatchCandidates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TrainerCandidateItemViewModel}">
                                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="4,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <Border CornerRadius="4"
                                                                    Background="{DynamicResource InfoBannerBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource InfoBannerBorderBrush}"
                                                                    BorderThickness="1"
                                                                    Padding="5,1"
                                                                    Margin="6,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip="{Binding ProvenanceHintText}">
                                                                <TextBlock Text="{Binding ProviderLabel}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                            <Border CornerRadius="4"
                                                                    Background="{DynamicResource PageBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource DividerBrush}"
                                                                    BorderThickness="1"
                                                                    Padding="5,1"
                                                                    Margin="6,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ConfidenceBadgeText}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                            </Border>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding VersionSummaryText}"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding SourceUrlDisplayText}"
                                                                   ToolTip="{Binding ValidatedHttpsPageUrl}"
                                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0" />
                                                        <ComboBox Margin="0,5,0,0"
                                                                  MaxWidth="360"
                                                                  HorizontalAlignment="Left"
                                                                  Height="26"
                                                                  FontSize="11.5"
                                                                  ItemsSource="{Binding Attachments}"
                                                                  SelectedItem="{Binding SelectedAttachment, Mode=TwoWay}"
                                                                  DisplayMemberPath="FileName"
                                                                  Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                                Height="28"
                                                                Padding="10,0"
                                                                FontSize="11.5"
                                                                Margin="0,0,6,0"
                                                                Content="查看版本"
                                                                Command="{Binding LoadDetailsCommand}"
                                                                Visibility="{Binding HasAttachments, Converter={StaticResource InvBoolToVis}}" />
                                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                                Height="28"
                                                                Padding="10,0"
                                                                FontSize="11.5"
                                                                Margin="0,0,6,0"
                                                                Content="打开源站网页"
                                                                ToolTip="{Binding ValidatedHttpsPageUrl}"
                                                                Command="{Binding OpenInBrowserCommand}"
                                                                Visibility="{Binding HasValidHttpsPageUrl, Converter={StaticResource BoolToVis}}" />
                                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                                Height="28"
                                                                Padding="10,0"
                                                                FontSize="11.5"
                                                                Margin="0,0,6,0"
                                                                Content="复制链接"
                                                                ToolTip="复制该外部网站来源链接"
                                                                Command="{Binding CopyPageUrlCommand}"
                                                                Visibility="{Binding HasValidHttpsPageUrl, Converter={StaticResource BoolToVis}}" />
                                                        <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                                                Height="28"
                                                                Padding="12,0"
                                                                FontSize="11.5"
                                                                Content="{Binding DownloadButtonLabel}"
                                                                Command="{Binding DownloadCommand}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Middle Row (*): Virtualized Hotkey Proxy List + FreeHosted Manual Entry Adder -->
            <Grid Grid.Row="1"
                  Visibility="{Binding ShowTrainerWorkspaceControls, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Honest Foreground Proxy Disclaimer -->
                <TextBlock Grid.Row="0"
                           Text="{Binding HotkeyProxyDisclaimerText}"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Visibility="{Binding HasBoundTrainer, Converter={StaticResource BoolToVis}}" />

                <!-- Virtualized Recycling Hotkey ListBox -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Hotkeys}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,0,4,6"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         Visibility="{Binding HasBoundTrainer, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True"
                                                    VirtualizationMode="Recycling" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TrainerHotkeyRowViewModel}">
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="2,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            CornerRadius="5"
                                            Background="{DynamicResource SubtleSurfaceBrush}"
                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1"
                                            Padding="8,3"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EffectiveChord}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <WrapPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="13.5"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ProxyStateBadgeText}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Tooltip}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding HasTooltip, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Height="28"
                                                Padding="12,0"
                                                FontSize="12"
                                                Content="{Binding ActionButtonLabel}"
                                                Command="{Binding TriggerCommand}"
                                                IsEnabled="{Binding DataContext.CanTriggerHotkeys, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                        <Button Style="{StaticResource SubtleIconButtonStyle}"
                                                Width="28"
                                                Height="28"
                                                Margin="4,0,0,0"
                                                ToolTip="删除手动条目"
                                                Command="{Binding RemoveCommand}"
                                                Visibility="{Binding IsManualEntry, Converter={StaticResource BoolToVis}}">
                                            <Path Data="M0,0 L8,8 M8,0 L0,8"
                                                  Stroke="{DynamicResource DangerTextBrush}"
                                                  StrokeThickness="1.3"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Manual Hotkey Entry Adder (First-Class FreeHosted Support) -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,8"
                        Visibility="{Binding HasBoundTrainer, Converter={StaticResource BoolToVis}}">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="自由托管手动热键："
                                   FontSize="12.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,4" />
                        <TextBox Width="180"
                                 Height="28"
                                 Margin="0,0,6,4"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="12.5"
                                 Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}"
                                 ToolTip="功能名称，例如：无限生命"
                                 Text="{Binding NewManualHotkeyLabel, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Width="112"
                                 Height="28"
                                 Margin="0,0,8,4"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 FontFamily="{StaticResource SpawnMonoFont}"
                                 FontSize="12.5"
                                 Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}"
                                 ToolTip="组合键，例如：Num 1 / Ctrl+F2"
                                 Text="{Binding NewManualHotkeyChord, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="28"
                                Padding="12,0"
                                FontSize="12"
                                Margin="0,0,0,4"
                                Content="添加热键条目"
                                Command="{Binding AddManualHotkeyCommand}" />
                    </WrapPanel>
                </Border>
            </Grid>

            <!-- Bottom Row: Pre-Trainer Lightweight Save Snapshots & One-Click Rollback -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,10,0,16"
                    Visibility="{Binding ShowTrainerWorkspaceControls, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="启动修改器前轻量存档快照"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{Binding LatestSnapshotNoticeText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Visibility="{Binding HasLatestSnapshotNotice, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="28"
                                Padding="12,0"
                                FontSize="12"
                                Content="立即备份当前存档"
                                Command="{Binding CreateManualSnapshotCommand}"
                                DockPanel.Dock="Right" />
                    </DockPanel>

                    <ScrollViewer MaxHeight="132"
                                  Margin="0,6,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasPreTrainerSnapshots, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding PreTrainerSnapshots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PreTrainerSnapshotItemViewModel}">
                                    <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                            CornerRadius="6"
                                            Padding="10,6"
                                            Margin="0,3,0,0">
                                        <DockPanel LastChildFill="False">
                                            <WrapPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TriggerBadgeText}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding CreatedAtText}"
                                                           FontFamily="{StaticResource SpawnMonoFont}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding MetricsText}"
                                                           FontFamily="{StaticResource SpawnMonoFont}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding RestoredNoteText}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource RunningGreenBrush}"
                                                           Margin="8,0,0,0"
                                                           Visibility="{Binding HasRestoredNote, Converter={StaticResource BoolToVis}}" />
                                            </WrapPanel>
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Height="24"
                                                    Padding="10,0"
                                                    FontSize="11.5"
                                                    Content="一键回滚"
                                                    ToolTip="回滚前将自动创建 PreRestoreSafety 安全备份；游戏运行中不可回滚"
                                                    Command="{Binding RestoreCommand}"
                                                    IsEnabled="{Binding CanRestore}"
                                                    DockPanel.Dock="Right" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="暂无启动前快照记录（首次启动修改器时将自动备份，超阈值或文件锁定时非阻塞跳过）"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,6,0,0"
                               Visibility="{Binding HasPreTrainerSnapshots, Converter={StaticResource InvBoolToVis}}" />
                </StackPanel>
            </Border>
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Root Shell Border (Compensates maximized borderless thickness) -->
    <Border x:Name="WindowOuterBorder"
            Background="{DynamicResource PageBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Column 1: Leftmost Narrow Icon Rail (52px) -->
                <ColumnDefinition Width="52" />
                <!-- Column 2: Context Sidebar (264px on >=1000px, auto-collapsed on narrow) -->
                <ColumnDefinition Width="Auto" />
                <!-- Column 3: Main Panel (Remaining width) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================================================================== -->
            <!-- COLUMN 1: 52px Narrow Icon Rail (#F7F7F7 Light / #181B20 Dark)     -->
            <!-- ================================================================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource RailBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <!-- Top Brand Mark "S" (also supports drag-to-move) -->
                    <Grid DockPanel.Dock="Top"
                          Height="52"
                          Background="Transparent"
                          MouseLeftButtonDown="OnTitleBarDragMouseDown">
                        <TextBlock Text="S"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Bottom Fixed Security Badge + Settings Gear -->
                    <StackPanel DockPanel.Dock="Bottom"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                        <!-- Anti-Cheat Guard & Channel Status Badge -->
                        <Border Width="34"
                                Height="34"
                                CornerRadius="17"
                                Margin="0,0,0,8"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                ToolTip="{Binding GuardRailToolTip}"
                                AutomationProperties.Name="{Binding GuardRailToolTip}">
                            <Grid>
                                <Path Data="M12,2 L19,5 V11 C19,16.2 15.9,20.7 12,22 C8.1,20.7 5,16.2 5,11 V5 Z"
                                      Stroke="{DynamicResource RunningGreenBrush}"
                                      StrokeThickness="1.6"
                                      Stretch="Uniform"
                                      Width="16"
                                      Height="16"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="{DynamicResource WarningAmberBrush}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,2,2,0"
                                         Visibility="{Binding IsGuardCooldownOrProtected, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>

                        <!-- Settings (⚙ Linear Gear Icon) -->
                        <RadioButton Style="{StaticResource IconRailButtonStyle}"
                                     GroupName="PrimaryRailGroup"
                                     ToolTip="设置"
                                     AutomationProperties.Name="设置"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:PrimaryNavSection.Settings}}">
                            <Path Data="M12,8.6 A3.4,3.4 0 1,0 12,15.4 A3.4,3.4 0 1,0 12,8.6 M19.4,13 A7.6,7.6 0 0,0 19.4,11 L21.2,9.6 L19.4,6.5 L17.2,7.3 A7.4,7.4 0 0,0 15.5,6.3 L15.2,4 H11.6 L11.3,6.3 A7.4,7.4 0 0,0 9.6,7.3 L7.4,6.5 L5.6,9.6 L7.4,11 A7.6,7.6 0 0,0 7.4,13 L5.6,14.4 L7.4,17.5 L9.6,16.7 A7.4,7.4 0 0,0 11.3,17.7 L11.6,20 H15.2 L15.5,17.7 A7.4,7.4 0 0,0 17.2,16.7 L19.4,17.5 L21.2,14.4 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  Stretch="Uniform"
                                  Width="19"
                                  Height="19" />
                        </RadioButton>
                    </StackPanel>

                    <!-- Primary Navigation Items (Delivered Modules Only: Library, Achievements, Trainers) -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,2,0,0">
                        <!-- 1. Game Library (Spawn) + Green Running Dot -->
                        <RadioButton Style="{StaticResource IconRailButtonStyle}"
                                     GroupName="PrimaryRailGroup"
                                     ToolTip="{Binding LibraryRailToolTip}"
                                     AutomationProperties.Name="游戏库"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:PrimaryNavSection.Library}}">
                            <Grid Width="24" Height="24">
                                <Path Data="M4,5.5 A2.5,2.5 0 0,1 6.5,3 H17.5 A2.5,2.5 0 0,1 20,5.5 V18.5 A2.5,2.5 0 0,1 17.5,21 H6.5 A2.5,2.5 0 0,1 4,18.5 Z M10,8.5 L15.5,12 L10,15.5 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="19"
                                      Height="19"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="StrokeThickness" Value="1.6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                    <Setter Property="StrokeThickness" Value="2.0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <!-- Green Running Status Dot -->
                                <Border Width="9"
                                        Height="9"
                                        CornerRadius="4.5"
                                        Background="{DynamicResource RunningGreenBrush}"
                                        BorderBrush="{DynamicResource RailBackgroundBrush}"
                                        BorderThickness="1.5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-2,-2,0"
                                        Visibility="{Binding HasAnyRunningGame, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </RadioButton>

                        <!-- 2. Achievements Center -->
                        <RadioButton Style="{StaticResource IconRailButtonStyle}"
                                     GroupName="PrimaryRailGroup"
                                     ToolTip="成就中心"
                                     AutomationProperties.Name="成就中心"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:PrimaryNavSection.Achievements}}">
                            <Path Data="M7,4 H17 V8.5 C17,11.6 14.8,14 12,14.8 C9.2,14 7,11.6 7,8.5 Z M12,14.8 V18 M8.5,18 H15.5 M7,5.5 H4.5 V7.5 C4.5,9.4 5.6,10.5 7,10.5 M17,5.5 H19.5 V7.5 C19.5,9.4 18.4,10.5 17,10.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Width="19"
                                  Height="19">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="StrokeThickness" Value="1.6" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="StrokeThickness" Value="2.0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </RadioButton>

                        <!-- 3. Save Time Machine & Branching Saves + Status Dot -->
                        <RadioButton Style="{StaticResource IconRailButtonStyle}"
                                     GroupName="PrimaryRailGroup"
                                     ToolTip="{Binding SavesRailToolTip}"
                                     AutomationProperties.Name="存档"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:PrimaryNavSection.Saves}}">
                            <Grid Width="24" Height="24">
                                <Path Data="M6,5 V19 M18,7 V10 C18,13 15,14 12,14 H6 M4,5 A2,2 0 1,0 8,5 A2,2 0 1,0 4,5 M16,5 A2,2 0 1,0 20,5 A2,2 0 1,0 16,5 M4,19 A2,2 0 1,0 8,19 A2,2 0 1,0 4,19"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="19"
                                      Height="19"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="StrokeThickness" Value="1.6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                    <Setter Property="StrokeThickness" Value="2.0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <!-- 8px Emerald (Watching) / Amber (Conflict) Status Dot -->
                                <Border Width="10"
                                        Height="10"
                                        CornerRadius="5"
                                        BorderBrush="{DynamicResource RailBackgroundBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-2,-2,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Background" Value="{DynamicResource RunningGreenBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAnySaveWatcherActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Background" Value="{DynamicResource RunningGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasAnyCloudConflict}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Background" Value="{DynamicResource WarningAmberBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <!-- 4. Trainers Manager + 8px Emerald Green Running Dot -->
                        <RadioButton Style="{StaticResource IconRailButtonStyle}"
                                     GroupName="PrimaryRailGroup"
                                     ToolTip="{Binding TrainersRailToolTip}"
                                     AutomationProperties.Name="修改器"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqToBool}, ConverterParameter={x:Static vm:PrimaryNavSection.Trainers}}">
                            <Grid Width="24" Height="24">
                                <Path Data="M6,4 V8 M6,12 V20 M12,4 V13 M12,17 V20 M18,4 V7 M18,11 V20 M4,10 A2,2 0 1,0 8,10 A2,2 0 1,0 4,10 M10,15 A2,2 0 1,0 14,15 A2,2 0 1,0 10,15 M16,9 A2,2 0 1,0 20,9 A2,2 0 1,0 16,9"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="19"
                                      Height="19"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="StrokeThickness" Value="1.6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                    <Setter Property="StrokeThickness" Value="2.0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <!-- 8px Emerald Green (#10B981) Active Trainer Status Dot -->
                                <Border Width="10"
                                        Height="10"
                                        CornerRadius="5"
                                        Background="{DynamicResource RunningGreenBrush}"
                                        BorderBrush="{DynamicResource RailBackgroundBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-2,-2,0"
                                        Visibility="{Binding HasAnyRunningTrainer, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ================================================================== -->
            <!-- COLUMN 2: 264px Context Sidebar (#F7F7F7 + 1px Right Hairline)     -->
            <!-- ================================================================== -->
            <Border Grid.Column="1"
                    Width="264"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <!-- Context A: Game Library Sidebar -->
                    <DockPanel Visibility="{Binding ActiveSection, Converter={StaticResource EqToVis}, ConverterParameter=Library}">
                        <Border DockPanel.Dock="Top"
                                Height="52"
                                Padding="16,0,10,0"
                                Background="Transparent"
                                MouseLeftButtonDown="OnTitleBarDragMouseDown">
                            <Grid>
                                <TextBlock Text="游戏库"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource SubtleIconButtonStyle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ToolTip="扫描本地游戏目录"
                                        AutomationProperties.Name="扫描本地游戏目录"
                                        Command="{Binding ScanDefaultLibraryCommand}">
                                    <Path Data="M19,8 A7.5,7.5 0 1,0 20,13.5 M19,3.8 V8.2 H14.6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15" />
                                </Button>
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,2,0,14">
                                <ItemsControl ItemsSource="{Binding LibraryGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GameSourceGroupViewModel}">
                                            <StackPanel Margin="0,2">
                                                <!-- Collapsible Group Header -->
                                                <Button Cursor="Hand"
                                                        Margin="8,1"
                                                        Padding="8,7"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        FocusVisualStyle="{x:Null}"
                                                        Command="{Binding ToggleExpandedCommand}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="GrpBd"
                                                                    CornerRadius="7"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Background="Transparent">
                                                                <DockPanel LastChildFill="False">
                                                                    <Path x:Name="Chevron"
                                                                          Data="M1,1 L5.5,5.5 L1,10"
                                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                                          StrokeThickness="1.5"
                                                                          StrokeStartLineCap="Round"
                                                                          StrokeEndLineCap="Round"
                                                                          StrokeLineJoin="Round"
                                                                          Width="7"
                                                                          Height="10"
                                                                          Stretch="Uniform"
                                                                          VerticalAlignment="Center"
                                                                          RenderTransformOrigin="0.5,0.5"
                                                                          DockPanel.Dock="Left">
                                                                        <Path.RenderTransform>
                                                                            <RotateTransform Angle="0" />
                                                                        </Path.RenderTransform>
                                                                    </Path>
                                                                    <TextBlock Text="{Binding HeaderTitle}"
                                                                               FontSize="13.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                                               Margin="8,0,0,0"
                                                                               VerticalAlignment="Center"
                                                                               DockPanel.Dock="Left" />
                                                                    <TextBlock Text="{Binding Count}"
                                                                               FontFamily="{StaticResource SpawnMonoFont}"
                                                                               FontSize="11.5"
                                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                                               VerticalAlignment="Center"
                                                                               DockPanel.Dock="Right" />
                                                                </DockPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="GrpBd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="90" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Group Children -->
                                                <ItemsControl ItemsSource="{Binding Items}"
                                                              ItemTemplate="{StaticResource SidebarGameItemTemplate}"
                                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty Sidebar Hint -->
                                <TextBlock Text="暂无已入库游戏"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="18,16,16,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AllGames.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Context B: Achievements Center Sidebar -->
                    <DockPanel Visibility="{Binding ActiveSection, Converter={StaticResource EqToVis}, ConverterParameter=Achievements}">
                        <Border DockPanel.Dock="Top"
                                Height="52"
                                Padding="16,0"
                                Background="Transparent"
                                MouseLeftButtonDown="OnTitleBarDragMouseDown">
                            <TextBlock Text="成就"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,2,0,14">
                                <!-- Recent Unlocks Overview Entry -->
                                <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                             GroupName="AchSidebarGroup"
                                             IsChecked="{Binding IsAchievementsOverviewSelected, Mode=OneWay}"
                                             Command="{Binding SelectAchievementsOverviewCommand}">
                                    <DockPanel LastChildFill="False">
                                        <Path Data="M12,3 L14.6,8.3 L20.5,9.1 L16.2,13.3 L17.2,19.1 L12,16.4 L6.8,19.1 L7.8,13.3 L3.5,9.1 L9.4,8.3 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.55"
                                              Stretch="Uniform"
                                              Width="15"
                                              Height="15"
                                              VerticalAlignment="Center"
                                              DockPanel.Dock="Left" />
                                        <TextBlock Text="最近解锁总览"
                                                   Margin="9,0,0,0"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Left" />
                                    </DockPanel>
                                </RadioButton>

                                <TextBlock Text="各游戏完成度"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="18,12,0,4" />

                                <ItemsControl ItemsSource="{Binding AllGames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GameListItemViewModel}">
                                            <RadioButton Style="{StaticResource SidebarNavRowRadioStyle}"
                                                         GroupName="AchSidebarGroup"
                                                         Height="48"
                                                         Command="{Binding DataContext.SelectAchievementsGameItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         CommandParameter="{Binding}">
                                                <Grid Width="226">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="9" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="28"
                                                            Height="28"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource SubtleSurfaceBrush}"
                                                            ClipToBounds="True"
                                                            VerticalAlignment="Center">
                                                        <Image Source="{Binding SmallIcon}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="13"
                                                                       MaxWidth="122"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       DockPanel.Dock="Left" />
                                                            <TextBlock Text="{Binding AchievementRatioText}"
                                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       DockPanel.Dock="Right" />
                                                        </DockPanel>
                                                        <ProgressBar Minimum="0"
                                                                     Maximum="100"
                                                                     Value="{Binding CompletionPercent, Mode=OneWay}"
                                                                     Height="3.5"
                                                                     Margin="0,5,0,0"
                                                                     BorderThickness="0"
                                                                     Background="{DynamicResource DividerBrush}"
                                                                     Foreground="{DynamicResource AccentBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Context B1: Save Time Machine Sidebar -->
                    <DockPanel Visibility="{Binding ActiveSection, Converter={StaticResource EqToVis}, ConverterParameter=Saves}">
                        <Border DockPanel.Dock="Top"
                                Height="52"
                                Padding="16,0,10,0"
                                Background="Transparent"
                                MouseLeftButtonDown="OnTitleBarDragMouseDown">
                            <Grid>
                                <TextBlock Text="存档"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource SubtleIconButtonStyle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ToolTip="刷新存档库与分支状态"
                                        AutomationProperties.Name="刷新存档库"
                                        Command="{Binding RefreshSaveHubCommand}">
                                    <Path Data="M19,8 A7.5,7.5 0 1,0 20,13.5 M19,3.8 V8.2 H14.6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Fixed Top Overview Row + IME-Guarded Search Box -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,2,0,4">
                            <Button Cursor="Hand"
                                    Margin="8,1,8,8"
                                    Padding="0"
                                    FocusVisualStyle="{x:Null}"
                                    AutomationProperties.Name="全部存档总览"
                                    Command="{Binding SelectSavesOverviewCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="RowBd"
                                                Height="38"
                                                CornerRadius="8"
                                                Padding="10,0"
                                                Background="Transparent">
                                            <DockPanel LastChildFill="False">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                    <Path x:Name="OverviewIcon"
                                                          Data="M6,5 V19 M18,7 V10 C18,13 15,14 12,14 H6 M4,5 A2,2 0 1,0 8,5 A2,2 0 1,0 4,5 M16,5 A2,2 0 1,0 20,5 A2,2 0 1,0 16,5"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.55"
                                                          StrokeLineJoin="Round"
                                                          Stretch="Uniform"
                                                          Width="14.5"
                                                          Height="14.5"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock x:Name="OverviewText"
                                                               Text="全部存档总览"
                                                               FontSize="13.5"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               Margin="9,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <Border DockPanel.Dock="Right"
                                                        CornerRadius="10"
                                                        Padding="7,1.5"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAnyCloudConflict}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource WarningAmberSoftBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding SaveOverviewCountBadgeText}"
                                                               FontFamily="{StaticResource SpawnMonoFont}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasAnyCloudConflict}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningAmberBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSaveOverviewSelected}" Value="True">
                                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                                <Setter TargetName="OverviewIcon" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="OverviewText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="OverviewText" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- IME-Guarded Saves Sidebar Search Box -->
                            <Border Height="30"
                                    Margin="10,0,10,8"
                                    CornerRadius="15"
                                    Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    Padding="10,0,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Data="M6.5,1 A5.5,5.5 0 1,0 6.5,12 A5.5,5.5 0 1,0 6.5,1 M10.6,10.6 L14.2,14.2"
                                          Stroke="{DynamicResource MutedTextBrush}"
                                          StrokeThickness="1.4"
                                          Stretch="Uniform"
                                          Width="12.5"
                                          Height="12.5"
                                          VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
