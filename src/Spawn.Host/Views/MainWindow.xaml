                                    Padding="10,0,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Data="M6.5,1 A5.5,5.5 0 1,0 6.5,12 A5.5,5.5 0 1,0 6.5,1 M10.6,10.6 L14.2,14.2"
