<UserControl x:Class="Spawn.Host.Views.Saves.SaveWorkbenchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Spawn.Host.Converters"
             xmlns:controls="clr-namespace:Spawn.Host.Controls"
             xmlns:savesVm="clr-namespace:Spawn.Host.ViewModels.Saves"
             FontFamily="{DynamicResource SpawnUiFont}"
             Foreground="{DynamicResource PrimaryTextBrush}"
             Background="{DynamicResource PageBackgroundBrush}"
             Typography.NumeralAlignment="Tabular"
             SizeChanged="OnControlSizeChanged"
             PreviewKeyDown="OnControlPreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:EqualityToVisibilityConverter x:Key="EqToVis" />
        <conv:EqualityToBooleanConverter x:Key="EqToBool" />

        <Style x:Key="SaveMorePopupToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource CapsuleInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                CornerRadius="17"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="3.2" Height="3.2" Fill="{TemplateBinding Foreground}" Margin="1.3,0" />
                                <Ellipse Width="3.2" Height="3.2" Fill="{TemplateBinding Foreground}" Margin="1.3,0" />
                                <Ellipse Width="3.2" Height="3.2" Fill="{TemplateBinding Foreground}" Margin="1.3,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SaveThemeComboBoxStyle is shared from Themes/Controls.xaml -->

        <!-- Compact Filter Chip RadioButton Style -->
        <Style x:Key="SaveFilterChipRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                CornerRadius="14"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Reusable Node Inspector Content Template (Used in Right Drawer & Compact Overlay) -->
        <DataTemplate x:Key="NodeInspectorBodyTemplate" DataType="{x:Type savesVm:SaveWorkbenchViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Inspector Header: Note + Badges + Inline Edit -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,12">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button Style="{StaticResource SubtleIconButtonStyle}"
                                    DockPanel.Dock="Left"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,6,0"
                                    ToolTip="返回存档树"
                                    Command="{Binding CloseCompactInspectorCommand}"
                                    Visibility="{Binding IsCompactLayout, Converter={StaticResource BoolToVis}}">
                                <Path Data="M15,4 L7,12 L15,20 M7.5,12 H20"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      Width="14"
                                      Height="14" />
                            </Button>

                            <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="4"
                                        Background="{DynamicResource RunningGreenSoftBrush}"
                                        Padding="6,1.5"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding SelectedNode.IsHead, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedNode.HeadBadgeText}"
                                               FontFamily="{StaticResource SpawnMonoFont}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource RunningGreenBrush}" />
                                </Border>
                                <Border CornerRadius="4"
                                        Background="{DynamicResource WarningAmberSoftBrush}"
                                        Padding="6,1.5"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding SelectedNode.IsPinned, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="★ 已固定"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SavePinStarBrush}" />
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="节点详情"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Display Note OR Inline Edit Note Box -->
                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsEditingNote, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="{Binding SelectedNode.DisplayTitle}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsEditingNote, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding EditNoteInput, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     Padding="8,4"
                                     FontSize="13"
                                     Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                     BorderBrush="{DynamicResource AccentBrush}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SaveEditNoteCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding CancelEditNoteCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                        Height="26"
                                        Padding="12,0"
                                        FontSize="12"
                                        Content="保存备注"
                                        Margin="0,0,6,0"
                                        Command="{Binding SaveEditNoteCommand}" />
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="26"
                                        Padding="10,0"
                                        FontSize="12"
                                        Content="取消"
                                        Command="{Binding CancelEditNoteCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Tabular Metadata Summary -->
                        <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border CornerRadius="4"
                                    Background="{DynamicResource SubtleSurfaceBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    Padding="6,1"
                                    Margin="0,0,6,4">
                                <TextBlock Text="{Binding SelectedNode.BranchDisplayName}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <Border CornerRadius="4"
                                    Background="{DynamicResource SubtleSurfaceBrush}"
                                    Padding="6,1"
                                    Margin="0,0,6,4">
                                <TextBlock Text="{Binding SelectedNode.TriggerLabel}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Border>
                            <TextBlock Text="{Binding SelectedNode.ShortId}"
                                       FontFamily="{StaticResource SpawnMonoFont}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,4" />
                        </WrapPanel>

                        <TextBlock FontFamily="{StaticResource SpawnMonoFont}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,3,0,0">
                            <Run Text="{Binding SelectedNode.TimestampFullText, Mode=OneWay}" />
                            <Run Text=" · 游玩 " />
                            <Run Text="{Binding SelectedNode.PlaytimeText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontFamily="{StaticResource SpawnMonoFont}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0">
                            <Run Text="{Binding SelectedNode.FileCountText, Mode=OneWay}" />
                            <Run Text=" · 原始 " />
                            <Run Text="{Binding SelectedNode.SizeText, Mode=OneWay}" />
                            <Run Text=" · 实占 " />
                            <Run Text="{Binding SelectedNode.StoredSizeText, Mode=OneWay}" />
                        </TextBlock>

                        <!-- Jump to Parent Link -->
                        <Button Style="{StaticResource AccentLinkButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,5,0,0"
                                Command="{Binding JumpToParentSnapshotCommand}"
                                Visibility="{Binding SelectedNode.HasParent, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontFamily="{StaticResource SpawnMonoFont}"
                                       FontSize="11.5"
                                       Text="↳ 跳转至父节点快照" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Inspector Action Strip (Single Primary CTA + Fork Secondary + ⋯ Popup via PlacementTarget.Tag) -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                Height="32"
                                Padding="14,0"
                                FontSize="12.5"
                                Margin="0,0,6,4"
                                Content="载入到游戏"
                                ToolTip="{Binding RollbackButtonToolTip}"
                                Command="{Binding RequestRollbackSelectedCommand}"
                                IsEnabled="{Binding CanRollbackSelected}" />

                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="32"
                                Padding="12,0"
                                FontSize="12.5"
                                Margin="0,0,6,4"
                                Content="从此节点开新路线"
                                Command="{Binding OpenForkPopoverFromSelectedCommand}"
                                IsEnabled="{Binding CanForkFromSelected}" />

                        <Grid Margin="0,0,0,4" VerticalAlignment="Center">
                            <ToggleButton x:Name="NodeInspectorMoreToggle"
                                          Style="{StaticResource SaveMorePopupToggleStyle}"
                                          Width="32"
                                          Height="32"
                                          Tag="{Binding}"
                                          ToolTip="更多节点操作"
                                          AutomationProperties.Name="更多节点操作" />
                            <Popup IsOpen="{Binding IsChecked, ElementName=NodeInspectorMoreToggle, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=NodeInspectorMoreToggle}"
                                   DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                   Placement="Bottom"
                                   HorizontalOffset="-178"
                                   VerticalOffset="6"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Opened="OnManagedPopupOpened"
                                   Closed="OnManagedPopupClosed">
                                <Border Width="212"
                                        Margin="8"
                                        Padding="6"
                                        CornerRadius="12"
                                        Background="{DynamicResource FloatingMenuBackgroundBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.16" Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                Content="{Binding SelectedNodePinActionText}"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding TogglePinSelectedCommand}" />
                                        <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                Content="编辑备注"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding BeginEditNoteCommand}" />
                                        <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                Content="导出快照副本到文件夹…"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding ExportSelectedSnapshotCommand}" />
                                        <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                Content="打开游戏存档目录"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding OpenSaveFolderCommand}" />
                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="6,4" />
                                        <Button Style="{StaticResource DangerMenuItemButtonStyle}"
                                                Content="删除此快照…"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding RequestDeleteSelectedSnapshotCommand}"
                                                IsEnabled="{Binding CanDeleteSelectedSnapshot}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </WrapPanel>
                </Border>

                <!-- Inline Rollback & Delete Snapshot Confirmation Cards -->
                <StackPanel Grid.Row="2">
                    <Border Background="{DynamicResource WarningSoftBannerBackgroundBrush}"
                            BorderBrush="{DynamicResource WarningSoftBannerBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10"
                            Visibility="{Binding IsRollbackConfirmOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="确认将此快照载入到游戏？"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningAmberBrush}" />
                            <TextBlock Text="载入前将自动为当前磁盘存档创建安全保护快照，再原子替换游戏存档文件。"
                                       FontSize="12"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,6" />
                            <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                      Content="同时还原配置文件（默认仅还原游戏存档）"
                                      FontSize="12"
                                      IsChecked="{Binding RollbackIncludeConfig, Mode=TwoWay}"
                                      Margin="0,0,0,6" />
                            <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                      Content="回滚并直接开启新路线（避免自动生成临时分支名）"
                                      FontSize="12"
                                      IsChecked="{Binding RollbackForkNewBranch, Mode=TwoWay}"
                                      Margin="0,0,0,6" />
                            <TextBox Height="28"
                                     Padding="8,3"
                                     Margin="0,0,0,8"
                                     FontSize="12"
                                     Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     Text="{Binding RollbackForkNewBranchName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="输入要开启的新路线名称（例如 boss-retry、ending-b）"
                                     Visibility="{Binding RollbackForkNewBranch, Converter={StaticResource BoolToVis}}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding ConfirmRollbackSelectedCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding CancelRollbackConfirmCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <TextBlock Text="{Binding RollbackModMismatchWarning}"
                                       FontSize="12"
                                       Foreground="{DynamicResource DangerTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding RollbackRequiresModMismatchConfirm, Converter={StaticResource BoolToVis}}" />

                            <WrapPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                        Height="28"
                                        Padding="12,0"
                                        FontSize="12"
                                        Margin="0,0,6,0"
                                        Content="确认载入到游戏"
                                        Command="{Binding ConfirmRollbackSelectedCommand}"
                                        Visibility="{Binding RollbackRequiresModMismatchConfirm, Converter={StaticResource InvBoolToVis}}" />
                                <Button Style="{StaticResource WarningPrimaryCapsuleButtonStyle}"
                                        Height="28"
                                        Padding="12,0"
                                        FontSize="12"
                                        Margin="0,0,6,0"
                                        Content="忽略 Mod 差异强制载入"
                                        Command="{Binding ForceRollbackIgnoringModMismatchCommand}"
                                        Visibility="{Binding RollbackRequiresModMismatchConfirm, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="28"
                                        Padding="10,0"
                                        FontSize="12"
                                        Content="取消"
                                        Command="{Binding CancelRollbackConfirmCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Inline Delete Snapshot Danger Confirmation -->
                    <Border Background="{DynamicResource WarningSoftBannerBackgroundBrush}"
                            BorderBrush="{DynamicResource DangerTextBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10"
                            Visibility="{Binding IsDeleteSnapshotConfirmOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="确认删除此快照？"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerTextBrush}" />
                            <TextBlock Text="{Binding DeleteSnapshotConfirmText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,8" />
                            <WrapPanel Orientation="Horizontal">
                                <Button Style="{StaticResource WarningPrimaryCapsuleButtonStyle}"
                                        Height="28"
                                        Padding="12,0"
                                        FontSize="12"
                                        Margin="0,0,6,0"
                                        Content="确认永久删除"
                                        Command="{Binding ConfirmDeleteSelectedSnapshotCommand}" />
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="28"
                                        Padding="10,0"
                                        FontSize="12"
                                        Content="取消"
                                        Command="{Binding CancelDeleteSelectedSnapshotCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Inspector Sub-Tabs: 文件清单 | 变更对比 -->
                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                     GroupName="SaveInspectorSubTabs"
                                     FontSize="12.5"
                                     Padding="2,7"
                                     Margin="0,0,18,0"
                                     Content="文件清单"
                                     IsChecked="{Binding InspectorTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static savesVm:SaveInspectorTab.Files}}" />
                        <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                     GroupName="SaveInspectorSubTabs"
                                     FontSize="12.5"
                                     Padding="2,7"
                                     Content="变更对比"
                                     IsChecked="{Binding InspectorTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static savesVm:SaveInspectorTab.Diff}}" />
                    </StackPanel>
                </Border>

                <!-- Inspector Viewport: Files List OR Diff List -->
                <Grid Grid.Row="4">
                    <!-- Tab A: Files -->
                    <ListBox ItemsSource="{Binding SelectedNodeFiles}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12,8,10,16"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             Visibility="{Binding ShowFilesInspectorTab, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter HorizontalAlignment="Stretch" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type savesVm:SaveFileEntryViewModel}">
                                <Border BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,7">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Left"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SaveTagSaveBgBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfigCategory}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SaveTagConfigBgBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsRegistryCategory}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SaveTagRegistryBgBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding CategoryTag}"
                                                           FontFamily="{StaticResource SpawnMonoFont}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SaveTagSaveFgBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConfigCategory}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SaveTagConfigFgBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsRegistryCategory}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SaveTagRegistryFgBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding FileSizeText}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Text="{Binding LogicalPath}"
                                                       ToolTip="{Binding OriginalPath}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>

                                        <TextBlock FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   ToolTip="内容完整性校验摘要 (BLAKE3)"
                                                   Margin="0,2,0,0">
                                            <Run Text="校验 " />
                                            <Run Text="{Binding ShortHash, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding LastWriteText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Tab B: Diff Viewer -->
                    <Grid Visibility="{Binding ShowDiffInspectorTab, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="12,8,12,4">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SaveFilterChipRadioStyle}"
                                             GroupName="SaveDiffTargetModeGroup"
                                             Height="24"
                                             FontSize="11.5"
                                             Content="对比父节点"
                                             IsChecked="{Binding DiffTargetMode, Converter={StaticResource EqToBool}, ConverterParameter={x:Static savesVm:SaveDiffTargetMode.Parent}}" />
                                <RadioButton Style="{StaticResource SaveFilterChipRadioStyle}"
                                             GroupName="SaveDiffTargetModeGroup"
                                             Height="24"
                                             FontSize="11.5"
                                             Content="对比当前磁盘"
                                             IsChecked="{Binding DiffTargetMode, Converter={StaticResource EqToBool}, ConverterParameter={x:Static savesVm:SaveDiffTargetMode.CurrentDisk}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding DiffSummaryText}"
                                       FontFamily="{StaticResource SpawnMonoFont}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding SelectedNodeDiffItems}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="12,4,10,16"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="Stretch" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type savesVm:SaveDiffEntryViewModel}">
                                    <Border BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,6">
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Left"
                                                    Width="20"
                                                    Height="20"
                                                    CornerRadius="4"
                                                    Margin="0,0,7,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource DiffModifiedSoftBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource DiffAddedSoftBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource DiffRemovedSoftBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding DiffGlyph}"
                                                           FontFamily="{StaticResource SpawnMonoFont}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource DiffModifiedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DiffAddedBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DiffRemovedBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding SizeDeltaText}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Text="{Binding LogicalPath}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="1"
                                   Text="与对比目标之间无文件变更（内容完全一致）"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="12,24,12,0"
                                   Visibility="{Binding HasSelectedNodeDiffItems, Converter={StaticResource InvBoolToVis}}" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Root Grid with Modal Overlay Support -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Branch Switcher Bar + Single Primary CTA + ⋯ -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Auto-Backup Toggles & Cloud Status Strip -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Optional Inline Popovers (Fork / Rename Branch / Cloud Sync Drawer) -->
            <RowDefinition Height="Auto" />
            <!-- Row 3 (*): Split Viewport (Left Branching Tree List + Right Responsive Node Inspector) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!-- ROW 0: Branch Management Bar + Single Primary CTA (创建快照)      -->
        <!-- ================================================================ -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,10,0,10">
            <DockPanel LastChildFill="False">
                <!-- Left: Active Branch Selector + New Branch + Branch ⋯ -->
                <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Height="34"
                            CornerRadius="8"
                            Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            Padding="8,0,4,0"
                            Margin="0,2,8,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="{Binding ActiveBranchColorBrush}"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="分支"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,5,0"
                                       VerticalAlignment="Center" />
                            <ComboBox Style="{StaticResource SaveThemeComboBoxStyle}"
                                      Width="154"
                                      Height="26"
                                      FontSize="12.5"
                                      FontWeight="SemiBold"
                                      ItemsSource="{Binding Branches}"
                                      SelectedItem="{Binding ActiveBranch, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayLabel"
                                      AutomationProperties.Name="切换当前存档分支" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                            Height="34"
                            Padding="12,0"
                            FontSize="12.5"
                            Margin="0,2,6,2"
                            Content="新建分叉"
                            Command="{Binding OpenForkPopoverFromSelectedCommand}"
                            IsEnabled="{Binding CanCreateSnapshot}" />

                    <!-- Branch Management ⋯ Popup (PlacementTarget.Tag bridged!) -->
                    <Grid Margin="0,2,10,2" VerticalAlignment="Center">
                        <ToggleButton x:Name="BranchMoreToggle"
                                      Style="{StaticResource SaveMorePopupToggleStyle}"
                                      Tag="{Binding}"
                                      ToolTip="分支管理操作"
                                      AutomationProperties.Name="分支管理操作" />
                        <Popup IsOpen="{Binding IsChecked, ElementName=BranchMoreToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=BranchMoreToggle}"
                               DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                               Placement="Bottom"
                               HorizontalOffset="-10"
                               VerticalOffset="6"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Opened="OnManagedPopupOpened"
                               Closed="OnManagedPopupClosed">
                                <Border Width="244"
                                        Margin="8"
                                        Padding="6"
                                        CornerRadius="12"
                                        Background="{DynamicResource FloatingMenuBackgroundBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.16" Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                Content="从当前存档新建分支路线"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding OpenForkPopoverFromHeadCommand}" />
                                        <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                Content="重命名 / 修改路线颜色"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding OpenRenameBranchPopoverCommand}" />
                                        <StackPanel Visibility="{Binding HasBackgroundDeletableBranches, Converter={StaticResource BoolToVis}}">
                                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="6,4" />
                                            <TextBlock Text="后台删除其他路线（不改写磁盘）"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Margin="10,2,8,4" />
                                            <ItemsControl ItemsSource="{Binding BackgroundDeletableBranches}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type savesVm:SaveBranchItemViewModel}">
                                                        <Button Style="{StaticResource DangerMenuItemButtonStyle}"
                                                                Click="OnAnyPopupMenuItemClick"
                                                                Command="{Binding PlacementTarget.Tag.RequestDeleteBranchCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                                <Run Text="删除「" />
                                                                <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                                                <Run Text="」(" />
                                                                <Run Text="{Binding SnapshotCount, Mode=OneWay}" />
                                                                <Run Text=")" />
                                                            </TextBlock>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="6,4" />
                                        <Button Style="{StaticResource DangerMenuItemButtonStyle}"
                                                Content="切回主线并删除当前路线…"
                                                ToolTip="先创建安全保护快照并切回默认主线，再删除当前路线及其未固定快照"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding RequestDeleteActiveBranchCommand}"
                                                IsEnabled="{Binding CanDeleteActiveBranch}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </WrapPanel>

                    <!-- Right: Quick Note Input + SINGLE Primary CTA (创建快照) + Workbench ⋯ -->
                    <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="188"
                                Height="34"
                                CornerRadius="17"
                                Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                Padding="11,0"
                                Margin="0,2,8,2">
                            <Grid>
                                <TextBlock Text="快照备注（可选，回车创建）…"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding QuickSnapshotNote, Converter={StaticResource StrNotEmptyToVis}, ConverterParameter=Invert}" />
                                <TextBox Text="{Binding QuickSnapshotNote, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         FontSize="12"
                                         VerticalContentAlignment="Center">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding CreateSnapshotCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Grid>
                        </Border>

                        <!-- SINGLE Primary Action Button in Toolbar -->
                        <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                Height="34"
                                Padding="16,0"
                                FontSize="13"
                                Margin="0,2,6,2"
                                Content="创建快照"
                                Command="{Binding CreateSnapshotCommand}"
                                IsEnabled="{Binding CanCreateSnapshot}" />

                        <!-- Workbench ⋯ Popup (PlacementTarget.Tag bridged!) -->
                        <Grid Margin="0,2,0,2" VerticalAlignment="Center">
                            <ToggleButton x:Name="SaveWorkbenchMoreToggle"
                                          Style="{StaticResource SaveMorePopupToggleStyle}"
                                          Tag="{Binding}"
                                          ToolTip="更多存档操作"
                                          AutomationProperties.Name="更多存档操作" />
                            <Popup IsOpen="{Binding IsChecked, ElementName=SaveWorkbenchMoreToggle, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=SaveWorkbenchMoreToggle}"
                                   DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                   Placement="Bottom"
                                   HorizontalOffset="-206"
                                   VerticalOffset="6"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Opened="OnManagedPopupOpened"
                                   Closed="OnManagedPopupClosed">
                                <Border Width="244"
                                        Margin="8"
                                        Padding="6"
                                        CornerRadius="12"
                                        Background="{DynamicResource FloatingMenuBackgroundBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.16" Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                                  Margin="10,6,8,6"
                                                  FontSize="12.5"
                                                  Content="手动快照同时包含配置文件"
                                                  ToolTip="同时备份 [config] 类别的游戏配置文件"
                                                  IsChecked="{Binding IncludeConfigOnSnapshot, Mode=TwoWay}" />
                                        <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                                  Margin="10,2,8,6"
                                                  FontSize="12.5"
                                                  Content="创建后立即固定 (★)"
                                                  IsChecked="{Binding PinNewSnapshot, Mode=TwoWay}" />
                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="6,4" />
                                        <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                Content="存档路径配置（自定义目录/文件）"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding TogglePathsDrawerCommand}" />
                                        <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                Content="云同步面板"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding ToggleCloudDrawerCommand}" />
                                        <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                Content="刷新存档路径探测"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding RefreshSaveLocationsCommand}" />
                                        <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                Content="导入旧版修改器前备份"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding ImportLegacyPreTrainerSnapshotsCommand}" />
                                        <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                Content="打开游戏存档目录"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding OpenSaveFolderCommand}" />
                                        <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                Content="存档与云同步全局设置…"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding OpenSavesSettingsCommand}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ================================================================ -->
        <!-- ROW 1: Auto-Backup Toggles + Filter Chips + Cloud Sync Chip      -->
        <!-- ================================================================ -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,8">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <!-- Left: Filter Chips + IME-Guarded Search -->
                    <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource SaveFilterChipRadioStyle}"
                                     GroupName="SaveTreeFilterChips"
                                     Content="全部树"
                                     IsChecked="{Binding TreeFilterMode, Converter={StaticResource EqToBool}, ConverterParameter={x:Static controls:SaveTreeFilterMode.All}}" />
                        <RadioButton Style="{StaticResource SaveFilterChipRadioStyle}"
                                     GroupName="SaveTreeFilterChips"
                                     Content="当前分支"
                                     IsChecked="{Binding TreeFilterMode, Converter={StaticResource EqToBool}, ConverterParameter={x:Static controls:SaveTreeFilterMode.CurrentBranch}}" />
                        <RadioButton Style="{StaticResource SaveFilterChipRadioStyle}"
                                     GroupName="SaveTreeFilterChips"
                                     Content="★ 已固定"
                                     IsChecked="{Binding TreeFilterMode, Converter={StaticResource EqToBool}, ConverterParameter={x:Static controls:SaveTreeFilterMode.PinnedOnly}}" />

                        <Border Width="168"
                                Height="28"
                                Margin="4,0,0,0"
                                CornerRadius="14"
                                Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                Padding="9,0,6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="筛选备注 / 路线 / 日期…"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding TreeSearchText, Converter={StaticResource StrNotEmptyToVis}, ConverterParameter=Invert}" />
                                <TextBox x:Name="TreeSearchTextBox"
                                         Grid.Column="0"
                                         Text="{Binding TreeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         FontSize="11.5"
                                         VerticalContentAlignment="Center"
                                         PreviewKeyDown="OnTreeSearchPreviewKeyDown" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource SubtleIconButtonStyle}"
                                        Width="18"
                                        Height="18"
                                        Command="{Binding ClearTreeSearchCommand}"
                                        Visibility="{Binding TreeSearchText, Converter={StaticResource StrNotEmptyToVis}}">
                                    <Path Data="M0,0 L6,6 M6,0 L0,6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.3"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </Border>
                    </WrapPanel>

                    <!-- Right: Auto-Backup Toggles & Paths/Cloud Drawer Toggles -->
                    <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                  Content="退出自动备份"
                                  ToolTip="通过 SPAWN 启动游戏时自动生效：退出游戏后自动保存一份快照"
                                  FontSize="12"
                                  Margin="0,2,10,2"
                                  IsChecked="{Binding PostExitSnapshotEnabled, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                  Content="实时防撕裂热备"
                                  ToolTip="通过 SPAWN 启动游戏时自动生效：监听游戏存档写入稳定后自动备份"
                                  FontSize="12"
                                  Margin="0,2,10,2"
                                  IsChecked="{Binding AutoWatchEnabled, Mode=TwoWay}" />
                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="28"
                                Padding="10,0"
                                FontSize="12"
                                Margin="0,2,6,2"
                                Content="路径配置"
                                ToolTip="展开存档路径配置，查看已探测路径、安全拦截提示或添加自定义目录/文件"
                                Command="{Binding TogglePathsDrawerCommand}" />
                        <Button Height="28"
                                Padding="11,0"
                                FontSize="12"
                                Margin="0,2,0,2"
                                Command="{Binding ToggleCloudDrawerCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryCapsuleButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnresolvedCloudConflict}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WarningAmberSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningAmberBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource WarningAmberBrush}" />
                                        </DataTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding CloudStatusChipText}" FontWeight="SemiBold" />
                        </Button>
                    </WrapPanel>
                </DockPanel>

                <!-- Sub-metrics hairline summary (with live Watcher status & clickable Paths summary) -->
                <DockPanel LastChildFill="False" Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding TreeMetricsSummaryText}"
                               FontFamily="{StaticResource SpawnMonoFont}"
                               FontSize="11.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="4"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                Padding="6,1"
                                Margin="8,0,8,0"
                                ToolTip="{Binding WatcherStatusDetailText}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7"
                                         Height="7"
                                         Margin="0,0,5,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWatcherActive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource RunningGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWatcherError}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource DangerTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding WatcherStatusBadgeText}"
                                           FontSize="11"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWatcherActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource RunningGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWatcherError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text=" · 通过 SPAWN 启动自动生效"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsWatcherActive, Converter={StaticResource InvBoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource AccentLinkButtonStyle}"
                                Command="{Binding TogglePathsDrawerCommand}"
                                ToolTip="点击展开存档路径配置，查看现存路径、未生成路径与拦截原因">
                            <TextBlock Text="{Binding ResolvedLocationsSummaryText}"
                                       FontSize="11.5"
                                       TextTrimming="CharacterEllipsis" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ================================================================ -->
        <!-- ROW 2: Banners, Paths Drawer, Inline Fork/Rename/Delete & Cloud  -->
        <!-- ================================================================ -->
        <StackPanel Grid.Row="2">
            <!-- Busy Banner -->
            <Border Background="{DynamicResource InfoBannerBackgroundBrush}"
                    BorderBrush="{DynamicResource InfoBannerBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,6"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding BusyMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource AccentBrush}" />
            </Border>

            <!-- Watcher Error Detail Banner -->
            <Border Background="{DynamicResource WarningSoftBannerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerTextBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,6"
                    Visibility="{Binding IsWatcherError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding WatcherStatusDetailText}"
                           FontSize="12"
                           Foreground="{DynamicResource DangerTextBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- One-Time Legacy PreTrainer Migration Banner -->
            <Border Background="{DynamicResource InfoBannerBackgroundBrush}"
                    BorderBrush="{DynamicResource InfoBannerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,8,0,0"
                    Visibility="{Binding ShowLegacyPreTrainerBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding LegacyPreTrainerBannerText}"
                               FontSize="12"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                Height="26"
                                Padding="12,0"
                                FontSize="11.5"
                                Margin="8,0,6,0"
                                Content="一键无损导入"
                                Command="{Binding ImportLegacyPreTrainerSnapshotsCommand}" />
                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="26"
                                Padding="10,0"
                                FontSize="11.5"
                                Content="不再提示"
                                Command="{Binding DismissLegacyImportBannerCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Detached HEAD ("历史回溯中") Guidance Banner -->
            <Border Background="{DynamicResource WarningSoftBannerBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningSoftBannerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,9"
                    Margin="0,8,0,0"
                    Visibility="{Binding IsDetachedHead, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="当前处于「历史回溯中」状态"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningAmberBrush}" />
                        <TextBlock Text="游戏当前加载的是历史时间点存档。建议先新建一条分支路线再继续游玩，或一键切回主线最新进度。"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                Height="28"
                                Padding="12,0"
                                FontSize="12"
                                Margin="0,2,6,2"
                                Content="以此节点新建分支路线"
                                Command="{Binding OpenForkPopoverFromHeadCommand}" />
                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="28"
                                Padding="12,0"
                                FontSize="12"
                                Margin="0,2,0,2"
                                Content="回到主线最新"
                                Command="{Binding ReturnToMainLatestCommand}"
                                IsEnabled="{Binding CanMutateDiskSaves}" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- Inline Delete Branch Danger Confirmation Panel -->
            <Border Background="{DynamicResource WarningSoftBannerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerTextBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,8,0,0"
                    Visibility="{Binding IsDeleteBranchConfirmOpen, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding DeleteBranchConfirmTitle}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerTextBrush}" />
                        <TextBlock Text="{Binding DeleteBranchConfirmDescription}"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WarningPrimaryCapsuleButtonStyle}"
                                Height="30"
                                Padding="14,0"
                                FontSize="12"
                                Margin="0,2,6,2"
                                Content="确认删除路线"
                                Command="{Binding ConfirmDeleteBranchCommand}" />
                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="30"
                                Padding="12,0"
                                FontSize="12"
                                Margin="0,2,0,2"
                                Content="取消"
                                Command="{Binding CancelDeleteBranchCommand}" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- Expandable Save Paths Config Drawer (P0-3 Custom Locations + Warnings) -->
            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,11"
                    Margin="0,8,0,0"
                    Visibility="{Binding IsPathsDrawerOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="存档路径配置（支持添加自定义存档目录、单文件或 HKCU 注册表键）"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                    Height="28"
                                    Padding="11,0"
                                    FontSize="11.5"
                                    Margin="0,2,6,2"
                                    Content="+ 添加自定义目录"
                                    Command="{Binding AddCustomFolderCommand}" />
                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                    Height="28"
                                    Padding="11,0"
                                    FontSize="11.5"
                                    Margin="0,2,6,2"
                                    Content="+ 添加单文件"
                                    Command="{Binding AddCustomFileCommand}" />
                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                    Height="28"
                                    Padding="10,0"
                                    FontSize="11.5"
                                    Margin="0,2,6,2"
                                    Content="刷新探测"
                                    Command="{Binding RefreshSaveLocationsCommand}" />
                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                    Height="28"
                                    Padding="10,0"
                                    FontSize="11.5"
                                    Margin="0,2,0,2"
                                    Content="收起"
                                    Command="{Binding TogglePathsDrawerCommand}" />
                        </WrapPanel>
                    </DockPanel>

                    <!-- Add Custom HKCU Registry Key Row -->
                    <DockPanel LastChildFill="True" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="28"
                                Padding="11,0"
                                FontSize="11.5"
                                Margin="8,0,0,0"
                                Content="+ 添加注册表键"
                                Command="{Binding AddCustomRegistryKeyCommand}" />
                        <Grid>
                            <TextBlock Text="可选：输入 HKCU\Software\开发商\游戏名 添加注册表存档键…"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding CustomRegistryKeyInput, Converter={StaticResource StrNotEmptyToVis}, ConverterParameter=Invert}" />
                            <TextBox Height="28"
                                     Padding="8,3"
                                     FontSize="11.5"
                                     FontFamily="{StaticResource SpawnMonoFont}"
                                     Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     Text="{Binding CustomRegistryKeyInput, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddCustomRegistryKeyCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </DockPanel>

                    <!-- Probed & Custom Locations List -->
                    <ItemsControl ItemsSource="{Binding ResolvedLocationItems}"
                                  Margin="0,8,0,0"
                                  Visibility="{Binding HasResolvedLocationItems, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type savesVm:ResolvedSaveLocationItemViewModel}">
                                <Border BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,6">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding MetricsText}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                    Height="24"
                                                    Padding="8,0"
                                                    FontSize="11"
                                                    Margin="0,0,4,0"
                                                    Content="打开"
                                                    Command="{Binding DataContext.OpenSpecificLocationFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding Exists, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource DangerMenuItemButtonStyle}"
                                                    Height="24"
                                                    Padding="8,0"
                                                    FontSize="11"
                                                    Content="移除"
                                                    Command="{Binding DataContext.RemoveCustomLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <StackPanel VerticalAlignment="Center">
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border CornerRadius="4"
                                                        Background="{DynamicResource SaveTagSaveBgBrush}"
                                                        Padding="5,1"
                                                        Margin="0,0,6,2">
                                                    <TextBlock Text="{Binding CategoryTag}"
                                                               FontFamily="{StaticResource SpawnMonoFont}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SaveTagSaveFgBrush}" />
                                                </Border>
                                                <Border CornerRadius="4"
                                                        Padding="5,1"
                                                        Margin="0,0,6,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Exists}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource RunningGreenSoftBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding ExistsBadgeText}" FontSize="10.5" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Exists}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource RunningGreenBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <Border CornerRadius="4"
                                                        Background="{DynamicResource SaveBranchLane0SoftBrush}"
                                                        Padding="5,1"
                                                        Margin="0,0,6,2">
                                                    <TextBlock Text="{Binding SourceLabel}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding ResolvedFullPath}"
                                                       ToolTip="{Binding LogicalTemplatePath}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="暂未探测到存档路径，请点击上方按钮手动添加该游戏的存档目录或单文件。"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasResolvedLocationItems, Converter={StaticResource InvBoolToVis}}" />

                    <!-- Safety Fence Warnings -->
                    <Border CornerRadius="6"
                            Background="{DynamicResource WarningSoftBannerBackgroundBrush}"
                            BorderBrush="{DynamicResource WarningSoftBannerBorderBrush}"
                            BorderThickness="1"
                            Padding="10,7"
                            Margin="0,8,0,0"
                            Visibility="{Binding HasResolvedLocationWarnings, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="安全围栏拦截 / 探测提示："
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningAmberBrush}" />
                            <ItemsControl ItemsSource="{Binding ResolvedLocationWarnings}" Margin="0,3,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Fork New Branch Inline Panel -->
            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,11"
                    Margin="0,8,0,0"
                    Visibility="{Binding IsForkPanelOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="创建新存档分支路线"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock DockPanel.Dock="Right"
                                   FontFamily="{StaticResource SpawnMonoFont}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}">
                            <Run Text="分叉起点：" />
                            <Run Text="{Binding ForkSourceLabel, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>

                    <WrapPanel Orientation="Horizontal" Margin="0,9,0,0" VerticalAlignment="Center">
                        <TextBox Width="178"
                                 Height="30"
                                 Padding="9,4"
                                 Margin="0,0,8,6"
                                 FontSize="12.5"
                                 Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}"
                                 BorderThickness="1"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 Text="{Binding ForkBranchNameInput, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="输入新分支路线名称（例如 boss-rush、bad-ending）">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ConfirmForkBranchCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding CancelForkPopoverCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Grid Width="190" Height="30" Margin="0,0,10,6">
                            <TextBlock Text="路线说明（可选）…"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding ForkBranchDescriptionInput, Converter={StaticResource StrNotEmptyToVis}, ConverterParameter=Invert}" />
                            <TextBox Height="30"
                                     Padding="9,4"
                                     FontSize="12"
                                     Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     Text="{Binding ForkBranchDescriptionInput, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="可选：填写这条存档路线的用途说明">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding ConfirmForkBranchCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding CancelForkPopoverCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>

                        <!-- 8-Color Lane Swatch Picker with Selected Highlight Ring -->
                        <ItemsControl ItemsSource="{Binding BranchColorPalette}" Margin="0,0,12,6" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type savesVm:SaveBranchColorOption}">
                                    <Button Cursor="Hand"
                                            Width="24"
                                            Height="24"
                                            Margin="2,0"
                                            ToolTip="{Binding Label}"
                                            FocusVisualStyle="{x:Null}"
                                            Command="{Binding DataContext.SelectForkColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding ColorHex}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="12"
                                                        Padding="2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelectedForFork}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border CornerRadius="10" Background="{Binding SwatchBrush}">
                                                        <Ellipse Width="6"
                                                                 Height="6"
                                                                 Fill="White"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding IsSelectedForFork, Converter={StaticResource BoolToVis}}" />
                                                    </Border>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                  Content="分叉后立即载入到游戏"
                                  FontSize="12"
                                  Margin="0,0,12,6"
                                  IsChecked="{Binding SwitchToForkedBranch, Mode=TwoWay}"
                                  IsEnabled="{Binding IsSelectedGameRunning, Converter={StaticResource EqToBool}, ConverterParameter=False}" />

                        <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                Height="30"
                                Padding="14,0"
                                FontSize="12.5"
                                Margin="0,0,6,6"
                                Content="创建路线"
                                Command="{Binding ConfirmForkBranchCommand}" />
                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="30"
                                Padding="12,0"
                                FontSize="12.5"
                                Margin="0,0,0,6"
                                Content="取消"
                                Command="{Binding CancelForkPopoverCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Rename Branch Inline Panel -->
            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,8,0,0"
                    Visibility="{Binding IsRenameBranchPanelOpen, Converter={StaticResource BoolToVis}}">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="重命名当前路线："
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,4" />
                    <TextBox Width="184"
                             Height="30"
                             Padding="9,4"
                             Margin="0,0,10,4"
                             FontSize="12.5"
                             Background="{DynamicResource CapsuleInputBackgroundBrush}"
                             BorderBrush="{DynamicResource ControlBorderBrush}"
                             BorderThickness="1"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             Text="{Binding RenameBranchNameInput, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ConfirmRenameBranchCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CancelRenameBranchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <ItemsControl ItemsSource="{Binding BranchColorPalette}" Margin="0,0,12,4" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type savesVm:SaveBranchColorOption}">
                                <Button Cursor="Hand"
                                        Width="22"
                                        Height="22"
                                        Margin="2,0"
                                        ToolTip="{Binding Label}"
                                        FocusVisualStyle="{x:Null}"
                                        Command="{Binding DataContext.SelectRenameBranchColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding ColorHex}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="11" Padding="1.5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelectedForRename}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border CornerRadius="9" Background="{Binding SwatchBrush}">
                                                    <Ellipse Width="5"
                                                             Height="5"
                                                             Fill="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Visibility="{Binding IsSelectedForRename, Converter={StaticResource BoolToVis}}" />
                                                </Border>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                            Height="28"
                            Padding="12,0"
                            FontSize="12"
                            Margin="0,0,6,4"
                            Content="保存"
                            Command="{Binding ConfirmRenameBranchCommand}" />
                    <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                            Height="28"
                            Padding="10,0"
                            FontSize="12"
                            Margin="0,0,0,4"
                            Content="取消"
                            Command="{Binding CancelRenameBranchCommand}" />
                </WrapPanel>
            </Border>

            <!-- Collapsible Cloud Sync Drawer -->
            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,11"
                    Margin="0,8,0,0"
                    Visibility="{Binding IsCloudDrawerOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- Empty State Guidance Card when no cloud endpoint is configured -->
                    <DockPanel LastChildFill="False"
                               Visibility="{Binding HasNoCloudEndpoints, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="尚未配置云同步端点"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="前往「存档与云同步设置」添加本地同步目录、NAS / WebDAV 或 S3 / R2 存储桶，即可在多台电脑之间安全同步进度。"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                Height="30"
                                Padding="14,0"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Content="前往配置云端点"
                                Command="{Binding OpenSavesSettingsCommand}" />
                    </DockPanel>

                    <!-- Configured Cloud Endpoint Controls -->
                    <StackPanel Visibility="{Binding HasCloudEndpoints, Converter={StaticResource BoolToVis}}">
                        <DockPanel LastChildFill="False">
                            <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="跨设备云同步"
                                           ToolTip="底层使用不可变 32MB SPPK 增量分包与 64 代父指针链防覆盖"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <ComboBox Style="{StaticResource SaveThemeComboBoxStyle}"
                                          Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                          BorderBrush="{DynamicResource ControlBorderBrush}"
                                          BorderThickness="1"
                                          Width="210"
                                          Height="28"
                                          Margin="10,2,8,2"
                                          FontSize="12"
                                          ItemsSource="{Binding AvailableCloudEndpoints}"
                                          SelectedItem="{Binding SelectedCloudEndpoint, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="28"
                                        Padding="10,0"
                                        FontSize="12"
                                        Margin="0,2,0,2"
                                        Content="管理云端点"
                                        Command="{Binding OpenSavesSettingsCommand}" />
                            </WrapPanel>

                            <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="28"
                                        Padding="11,0"
                                        FontSize="12"
                                        Margin="0,2,6,2"
                                        Content="检查同步状态"
                                        Command="{Binding PlanCloudSyncCommand}"
                                        IsEnabled="{Binding IsCloudSyncBusy, Converter={StaticResource EqToBool}, ConverterParameter=False}" />
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="28"
                                        Padding="11,0"
                                        FontSize="12"
                                        Margin="0,2,6,2"
                                        Content="推送全部分支"
                                        ToolTip="同步当前路线并将全部本地侧分支一并推送至云端"
                                        Command="{Binding PushAllBranchesCommand}"
                                        IsEnabled="{Binding CanExecuteDirectCloudSync}" />
                                <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                        Height="28"
                                        Padding="14,0"
                                        FontSize="12"
                                        Margin="0,2,0,2"
                                        Content="立即同步"
                                        Command="{Binding ExecuteCloudSyncCommand}"
                                        IsEnabled="{Binding CanExecuteDirectCloudSync}" />
                            </WrapPanel>
                        </DockPanel>

                        <!-- Cross-Machine Stable CloudGameKey Binding & Branch Sync Scope -->
                        <WrapPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                            <TextBlock Text="云端槽位键："
                                       FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       ToolTip="两台电脑对同一游戏使用相同的云端槽位键即可跨设备同步（默认自动按 Steam / GOG / 标题生成）" />
                            <TextBox Width="210"
                                     Height="26"
                                     Padding="8,2"
                                     Margin="4,2,6,2"
                                     FontFamily="{StaticResource SpawnMonoFont}"
                                     FontSize="11.5"
                                     Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     Text="{Binding CloudGameKeyInput, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SaveCloudGameKeyCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                    Height="26"
                                    Padding="10,0"
                                    FontSize="11.5"
                                    Margin="0,2,6,2"
                                    Content="保存键名"
                                    Command="{Binding SaveCloudGameKeyCommand}" />
                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                    Height="26"
                                    Padding="10,0"
                                    FontSize="11.5"
                                    Margin="0,2,12,2"
                                    Content="恢复自动"
                                    Command="{Binding ResetCloudGameKeyCommand}"
                                    Visibility="{Binding HasCustomCloudGameKey, Converter={StaticResource BoolToVis}}" />
                            <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                      Content="同步时一并推送全部分支路线"
                                      FontSize="11.5"
                                      Margin="0,2,0,2"
                                      IsChecked="{Binding SyncAllBranchesToCloud, Mode=TwoWay}" />
                        </WrapPanel>

                        <TextBlock Text="{Binding CloudSyncScopeText}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CloudPlanSummaryText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                        <TextBlock Text="{Binding CloudPlanTransferMetricsText}"
                                   FontFamily="{StaticResource SpawnMonoFont}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding CloudPlanTransferMetricsText, Converter={StaticResource StrNotEmptyToVis}}" />

                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsCloudSyncBusy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding CloudSyncProgressText}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding CloudSyncProgressPercent, Mode=OneWay}"
                                         Height="5"
                                         Margin="0,4,0,0"
                                         BorderThickness="0"
                                         Background="{DynamicResource DividerBrush}"
                                         Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================================================================ -->
        <!-- ROW 3 (*): Split Branching Save Tree List + Node Inspector       -->
        <!-- ================================================================ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left (*): Virtualized Recycling Branching Save Tree ListBox -->
            <Grid Grid.Column="0">
                <ListBox x:Name="SaveTreeListBox"
                         ItemsSource="{Binding GraphRows}"
                         SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,4,4,20"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.CacheLength="1,1"
                         VirtualizingPanel.CacheLengthUnit="Page"
                         Visibility="{Binding HasVisibleGraphRows, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True"
                                                    VirtualizationMode="Recycling" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnTreeItemPreviewMouseRightButtonDown" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="载入到游戏（回滚）"
                                                  Command="{Binding RequestRollbackSelectedCommand}"
                                                  IsEnabled="{Binding CanRollbackSelected}" />
                                        <MenuItem Header="从此节点新建分支路线"
                                                  Command="{Binding OpenForkPopoverFromSelectedCommand}"
                                                  IsEnabled="{Binding CanForkFromSelected}" />
                                        <Separator />
                                        <MenuItem Header="{Binding SelectedNodePinActionText}"
                                                  Command="{Binding TogglePinSelectedCommand}" />
                                        <MenuItem Header="编辑备注"
                                                  Command="{Binding BeginEditNoteCommand}" />
                                        <MenuItem Header="导出快照副本到文件夹…"
                                                  Command="{Binding ExportSelectedSnapshotCommand}" />
                                        <Separator />
                                        <MenuItem Header="删除此快照…"
                                                  Command="{Binding RequestDeleteSelectedSnapshotCommand}"
                                                  IsEnabled="{Binding CanDeleteSelectedSnapshot}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="RowSurface"
                                                Height="58"
                                                CornerRadius="8"
                                                Background="Transparent"
                                                Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type savesVm:SaveSnapshotRowViewModel}">
                            <Grid Height="58">
                                <Grid.ColumnDefinitions>
                                    <!-- Dynamic Vector Bezier Graph Lane Column -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Snapshot Branch Pills, Note, Trigger Icon & Tabular Metadata -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Right Status Icons (Pin Star + Cloud Synced) -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Pure Native WPF Vector Bezier Lane & Node Renderer -->
                                <controls:SaveGraphCellControl Grid.Column="0"
                                                               Width="{Binding DataContext.GraphColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Height="58"
                                                               RowLayout="{Binding GraphLayout}"
                                                               IsRowSelected="{Binding IsSelected}"
                                                               SurfaceBackgroundBrush="{DynamicResource PageBackgroundBrush}"
                                                               SelectedSurfaceBrush="{DynamicResource SelectedPillBrush}"
                                                               HeadRingBrush="{DynamicResource SaveHeadRingBrush}"
                                                               PinAccentBrush="{DynamicResource SavePinStarBrush}" />

                                <!-- Middle: Line 1 (Branch Tip Pills + HEAD + Trigger Glyph + Note) & Line 2 (Tabular Mono Meta) -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Branch Tip Pills -->
                                        <ItemsControl ItemsSource="{Binding BranchTipPills}"
                                                      Visibility="{Binding HasBranchTipPills, Converter={StaticResource BoolToVis}}"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type savesVm:SaveBranchTipPillViewModel}">
                                                    <Border CornerRadius="4"
                                                            Background="{Binding SoftBackgroundBrush}"
                                                            BorderBrush="{Binding AccentBrush}"
                                                            BorderThickness="1"
                                                            Padding="6,1"
                                                            Margin="0,0,5,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding AccentBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- HEAD Pill -->
                                        <Border CornerRadius="4"
                                                Background="{DynamicResource RunningGreenSoftBrush}"
                                                Padding="5,1"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsHead, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding HeadBadgeText}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource RunningGreenBrush}" />
                                        </Border>

                                        <!-- Trigger Icon -->
                                        <Path Data="{Binding TriggerIconPathData}"
                                              Stroke="{DynamicResource SecondaryTextBrush}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Stretch="Uniform"
                                              Width="12"
                                              Height="12"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              ToolTip="{Binding TriggerLabel}" />

                                        <!-- Note / Snapshot Title -->
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Line 2: Tabular Mono Timestamp, Size, File Count, Playtime, Short Hash -->
                                    <TextBlock Text="{Binding MetaLineText}"
                                               FontFamily="{StaticResource SpawnMonoFont}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Right: Pinned Star & Cloud Badge -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="{Binding CloudStatusBadgeText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsCloudSynced, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="★"
                                               FontSize="13"
                                               Foreground="{DynamicResource SavePinStarBrush}"
                                               ToolTip="已固定快照（永不自动滚动清理）"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Three Differentiated Empty States with Direct CTAs -->
                <Grid Visibility="{Binding HasVisibleGraphRows, Converter={StaticResource InvBoolToVis}}">
                    <!-- Empty State 1: Save paths detected, 0 snapshots yet -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="440"
                                Visibility="{Binding ShowEmptyNoSnapshotsWithPaths, Converter={StaticResource BoolToVis}}">
                        <Border Width="48"
                                Height="48"
                                CornerRadius="12"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center">
                            <Path Data="M6,4 V20 M18,6 V10 C18,13 15,14 12,14 H6 M4,6 A2,2 0 1,0 8,6 A2,2 0 1,0 4,6 M16,6 A2,2 0 1,0 20,6 A2,2 0 1,0 16,6 M4,18 A2,2 0 1,0 8,18 A2,2 0 1,0 4,18"
                                  Stroke="{DynamicResource MutedTextBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="22"
                                  Height="22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="尚未创建第一个存档快照"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="已定位到该游戏的存档路径规则。点击下方按钮建立第一个时间节点，之后可随时回滚或开启多条独立分支路线。"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,14" />
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                    Height="34"
                                    Padding="16,0"
                                    FontSize="12.5"
                                    Margin="0,0,8,0"
                                    Content="创建第一个快照"
                                    Command="{Binding CreateSnapshotCommand}"
                                    IsEnabled="{Binding CanCreateSnapshot}" />
                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                    Height="34"
                                    Padding="14,0"
                                    FontSize="12.5"
                                    Content="查看存档路径"
                                    Command="{Binding TogglePathsDrawerCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Empty State 2: No save paths detected at all -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="440"
                                Visibility="{Binding ShowEmptyNoPathsDetected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="尚未探测到该游戏的存档路径"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="可能是小众游戏、非标准存档目录，或被安全围栏跳过。您可以一键手动添加自定义存档目录、单文件或 HKCU 注册表键。"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,14" />
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                    Height="34"
                                    Padding="16,0"
                                    FontSize="12.5"
                                    Margin="0,0,8,0"
                                    Content="配置自定义存档路径"
                                    Command="{Binding TogglePathsDrawerCommand}" />
                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                    Height="34"
                                    Padding="14,0"
                                    FontSize="12.5"
                                    Content="重新探测路径"
                                    Command="{Binding RefreshSaveLocationsCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Empty State 3: Snapshots exist, but filter/search matched nothing -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="420"
                                Visibility="{Binding ShowEmptyFilterNoMatch, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="当前筛选条件下没有匹配的快照"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="尝试切换回「全部树」或清空搜索关键词以查看该游戏的全部存档时间线。"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,14" />
                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="34"
                                Padding="16,0"
                                FontSize="12.5"
                                HorizontalAlignment="Center"
                                Content="重置筛选与搜索"
                                Command="{Binding ResetTreeFiltersCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Right (Desktop >= 740 DIP): Fixed 348px Hairline-Separated Node Inspector -->
            <Border Grid.Column="1"
                    Width="348"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1,0,0,0"
                    Background="{DynamicResource PageBackgroundBrush}"
                    Visibility="{Binding ShowDesktopInspector, Converter={StaticResource BoolToVis}}">
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource NodeInspectorBodyTemplate}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>

            <!-- Compact (< 740 DIP): Slide-Over Inspector Overlay -->
            <Border Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="{DynamicResource PageBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowCompactInspectorOverlay, Converter={StaticResource BoolToVis}}">
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource NodeInspectorBodyTemplate}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>
        </Grid>

        <!-- ================================================================ -->
        <!-- MODAL OVERLAY: Cloud Sync Divergence Conflict Resolution Wizard  -->
        <!-- ================================================================ -->
        <Grid Grid.Row="0"
              Grid.RowSpan="4"
              Background="#66000000"
              Visibility="{Binding IsDivergenceModalOpen, Converter={StaticResource BoolToVis}}">
            <Border MaxWidth="620"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="20"
                    Padding="22"
                    CornerRadius="14"
                    Background="{DynamicResource FloatingMenuBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.24" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="检测到双端存档分叉冲突"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningAmberBrush}" />
                    <TextBlock Text="本机与另一台设备离线推进了不同的游戏进度。SPAWN 绝不静默覆盖，无论您选择哪一项，另一端历史都会完整保留为固定路线（★）显示在存档树中；采用云端前若检测到未备份磁盘改动也会自动保护。"
                               FontSize="12.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,10" />

                    <Border CornerRadius="6"
                            Background="{DynamicResource SubtleSurfaceBrush}"
                            Padding="10,5"
                            Margin="0,0,0,12">
                        <TextBlock Text="{Binding CommonAncestorSummaryText}"
                                   FontFamily="{StaticResource SpawnMonoFont}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Border>

                    <!-- Dual-Column Visual Fork Comparison -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                CornerRadius="8"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource SaveBranchLane0Brush}"
                                BorderThickness="1.2"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{Binding LocalDivergenceCardTitle}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SaveBranchLane0Brush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LocalDivergenceCardDetails}"
                                           FontFamily="{StaticResource SpawnMonoFont}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                CornerRadius="8"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource SaveBranchLane1Brush}"
                                BorderThickness="1.2"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{Binding RemoteDivergenceCardTitle}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SaveBranchLane1Brush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RemoteDivergenceCardDetails}"
                                           FontFamily="{StaticResource SpawnMonoFont}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 3 Non-Destructive Resolution Choices -->
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="34"
                                Padding="12,0"
                                Margin="0,4,8,0"
                                Content="暂不同步"
                                Command="{Binding CancelDivergenceModalCommand}" />
                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="34"
                                Padding="12,0"
                                Margin="0,4,8,0"
                                Content="以本机为准（远端保留为 ★ 分支）"
                                Command="{Binding ResolveDivergenceKeepLocalCommand}" />
                        <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                Height="34"
                                Padding="16,0"
                                Margin="0,4,0,0"
                                Content="保留本机为 ★ 分支并采用远端（推荐）"
                                Command="{Binding ResolveDivergenceAdoptRemoteCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
