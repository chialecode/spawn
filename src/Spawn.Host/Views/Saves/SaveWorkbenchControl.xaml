<UserControl x:Class="Spawn.Host.Views.Saves.SaveWorkbenchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Spawn.Host.Converters"
             xmlns:controls="clr-namespace:Spawn.Host.Controls"
             xmlns:savesVm="clr-namespace:Spawn.Host.ViewModels.Saves"
             FontFamily="{DynamicResource SpawnUiFont}"
             Foreground="{DynamicResource PrimaryTextBrush}"
             Background="{DynamicResource PageBackgroundBrush}"
             Typography.NumeralAlignment="Tabular"
             SizeChanged="OnControlSizeChanged"
             PreviewKeyDown="OnControlPreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:EqualityToVisibilityConverter x:Key="EqToVis" />
        <conv:EqualityToBooleanConverter x:Key="EqToBool" />

        <Style x:Key="SaveMorePopupToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource CapsuleInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                CornerRadius="17"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="3.2" Height="3.2" Fill="{TemplateBinding Foreground}" Margin="1.3,0" />
                                <Ellipse Width="3.2" Height="3.2" Fill="{TemplateBinding Foreground}" Margin="1.3,0" />
                                <Ellipse Width="3.2" Height="3.2" Fill="{TemplateBinding Foreground}" Margin="1.3,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SaveThemeComboBoxStyle is shared from Themes/Controls.xaml -->

        <!-- Compact Filter Chip RadioButton Style -->
        <Style x:Key="SaveFilterChipRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                CornerRadius="14"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Reusable Node Inspector Content Template (Used in Right Drawer & Compact Overlay) -->
        <DataTemplate x:Key="NodeInspectorBodyTemplate" DataType="{x:Type savesVm:SaveWorkbenchViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Inspector Header: Note + Badges + Inline Edit -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,12">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button Style="{StaticResource SubtleIconButtonStyle}"
                                    DockPanel.Dock="Left"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,6,0"
                                    ToolTip="返回存档树"
                                    Command="{Binding CloseCompactInspectorCommand}"
                                    Visibility="{Binding IsCompactLayout, Converter={StaticResource BoolToVis}}">
                                <Path Data="M15,4 L7,12 L15,20 M7.5,12 H20"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      Width="14"
                                      Height="14" />
                            </Button>

                            <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="4"
                                        Background="{DynamicResource RunningGreenSoftBrush}"
                                        Padding="6,1.5"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding SelectedNode.IsHead, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedNode.HeadBadgeText}"
                                               FontFamily="{StaticResource SpawnMonoFont}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource RunningGreenBrush}" />
                                </Border>
                                <Border CornerRadius="4"
                                        Background="{DynamicResource WarningAmberSoftBrush}"
                                        Padding="6,1.5"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding SelectedNode.IsPinned, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="★ 已固定"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SavePinStarBrush}" />
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="节点详情"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Display Note OR Inline Edit Note Box -->
                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsEditingNote, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="{Binding SelectedNode.DisplayTitle}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsEditingNote, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding EditNoteInput, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     Padding="8,4"
                                     FontSize="13"
                                     Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                     BorderBrush="{DynamicResource AccentBrush}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                        Height="26"
                                        Padding="12,0"
                                        FontSize="12"
                                        Content="保存备注"
                                        Margin="0,0,6,0"
                                        Command="{Binding SaveEditNoteCommand}" />
                                <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                        Height="26"
                                        Padding="10,0"
                                        FontSize="12"
                                        Content="取消"
                                        Command="{Binding CancelEditNoteCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Tabular Metadata Summary -->
                        <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border CornerRadius="4"
                                    Background="{DynamicResource SubtleSurfaceBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    Padding="6,1"
                                    Margin="0,0,6,4">
                                <TextBlock Text="{Binding SelectedNode.BranchName}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <Border CornerRadius="4"
                                    Background="{DynamicResource SubtleSurfaceBrush}"
                                    Padding="6,1"
                                    Margin="0,0,6,4">
                                <TextBlock Text="{Binding SelectedNode.TriggerLabel}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Border>
                            <TextBlock Text="{Binding SelectedNode.ShortId}"
                                       FontFamily="{StaticResource SpawnMonoFont}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,4" />
                        </WrapPanel>

                        <TextBlock FontFamily="{StaticResource SpawnMonoFont}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,3,0,0">
                            <Run Text="{Binding SelectedNode.TimestampFullText, Mode=OneWay}" />
                            <Run Text=" · 游玩 " />
                            <Run Text="{Binding SelectedNode.PlaytimeText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontFamily="{StaticResource SpawnMonoFont}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0">
                            <Run Text="{Binding SelectedNode.FileCountText, Mode=OneWay}" />
                            <Run Text=" · 原始 " />
                            <Run Text="{Binding SelectedNode.SizeText, Mode=OneWay}" />
                            <Run Text=" · 实占 " />
                            <Run Text="{Binding SelectedNode.StoredSizeText, Mode=OneWay}" />
                        </TextBlock>

                        <!-- Jump to Parent Link -->
                        <Button Style="{StaticResource AccentLinkButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,5,0,0"
                                Command="{Binding JumpToParentSnapshotCommand}"
                                Visibility="{Binding SelectedNode.HasParent, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontFamily="{StaticResource SpawnMonoFont}"
                                       FontSize="11.5"
                                       Text="↳ 跳转至父节点快照" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Inspector Action Strip (Single Primary CTA + Fork Secondary + ⋯ Popup via PlacementTarget.Tag) -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                Height="32"
                                Padding="14,0"
                                FontSize="12.5"
                                Margin="0,0,6,4"
                                Content="回滚到此节点"
                                ToolTip="{Binding RollbackButtonToolTip}"
                                Command="{Binding RequestRollbackSelectedCommand}"
                                IsEnabled="{Binding CanRollbackSelected}" />

                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="32"
                                Padding="12,0"
                                FontSize="12.5"
                                Margin="0,0,6,4"
                                Content="从此节点分叉"
                                Command="{Binding OpenForkPopoverFromSelectedCommand}"
                                IsEnabled="{Binding CanForkFromSelected}" />

                        <Grid Margin="0,0,0,4" VerticalAlignment="Center">
                            <ToggleButton x:Name="NodeInspectorMoreToggle"
                                          Style="{StaticResource SaveMorePopupToggleStyle}"
                                          Width="32"
                                          Height="32"
                                          Tag="{Binding}"
                                          ToolTip="更多节点操作"
                                          AutomationProperties.Name="更多节点操作" />
                            <Popup IsOpen="{Binding IsChecked, ElementName=NodeInspectorMoreToggle, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=NodeInspectorMoreToggle}"
                                   DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                   Placement="Bottom"
                                   HorizontalOffset="-178"
                                   VerticalOffset="6"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Opened="OnManagedPopupOpened"
                                   Closed="OnManagedPopupClosed">
                                <Border Width="212"
                                        Margin="8"
                                        Padding="6"
                                        CornerRadius="12"
                                        Background="{DynamicResource FloatingMenuBackgroundBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.16" Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                Content="{Binding SelectedNodePinActionText}"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding TogglePinSelectedCommand}" />
                                        <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                Content="编辑备注"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding BeginEditNoteCommand}" />
                                        <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                Content="导出快照副本到文件夹…"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding ExportSelectedSnapshotCommand}" />
                                        <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                                Content="打开游戏存档目录"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding OpenSaveFolderCommand}" />
                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="6,4" />
                                        <Button Style="{StaticResource DangerMenuItemButtonStyle}"
                                                Content="删除此快照"
                                                Click="OnAnyPopupMenuItemClick"
                                                Command="{Binding DeleteSelectedSnapshotCommand}"
                                                IsEnabled="{Binding CanDeleteSelectedSnapshot}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </WrapPanel>
                </Border>

                <!-- Inline Rollback Confirmation Card -->
                <Border Grid.Row="2"
                        Background="{DynamicResource WarningSoftBannerBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningSoftBannerBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10"
                        Visibility="{Binding IsRollbackConfirmOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="确认回滚到此存档快照？"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningAmberBrush}" />
                        <TextBlock Text="回滚前将自动为当前磁盘存档创建「回滚安全点」快照，再采用先写暂存后批量替换的原子回滚。"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,6" />
                        <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                  Content="同时还原 [config] 配置文件（默认仅还原 [save]）"
                                  FontSize="12"
                                  IsChecked="{Binding RollbackIncludeConfig, Mode=TwoWay}"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="{Binding RollbackModMismatchWarning}"
                                   FontSize="12"
                                   Foreground="{DynamicResource DangerTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding RollbackRequiresModMismatchConfirm, Converter={StaticResource BoolToVis}}" />

                        <WrapPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                    Height="28"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,6,0"
                                    Content="确认原子回滚"
                                    Command="{Binding ConfirmRollbackSelectedCommand}"
                                    Visibility="{Binding RollbackRequiresModMismatchConfirm, Converter={StaticResource InvBoolToVis}}" />
                            <Button Style="{StaticResource WarningPrimaryCapsuleButtonStyle}"
                                    Height="28"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,6,0"
                                    Content="忽略 Mod 差异强制回滚"
                                    Command="{Binding ForceRollbackIgnoringModMismatchCommand}"
                                    Visibility="{Binding RollbackRequiresModMismatchConfirm, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                    Height="28"
                                    Padding="10,0"
                                    FontSize="12"
                                    Content="取消"
                                    Command="{Binding CancelRollbackConfirmCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Inspector Sub-Tabs: 文件清单 | 变更对比 -->
                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                     GroupName="SaveInspectorSubTabs"
                                     FontSize="12.5"
                                     Padding="2,7"
                                     Margin="0,0,18,0"
                                     Content="文件清单"
                                     IsChecked="{Binding InspectorTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static savesVm:SaveInspectorTab.Files}}" />
                        <RadioButton Style="{StaticResource UnderlineTabRadioStyle}"
                                     GroupName="SaveInspectorSubTabs"
                                     FontSize="12.5"
                                     Padding="2,7"
                                     Content="变更对比"
                                     IsChecked="{Binding InspectorTab, Converter={StaticResource EqToBool}, ConverterParameter={x:Static savesVm:SaveInspectorTab.Diff}}" />
                    </StackPanel>
                </Border>

                <!-- Inspector Viewport: Files List OR Diff List -->
                <Grid Grid.Row="4">
                    <!-- Tab A: Files -->
                    <ListBox ItemsSource="{Binding SelectedNodeFiles}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12,8,10,16"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             Visibility="{Binding ShowFilesInspectorTab, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter HorizontalAlignment="Stretch" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type savesVm:SaveFileEntryViewModel}">
                                <Border BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,7">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Left"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SaveTagSaveBgBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfigCategory}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SaveTagConfigBgBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsRegistryCategory}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SaveTagRegistryBgBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding CategoryTag}"
                                                           FontFamily="{StaticResource SpawnMonoFont}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SaveTagSaveFgBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConfigCategory}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SaveTagConfigFgBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsRegistryCategory}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SaveTagRegistryFgBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding FileSizeText}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Text="{Binding LogicalPath}"
                                                       ToolTip="{Binding OriginalPath}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>

                                        <TextBlock FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="0,2,0,0">
                                            <Run Text="BLAKE3 " />
                                            <Run Text="{Binding ShortHash, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding LastWriteText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Tab B: Diff Viewer -->
                    <Grid Visibility="{Binding ShowDiffInspectorTab, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="12,8,12,4">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SaveFilterChipRadioStyle}"
                                             GroupName="SaveDiffTargetModeGroup"
                                             Height="24"
                                             FontSize="11.5"
                                             Content="对比父节点"
                                             IsChecked="{Binding DiffTargetMode, Converter={StaticResource EqToBool}, ConverterParameter={x:Static savesVm:SaveDiffTargetMode.Parent}}" />
                                <RadioButton Style="{StaticResource SaveFilterChipRadioStyle}"
                                             GroupName="SaveDiffTargetModeGroup"
                                             Height="24"
                                             FontSize="11.5"
                                             Content="对比当前磁盘"
                                             IsChecked="{Binding DiffTargetMode, Converter={StaticResource EqToBool}, ConverterParameter={x:Static savesVm:SaveDiffTargetMode.CurrentDisk}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding DiffSummaryText}"
                                       FontFamily="{StaticResource SpawnMonoFont}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding SelectedNodeDiffItems}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="12,4,10,16"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="Stretch" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type savesVm:SaveDiffEntryViewModel}">
                                    <Border BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,6">
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Left"
                                                    Width="20"
                                                    Height="20"
                                                    CornerRadius="4"
                                                    Margin="0,0,7,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource DiffModifiedSoftBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource DiffAddedSoftBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource DiffRemovedSoftBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding DiffGlyph}"
                                                           FontFamily="{StaticResource SpawnMonoFont}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource DiffModifiedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DiffAddedBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DiffRemovedBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding SizeDeltaText}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Text="{Binding LogicalPath}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="1"
                                   Text="与对比目标之间无文件变更（内容完全一致）"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="12,24,12,0"
                                   Visibility="{Binding HasSelectedNodeDiffItems, Converter={StaticResource InvBoolToVis}}" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Root Grid with Modal Overlay Support -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Branch Switcher Bar + Single Primary CTA + ⋯ -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Auto-Backup Toggles & Cloud Status Strip -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Optional Inline Popovers (Fork / Rename Branch / Cloud Sync Drawer) -->
            <RowDefinition Height="Auto" />
            <!-- Row 3 (*): Split Viewport (Left Branching Tree List + Right Responsive Node Inspector) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!-- ROW 0: Branch Management Bar + Single Primary CTA (创建快照)      -->
        <!-- ================================================================ -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,10,0,10">
            <DockPanel LastChildFill="False">
                <!-- Left: Active Branch Selector + New Branch + Branch ⋯ -->
                <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Height="34"
                            CornerRadius="8"
                            Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            Padding="8,0,4,0"
                            Margin="0,2,8,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="{Binding ActiveBranchColorBrush}"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="分支"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,5,0"
                                       VerticalAlignment="Center" />
                            <ComboBox Style="{StaticResource SaveThemeComboBoxStyle}"
                                      Width="154"
                                      Height="26"
                                      FontSize="12.5"
                                      FontWeight="SemiBold"
                                      ItemsSource="{Binding Branches}"
                                      SelectedItem="{Binding ActiveBranch, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayLabel"
                                      AutomationProperties.Name="切换当前存档分支" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                            Height="34"
                            Padding="12,0"
                            FontSize="12.5"
                            Margin="0,2,6,2"
                            Content="新建分叉"
                            Command="{Binding OpenForkPopoverFromSelectedCommand}"
                            IsEnabled="{Binding CanCreateSnapshot}" />

                    <!-- Branch Management ⋯ Popup (PlacementTarget.Tag bridged!) -->
                    <Grid Margin="0,2,10,2" VerticalAlignment="Center">
                        <ToggleButton x:Name="BranchMoreToggle"
                                      Style="{StaticResource SaveMorePopupToggleStyle}"
                                      Tag="{Binding}"
                                      ToolTip="分支管理操作"
                                      AutomationProperties.Name="分支管理操作" />
                        <Popup IsOpen="{Binding IsChecked, ElementName=BranchMoreToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=BranchMoreToggle}"
                               DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                               Placement="Bottom"
                               HorizontalOffset="-10"
                               VerticalOffset="6"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Opened="OnManagedPopupOpened"
                               Closed="OnManagedPopupClosed">
                            <Border Width="210"
                                    Margin="8"
                                    Padding="6"
                                    CornerRadius="12"
                                    Background="{DynamicResource FloatingMenuBackgroundBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.16" Color="#000000" />
                                </Border.Effect>
                                <StackPanel>
                                    <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                            Content="从当前 HEAD 新建分支"
                                            Click="OnAnyPopupMenuItemClick"
                                            Command="{Binding OpenForkPopoverFromHeadCommand}" />
                                    <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                            Content="重命名 / 修改分支颜色"
                                            Click="OnAnyPopupMenuItemClick"
                                            Command="{Binding OpenRenameBranchPopoverCommand}" />
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="6,4" />
                                    <Button Style="{StaticResource DangerMenuItemButtonStyle}"
                                            Content="切回主分支并删除当前分支"
                                            ToolTip="自动切回默认主分支并删除当前分支及其未固定快照"
                                            Click="OnAnyPopupMenuItemClick"
                                            Command="{Binding DeleteActiveBranchCommand}"
                                            IsEnabled="{Binding CanDeleteActiveBranch}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </WrapPanel>

                <!-- Right: Quick Note Input + SINGLE Primary CTA (创建快照) + Workbench ⋯ -->
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="188"
                            Height="34"
                            CornerRadius="17"
                            Background="{DynamicResource CapsuleInputBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            Padding="11,0"
                            Margin="0,2,8,2">
                        <Grid>
                            <TextBlock Text="快照备注（可选）…"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding QuickSnapshotNote, Converter={StaticResource StrNotEmptyToVis}, ConverterParameter=Invert}" />
                            <TextBox Text="{Binding QuickSnapshotNote, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     FontSize="12"
                                     VerticalContentAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- SINGLE Primary Action Button in Toolbar -->
                    <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                            Height="34"
                            Padding="16,0"
                            FontSize="13"
                            Margin="0,2,6,2"
                            Content="创建快照"
                            Command="{Binding CreateSnapshotCommand}"
                            IsEnabled="{Binding CanCreateSnapshot}" />

                    <!-- Workbench ⋯ Popup (PlacementTarget.Tag bridged!) -->
                    <Grid Margin="0,2,0,2" VerticalAlignment="Center">
                        <ToggleButton x:Name="SaveWorkbenchMoreToggle"
                                      Style="{StaticResource SaveMorePopupToggleStyle}"
                                      Tag="{Binding}"
                                      ToolTip="更多存档操作"
                                      AutomationProperties.Name="更多存档操作" />
                        <Popup IsOpen="{Binding IsChecked, ElementName=SaveWorkbenchMoreToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=SaveWorkbenchMoreToggle}"
                               DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                               Placement="Bottom"
                               HorizontalOffset="-206"
                               VerticalOffset="6"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Opened="OnManagedPopupOpened"
                               Closed="OnManagedPopupClosed">
                            <Border Width="244"
                                    Margin="8"
                                    Padding="6"
                                    CornerRadius="12"
                                    Background="{DynamicResource FloatingMenuBackgroundBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.16" Color="#000000" />
                                </Border.Effect>
                                <StackPanel>
                                    <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                              Margin="10,6,8,6"
                                              FontSize="12.5"
                                              Content="手动快照同时包含 [config]"
                                              IsChecked="{Binding IncludeConfigOnSnapshot, Mode=TwoWay}" />
                                    <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                              Margin="10,2,8,6"
                                              FontSize="12.5"
                                              Content="创建后立即固定 (★)"
                                              IsChecked="{Binding PinNewSnapshot, Mode=TwoWay}" />
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="6,4" />
                                    <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                            Content="云同步面板（32MB SPPK）"
                                            Click="OnAnyPopupMenuItemClick"
                                            Command="{Binding ToggleCloudDrawerCommand}" />
                                    <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                            Content="刷新 Ludusavi 存档路径探测"
                                            Click="OnAnyPopupMenuItemClick"
                                            Command="{Binding RefreshSaveLocationsCommand}" />
                                    <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                            Content="导入旧版修改器前快照"
                                            Click="OnAnyPopupMenuItemClick"
                                            Command="{Binding ImportLegacyPreTrainerSnapshotsCommand}" />
                                    <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                            Content="打开游戏存档文件夹"
                                            Click="OnAnyPopupMenuItemClick"
                                            Command="{Binding OpenSaveFolderCommand}" />
                                    <Button Style="{StaticResource FloatingMenuItemButtonStyle}"
                                            Content="存档与云同步全局设置…"
                                            Click="OnAnyPopupMenuItemClick"
                                            Command="{Binding OpenSavesSettingsCommand}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ================================================================ -->
        <!-- ROW 1: Auto-Backup Toggles + Filter Chips + Cloud Sync Chip      -->
        <!-- ================================================================ -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,8">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <!-- Left: Filter Chips + IME-Guarded Search -->
                    <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource SaveFilterChipRadioStyle}"
                                     GroupName="SaveTreeFilterChips"
                                     Content="全部树"
                                     IsChecked="{Binding TreeFilterMode, Converter={StaticResource EqToBool}, ConverterParameter={x:Static controls:SaveTreeFilterMode.All}}" />
                        <RadioButton Style="{StaticResource SaveFilterChipRadioStyle}"
                                     GroupName="SaveTreeFilterChips"
                                     Content="当前分支"
                                     IsChecked="{Binding TreeFilterMode, Converter={StaticResource EqToBool}, ConverterParameter={x:Static controls:SaveTreeFilterMode.CurrentBranch}}" />
                        <RadioButton Style="{StaticResource SaveFilterChipRadioStyle}"
                                     GroupName="SaveTreeFilterChips"
                                     Content="★ 已固定"
                                     IsChecked="{Binding TreeFilterMode, Converter={StaticResource EqToBool}, ConverterParameter={x:Static controls:SaveTreeFilterMode.PinnedOnly}}" />

                        <Border Width="168"
                                Height="28"
                                Margin="4,0,0,0"
                                CornerRadius="14"
                                Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                Padding="9,0,6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="筛选备注 / 分支 / 哈希…"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding TreeSearchText, Converter={StaticResource StrNotEmptyToVis}, ConverterParameter=Invert}" />
                                <TextBox x:Name="TreeSearchTextBox"
                                         Grid.Column="0"
                                         Text="{Binding TreeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         FontSize="11.5"
                                         VerticalContentAlignment="Center"
                                         PreviewKeyDown="OnTreeSearchPreviewKeyDown" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource SubtleIconButtonStyle}"
                                        Width="18"
                                        Height="18"
                                        Command="{Binding ClearTreeSearchCommand}"
                                        Visibility="{Binding TreeSearchText, Converter={StaticResource StrNotEmptyToVis}}">
                                    <Path Data="M0,0 L6,6 M6,0 L0,6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.3"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </Border>
                    </WrapPanel>

                    <!-- Right: Auto-Backup Toggles & Cloud Sync Drawer Toggle -->
                    <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                  Content="退出自动备份"
                                  FontSize="12"
                                  Margin="0,2,12,2"
                                  IsChecked="{Binding PostExitSnapshotEnabled, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                  Content="静默防撕裂热备"
                                  FontSize="12"
                                  Margin="0,2,12,2"
                                  IsChecked="{Binding AutoWatchEnabled, Mode=TwoWay}" />
                        <Button Height="28"
                                Padding="11,0"
                                FontSize="12"
                                Margin="0,2,0,2"
                                Command="{Binding ToggleCloudDrawerCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryCapsuleButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnresolvedCloudConflict}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WarningAmberSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningAmberBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource WarningAmberBrush}" />
                                        </DataTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding CloudStatusChipText}" FontWeight="SemiBold" />
                        </Button>
                    </WrapPanel>
                </DockPanel>

                <!-- Sub-metrics hairline summary -->
                <DockPanel LastChildFill="False" Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding TreeMetricsSummaryText}"
                               FontFamily="{StaticResource SpawnMonoFont}"
                               FontSize="11.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="8,0,5,0"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWatcherActive}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource RunningGreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ResolvedLocationsSummaryText}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ================================================================ -->
        <!-- ROW 2: Inline Fork / Rename Panels & Collapsible Cloud Drawer    -->
        <!-- ================================================================ -->
        <StackPanel Grid.Row="2">
            <!-- Busy Banner -->
            <Border Background="{DynamicResource InfoBannerBackgroundBrush}"
                    BorderBrush="{DynamicResource InfoBannerBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,6"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding BusyMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource AccentBrush}" />
            </Border>

            <!-- Fork New Branch Inline Panel -->
            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,11"
                    Margin="0,8,0,0"
                    Visibility="{Binding IsForkPanelOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="创建新存档分支（分叉时间线）"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock DockPanel.Dock="Right"
                                   FontFamily="{StaticResource SpawnMonoFont}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}">
                            <Run Text="分叉起点：" />
                            <Run Text="{Binding ForkSourceLabel, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>

                    <WrapPanel Orientation="Horizontal" Margin="0,9,0,0" VerticalAlignment="Center">
                        <TextBox Width="196"
                                 Height="30"
                                 Padding="9,4"
                                 Margin="0,0,10,6"
                                 FontSize="12.5"
                                 Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}"
                                 BorderThickness="1"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 Text="{Binding ForkBranchNameInput, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="输入新分支名称（例如 boss-rush、bad-ending）" />

                        <!-- 8-Color Lane Swatch Picker -->
                        <ItemsControl ItemsSource="{Binding BranchColorPalette}" Margin="0,0,12,6" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type savesVm:SaveBranchColorOption}">
                                    <Button Cursor="Hand"
                                            Width="22"
                                            Height="22"
                                            Margin="2,0"
                                            ToolTip="{Binding Label}"
                                            FocusVisualStyle="{x:Null}"
                                            Command="{Binding DataContext.SelectForkColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding ColorHex}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="11"
                                                        Background="{Binding SwatchBrush}"
                                                        BorderBrush="{DynamicResource PageBackgroundBrush}"
                                                        BorderThickness="2" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                  Content="分叉后立即切换并检出"
                                  FontSize="12"
                                  Margin="0,0,12,6"
                                  IsChecked="{Binding SwitchToForkedBranch, Mode=TwoWay}"
                                  IsEnabled="{Binding IsSelectedGameRunning, Converter={StaticResource EqToBool}, ConverterParameter=False}" />

                        <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                Height="30"
                                Padding="14,0"
                                FontSize="12.5"
                                Margin="0,0,6,6"
                                Content="创建分支"
                                Command="{Binding ConfirmForkBranchCommand}" />
                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="30"
                                Padding="12,0"
                                FontSize="12.5"
                                Margin="0,0,0,6"
                                Content="取消"
                                Command="{Binding CancelForkPopoverCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Rename Branch Inline Panel -->
            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,8,0,0"
                    Visibility="{Binding IsRenameBranchPanelOpen, Converter={StaticResource BoolToVis}}">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="重命名当前分支："
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,4" />
                    <TextBox Width="184"
                             Height="30"
                             Padding="9,4"
                             Margin="0,0,10,4"
                             FontSize="12.5"
                             Background="{DynamicResource CapsuleInputBackgroundBrush}"
                             BorderBrush="{DynamicResource ControlBorderBrush}"
                             BorderThickness="1"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             Text="{Binding RenameBranchNameInput, UpdateSourceTrigger=PropertyChanged}" />
                    <ItemsControl ItemsSource="{Binding BranchColorPalette}" Margin="0,0,12,4" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type savesVm:SaveBranchColorOption}">
                                <Button Cursor="Hand"
                                        Width="20"
                                        Height="20"
                                        Margin="2,0"
                                        ToolTip="{Binding Label}"
                                        FocusVisualStyle="{x:Null}"
                                        Command="{Binding DataContext.SelectRenameBranchColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding ColorHex}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="10"
                                                    Background="{Binding SwatchBrush}"
                                                    BorderBrush="{DynamicResource PageBackgroundBrush}"
                                                    BorderThickness="1.5" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                            Height="28"
                            Padding="12,0"
                            FontSize="12"
                            Margin="0,0,6,4"
                            Content="保存"
                            Command="{Binding ConfirmRenameBranchCommand}" />
                    <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                            Height="28"
                            Padding="10,0"
                            FontSize="12"
                            Margin="0,0,0,4"
                            Content="取消"
                            Command="{Binding CancelRenameBranchCommand}" />
                </WrapPanel>
            </Border>

            <!-- Collapsible Cloud Sync Drawer (32MB SPPK Plan + Execute) -->
            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,11"
                    Margin="0,8,0,0"
                    Visibility="{Binding IsCloudDrawerOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="去中心化云同步（32MB SPPK 增量封包）"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                            <ComboBox Style="{StaticResource SaveThemeComboBoxStyle}"
                                      Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                      BorderBrush="{DynamicResource ControlBorderBrush}"
                                      BorderThickness="1"
                                      Width="220"
                                      Height="28"
                                      Margin="12,0,8,0"
                                      FontSize="12"
                                      ItemsSource="{Binding AvailableCloudEndpoints}"
                                      SelectedItem="{Binding SelectedCloudEndpoint, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" />
                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                    Height="28"
                                    Padding="10,0"
                                    FontSize="12"
                                    Content="管理云端点"
                                    Command="{Binding OpenSavesSettingsCommand}" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                    Height="28"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,6,0"
                                    Content="检查同步计划"
                                    Command="{Binding PlanCloudSyncCommand}"
                                    IsEnabled="{Binding IsCloudSyncBusy, Converter={StaticResource EqToBool}, ConverterParameter=False}" />
                            <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                    Height="28"
                                    Padding="14,0"
                                    FontSize="12"
                                    Content="执行同步"
                                    Command="{Binding ExecuteCloudSyncCommand}"
                                    IsEnabled="{Binding CanExecuteDirectCloudSync}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="{Binding CloudPlanSummaryText}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{Binding CloudPlanTransferMetricsText}"
                               FontFamily="{StaticResource SpawnMonoFont}"
                               FontSize="11.5"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,3,0,0"
                               Visibility="{Binding CloudPlanTransferMetricsText, Converter={StaticResource StrNotEmptyToVis}}" />

                    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsCloudSyncBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding CloudSyncProgressText}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding CloudSyncProgressPercent, Mode=OneWay}"
                                     Height="5"
                                     Margin="0,4,0,0"
                                     BorderThickness="0"
                                     Background="{DynamicResource DividerBrush}"
                                     Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================================================================ -->
        <!-- ROW 3 (*): Split Branching Save Tree List + Node Inspector       -->
        <!-- ================================================================ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left (*): Virtualized Recycling Branching Save Tree ListBox -->
            <Grid Grid.Column="0">
                <ListBox ItemsSource="{Binding GraphRows}"
                         SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,4,4,20"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.CacheLength="1,1"
                         VirtualizingPanel.CacheLengthUnit="Page"
                         Visibility="{Binding HasVisibleGraphRows, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True"
                                                    VirtualizationMode="Recycling" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="RowSurface"
                                                Height="58"
                                                CornerRadius="8"
                                                Background="Transparent"
                                                Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource SelectedPillBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type savesVm:SaveSnapshotRowViewModel}">
                            <Grid Height="58">
                                <Grid.ColumnDefinitions>
                                    <!-- Dynamic Vector Bezier Graph Lane Column -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Snapshot Branch Pills, Note, Trigger Icon & Tabular Metadata -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Right Status Icons (Pin Star + Cloud Synced) -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Pure Native WPF Vector Bezier Lane & Node Renderer -->
                                <controls:SaveGraphCellControl Grid.Column="0"
                                                               Width="{Binding DataContext.GraphColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Height="58"
                                                               RowLayout="{Binding GraphLayout}"
                                                               IsRowSelected="{Binding IsSelected}"
                                                               SurfaceBackgroundBrush="{DynamicResource PageBackgroundBrush}"
                                                               SelectedSurfaceBrush="{DynamicResource SelectedPillBrush}"
                                                               HeadRingBrush="{DynamicResource SaveHeadRingBrush}"
                                                               PinAccentBrush="{DynamicResource SavePinStarBrush}" />

                                <!-- Middle: Line 1 (Branch Tip Pills + HEAD + Trigger Glyph + Note) & Line 2 (Tabular Mono Meta) -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Branch Tip Pills -->
                                        <ItemsControl ItemsSource="{Binding BranchTipPills}"
                                                      Visibility="{Binding HasBranchTipPills, Converter={StaticResource BoolToVis}}"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type savesVm:SaveBranchTipPillViewModel}">
                                                    <Border CornerRadius="4"
                                                            Background="{Binding SoftBackgroundBrush}"
                                                            BorderBrush="{Binding AccentBrush}"
                                                            BorderThickness="1"
                                                            Padding="6,1"
                                                            Margin="0,0,5,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding AccentBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- HEAD Pill -->
                                        <Border CornerRadius="4"
                                                Background="{DynamicResource RunningGreenSoftBrush}"
                                                Padding="5,1"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsHead, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding HeadBadgeText}"
                                                       FontFamily="{StaticResource SpawnMonoFont}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource RunningGreenBrush}" />
                                        </Border>

                                        <!-- Trigger Icon -->
                                        <Path Data="{Binding TriggerIconPathData}"
                                              Stroke="{DynamicResource SecondaryTextBrush}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Stretch="Uniform"
                                              Width="12"
                                              Height="12"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              ToolTip="{Binding TriggerLabel}" />

                                        <!-- Note / Snapshot Title -->
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Line 2: Tabular Mono Timestamp, Size, File Count, Playtime, Short Hash -->
                                    <TextBlock Text="{Binding MetaLineText}"
                                               FontFamily="{StaticResource SpawnMonoFont}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Right: Pinned Star & Cloud Badge -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="{Binding CloudStatusBadgeText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsCloudSynced, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="★"
                                               FontSize="13"
                                               Foreground="{DynamicResource SavePinStarBrush}"
                                               ToolTip="已固定快照（永不自动滚动清理）"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Gentle Empty State -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420"
                            Visibility="{Binding HasVisibleGraphRows, Converter={StaticResource InvBoolToVis}}">
                    <Border Width="48"
                            Height="48"
                            CornerRadius="12"
                            Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <Path Data="M6,4 V20 M18,6 V10 C18,13 15,14 12,14 H6 M4,6 A2,2 0 1,0 8,6 A2,2 0 1,0 4,6 M16,6 A2,2 0 1,0 20,6 A2,2 0 1,0 16,6 M4,18 A2,2 0 1,0 8,18 A2,2 0 1,0 4,18"
                              Stroke="{DynamicResource MutedTextBrush}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"
                              Width="22"
                              Height="22"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="尚无符合条件的存档快照"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock Text="点击右上角「创建快照」为当前存档建立第一个时间节点，之后可从任意历史节点分叉出多条剧情线或挑战分支。"
                               FontSize="12.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <!-- Right (Desktop >= 740 DIP): Fixed 348px Hairline-Separated Node Inspector -->
            <Border Grid.Column="1"
                    Width="348"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1,0,0,0"
                    Background="{DynamicResource PageBackgroundBrush}"
                    Visibility="{Binding ShowDesktopInspector, Converter={StaticResource BoolToVis}}">
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource NodeInspectorBodyTemplate}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>

            <!-- Compact (< 740 DIP): Slide-Over Inspector Overlay -->
            <Border Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="{DynamicResource PageBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowCompactInspectorOverlay, Converter={StaticResource BoolToVis}}">
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource NodeInspectorBodyTemplate}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>
        </Grid>

        <!-- ================================================================ -->
        <!-- MODAL OVERLAY: Cloud Sync Divergence Conflict Resolution Wizard  -->
        <!-- ================================================================ -->
        <Grid Grid.Row="0"
              Grid.RowSpan="4"
              Background="#66000000"
              Visibility="{Binding IsDivergenceModalOpen, Converter={StaticResource BoolToVis}}">
            <Border MaxWidth="620"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="20"
                    Padding="22"
                    CornerRadius="14"
                    Background="{DynamicResource FloatingMenuBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.24" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="检测到双端存档分叉冲突（Divergence Wizard）"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningAmberBrush}" />
                    <TextBlock Text="本机与远端设备离线推进了不同的存档进度，互不为祖先。SPAWN 绝不静默覆盖，无论您选择哪一项，另一端历史都会完整保留为固定分支（★）显示在存档树中。"
                               FontSize="12.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,10" />

                    <Border CornerRadius="6"
                            Background="{DynamicResource SubtleSurfaceBrush}"
                            Padding="10,5"
                            Margin="0,0,0,12">
                        <TextBlock Text="{Binding CommonAncestorSummaryText}"
                                   FontFamily="{StaticResource SpawnMonoFont}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Border>

                    <!-- Dual-Column Visual Fork Comparison -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                CornerRadius="8"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource SaveBranchLane0Brush}"
                                BorderThickness="1.2"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{Binding LocalDivergenceCardTitle}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SaveBranchLane0Brush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LocalDivergenceCardDetails}"
                                           FontFamily="{StaticResource SpawnMonoFont}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                CornerRadius="8"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource SaveBranchLane1Brush}"
                                BorderThickness="1.2"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{Binding RemoteDivergenceCardTitle}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SaveBranchLane1Brush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RemoteDivergenceCardDetails}"
                                           FontFamily="{StaticResource SpawnMonoFont}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 3 Non-Destructive Resolution Choices -->
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="34"
                                Padding="12,0"
                                Margin="0,4,8,0"
                                Content="暂不同步"
                                Command="{Binding CancelDivergenceModalCommand}" />
                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="34"
                                Padding="12,0"
                                Margin="0,4,8,0"
                                Content="以本机为准（远端保留为 ★ 分支）"
                                Command="{Binding ResolveDivergenceKeepLocalCommand}" />
                        <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                Height="34"
                                Padding="16,0"
                                Margin="0,4,0,0"
                                Content="保留本机为 ★ 分支并采用远端（推荐）"
                                Command="{Binding ResolveDivergenceAdoptRemoteCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
