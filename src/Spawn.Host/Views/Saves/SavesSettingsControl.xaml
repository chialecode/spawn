<UserControl x:Class="Spawn.Host.Views.Saves.SavesSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Spawn.Host.Converters"
             xmlns:contracts="clr-namespace:Spawn.Contracts;assembly=Spawn.Contracts"
             xmlns:savesVm="clr-namespace:Spawn.Host.ViewModels.Saves"
             FontFamily="{DynamicResource SpawnUiFont}"
             Foreground="{DynamicResource PrimaryTextBrush}"
             Typography.NumeralAlignment="Tabular">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Spawn.Host;component/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
            <conv:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis" />
            <conv:EqualityToVisibilityConverter x:Key="EqToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- 1. Global Auto-Backup & Anti-Tear Quiescent Watcher Defaults -->
        <Border BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,12,0,16">
            <StackPanel>
                <TextBlock Text="全局存档时间机器默认策略" FontSize="14.5" FontWeight="SemiBold" />
                <TextBlock Text="支持 FastCDC + BLAKE3 + Zstd 块级去重与多分支树状存档；新入库游戏默认继承下方策略。"
                           FontSize="12.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,12" />

                <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                          Content="游戏运行期间启用防撕裂静默热备（文件停止写入后自动增量快照）"
                          IsChecked="{Binding SaveAutoWatchByDefault, Mode=TwoWay}" />

                <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                          Content="游戏退出后自动创建退出存档快照（内容无变化时自动跳过）"
                          IsChecked="{Binding SavePostExitSnapshotByDefault, Mode=TwoWay}"
                          Margin="0,10,0,0" />

                <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                          Content="快照默认包含 [config] 配置文件（云同步仍严格仅传 [save] 防跨机分辨率冲突）"
                          IsChecked="{Binding SaveIncludeConfigByDefault, Mode=TwoWay}"
                          Margin="0,10,0,0" />

                <DockPanel LastChildFill="False" Margin="0,14,0,0">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                        <TextBlock Text="防撕裂静默等待窗口（500–15000 ms）" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock Text="默认 2500 ms：等待游戏写完整个存档后再采样，并执行前后元数据双校验。"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Width="160"
                                Minimum="500"
                                Maximum="15000"
                                TickFrequency="500"
                                IsSnapToTickEnabled="True"
                                Value="{Binding SaveQuiescentDebounceMs, Mode=TwoWay}"
                                VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SaveQuiescentDebounceDisplayText}"
                                   FontFamily="{StaticResource SpawnMonoFont}"
                                   FontSize="12.5"
                                   Width="72"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,4" VerticalAlignment="Center">
                        <TextBlock Text="非固定快照滚动保留上限："
                                   FontSize="12.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox Style="{StaticResource SaveThemeComboBoxStyle}"
                                  Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                  BorderBrush="{DynamicResource ControlBorderBrush}"
                                  BorderThickness="1"
                                  Width="136"
                                  Height="30"
                                  Margin="6,0,0,0"
                                  ItemsSource="{Binding SaveRollingRetentionOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SaveDefaultMaxRollingSnapshots, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                        <TextBlock Text="单次快照体积上限："
                                   FontSize="12.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox Style="{StaticResource SaveThemeComboBoxStyle}"
                                  Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                  BorderBrush="{DynamicResource ControlBorderBrush}"
                                  BorderThickness="1"
                                  Width="136"
                                  Height="30"
                                  Margin="6,0,0,0"
                                  ItemsSource="{Binding SaveMaxSnapshotSizeMbOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SaveDefaultMaxSnapshotSizeMb, Mode=TwoWay}" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 2. Ludusavi Precompiled Rule Index & CAS Vault GC -->
        <Border BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,16">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="520">
                        <TextBlock Text="Ludusavi 预编译存档规则与本地 CAS 块库" FontSize="14.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SaveLudusaviAndVaultSummaryText}"
                                   FontFamily="{StaticResource SpawnMonoFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="30"
                                Padding="12,0"
                                FontSize="12"
                                Margin="0,2,8,2"
                                Content="导入 Ludusavi 规则 JSON…"
                                Command="{Binding ImportLudusaviRulesJsonCommand}" />
                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                Height="30"
                                Padding="12,0"
                                FontSize="12"
                                Margin="0,2,0,2"
                                Content="清理未引用块 (GC)"
                                Command="{Binding RunSaveCasGcCommand}" />
                    </WrapPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 3. Decentralized Cloud Sync Endpoints (LocalFolder / WebDAV / S3) -->
        <Border Padding="0,16,0,0">
            <StackPanel>
                <TextBlock Text="去中心化云同步端点（32MB SPPK · 本地目录 / WebDAV / S3）"
                           FontSize="14.5"
                           FontWeight="SemiBold" />
                <TextBlock Text="同步只上传不可变 32MB SPPK 数据包与 JSON 血缘指针，严禁同步 spawn.db；访问密钥经 Windows CurrentUser DPAPI 加密存为独立 .sec 文件。"
                           FontSize="12.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,12" />

                <!-- Configured Endpoints List -->
                <ItemsControl ItemsSource="{Binding CloudSyncEndpoints}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type savesVm:CloudEndpointItemViewModel}">
                            <Border CornerRadius="8"
                                    Background="{DynamicResource SubtleSurfaceBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    Padding="12,10"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border CornerRadius="4"
                                                    Background="{DynamicResource SelectedPillBrush}"
                                                    Padding="6,1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="默认端点"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding SummaryLine}"
                                                   FontFamily="{StaticResource SpawnMonoFont}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding SecretStatusText}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding LastTestResultText}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,3,0,0"
                                                   Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Height="28"
                                                Padding="10,0"
                                                FontSize="12"
                                                Margin="0,2,6,2"
                                                Content="测试连接"
                                                Command="{Binding DataContext.TestCloudEndpointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                                Height="28"
                                                Padding="10,0"
                                                FontSize="12"
                                                Margin="0,2,0,2"
                                                Foreground="{DynamicResource DangerTextBrush}"
                                                Content="删除"
                                                Command="{Binding DataContext.DeleteCloudEndpointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add New Endpoint Form -->
                <Border CornerRadius="10"
                        Background="{DynamicResource SubtleSurfaceBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="新增云同步端点" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="端点名称" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                                <TextBox Width="180"
                                         Height="30"
                                         Padding="8,4"
                                         FontSize="12.5"
                                         Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         BorderThickness="1"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         Text="{Binding NewCloudEndpointName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="同步协议" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                                <ComboBox Style="{StaticResource SaveThemeComboBoxStyle}"
                                          Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                          BorderBrush="{DynamicResource ControlBorderBrush}"
                                          BorderThickness="1"
                                          Width="188"
                                          Height="30"
                                          ItemsSource="{Binding CloudProviderTypeOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding NewCloudProviderType, Mode=TwoWay}" />
                            </StackPanel>

                            <CheckBox Style="{StaticResource ModernSwitchCheckBoxStyle}"
                                      Content="设为默认端点"
                                      Margin="0,22,0,6"
                                      IsChecked="{Binding NewCloudEndpointIsDefault, Mode=TwoWay}" />
                        </WrapPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="目录路径或服务端点 URL（LocalFolder / https://...）"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Height="30"
                                         Padding="8,4"
                                         FontFamily="{StaticResource SpawnMonoFont}"
                                         FontSize="12"
                                         Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         BorderThickness="1"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         Text="{Binding NewCloudEndpointUrl, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryCapsuleButtonStyle}"
                                    Height="30"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="8,20,0,0"
                                    Content="浏览目录…"
                                    Command="{Binding BrowseLocalCloudEndpointFolderCommand}"
                                    Visibility="{Binding NewCloudProviderType, Converter={StaticResource EqToVis}, ConverterParameter=LocalFolder}" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding IsNewCloudEndpointRemote, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="Bucket / 远程根路径" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                                <TextBox Width="180"
                                         Height="30"
                                         Padding="8,4"
                                         FontFamily="{StaticResource SpawnMonoFont}"
                                         FontSize="12"
                                         Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         BorderThickness="1"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         Text="{Binding NewCloudBucketOrRoot, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,12,6"
                                        Visibility="{Binding NewCloudProviderType, Converter={StaticResource EqToVis}, ConverterParameter=S3}">
                                <TextBlock Text="Region（如 auto / us-east-1）" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                                <TextBox Width="148"
                                         Height="30"
                                         Padding="8,4"
                                         FontFamily="{StaticResource SpawnMonoFont}"
                                         FontSize="12"
                                         Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         BorderThickness="1"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         Text="{Binding NewCloudRegion, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="用户名 / Access Key ID" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                                <TextBox Width="180"
                                         Height="30"
                                         Padding="8,4"
                                         FontFamily="{StaticResource SpawnMonoFont}"
                                         FontSize="12"
                                         Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         BorderThickness="1"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         Text="{Binding NewCloudUsernameOrAccessKey, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="密码 / Secret Key（DPAPI 加密）" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                                <PasswordBox x:Name="EndpointSecretPasswordBox"
                                             Width="200"
                                             Height="30"
                                             Padding="8,4"
                                             FontFamily="{StaticResource SpawnMonoFont}"
                                             FontSize="12"
                                             Background="{DynamicResource CapsuleInputBackgroundBrush}"
                                             BorderBrush="{DynamicResource ControlBorderBrush}"
                                             BorderThickness="1"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             AutomationProperties.Name="云同步密码或密钥" />
                            </StackPanel>
                        </WrapPanel>

                        <Button Style="{StaticResource PrimaryCapsuleButtonStyle}"
                                Height="34"
                                Padding="16,0"
                                HorizontalAlignment="Left"
                                Content="保存云同步端点"
                                Click="OnSaveCloudEndpointButtonClick" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
