<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Spawn.OverlayHost</RootNamespace>
    <AssemblyName>Spawn.OverlayHost</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spawn.Contracts\Spawn.Contracts.csproj" />
    <ProjectReference Include="..\Spawn.Core\Spawn.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
</Project>
