<Window x:Class="Spawn.OverlayHost.Views.OverlayToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPAWN Achievement Overlay"
        Width="408"
        Height="116"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        Typography.NumeralAlignment="Tabular"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="RootStage"
          Margin="10"
          Opacity="0"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="StageScale" ScaleX="0.97" ScaleY="0.97" />
                <TranslateTransform x:Name="StageTranslate" X="0" Y="22" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- ============================================================== -->
        <!-- Theme 1: Steam Classic / Steam Deck Modern Glow                -->
        <!-- ============================================================== -->
        <Border x:Name="SteamCard"
                Visibility="Visible"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="#3D526B"
                ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F41B2838" Offset="0.0" />
                    <GradientStop Color="#F6171E29" Offset="0.55" />
                    <GradientStop Color="#F6212D3F" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <!-- Top cyan accent rim -->
                <Border Height="2" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#1A9FFF" Offset="0.0" />
                            <GradientStop Color="#66C0F4" Offset="0.5" />
                            <GradientStop Color="#0066C0F4" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Content layout -->
                <Grid Margin="14,13,16,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="58"
                            Height="58"
                            CornerRadius="8"
                            Background="#243447"
                            BorderBrush="#4A6482"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Grid>
                            <Path x:Name="SteamFallbackGlyph"
                                  Data="M12,3 L14.6,8.3 L20.5,9.1 L16.2,13.3 L17.2,19.1 L12,16.4 L6.8,19.1 L7.8,13.3 L3.5,9.1 L9.4,8.3 Z"
                                  Fill="#66C0F4"
                                  Stretch="Uniform"
                                  Width="26"
                                  Height="26"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                            <Image x:Name="SteamIconImage"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <DockPanel LastChildFill="False" Margin="0,0,0,3">
                            <TextBlock x:Name="SteamHeaderText"
                                       Text="成就已解锁"
                                       Foreground="#66C0F4"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       DockPanel.Dock="Left" />
                            <Border x:Name="SteamRareBadge"
                                    Visibility="Collapsed"
                                    CornerRadius="4"
                                    Background="#33F59E0B"
                                    BorderBrush="#88F59E0B"
                                    BorderThickness="1"
                                    Padding="5,1"
                                    Margin="8,0,0,0"
                                    DockPanel.Dock="Left">
                                <TextBlock x:Name="SteamRareText"
                                           Text="稀有"
                                           Foreground="#FCD34D"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                        </DockPanel>
                        <TextBlock x:Name="SteamTitleText"
                                   Text="成就名称"
                                   Foreground="#FFFFFF"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SteamDescText"
                                   Text="成就解锁条件说明"
                                   Foreground="#B8C4D0"
                                   FontSize="12"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Bottom lifetime bar -->
                <Border Height="2.5"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Width="388"
                        Background="#66C0F4"
                        Opacity="0.85"
                        RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="SteamProgressScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- Theme 2: PS5 Trophy Capsule (Bronze / Silver / Gold / Platinum)-->
        <!-- ============================================================== -->
        <Border x:Name="Ps5Card"
                Visibility="Collapsed"
                CornerRadius="24"
                BorderThickness="1.2"
                BorderBrush="#42FFFFFF"
                ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="Ps5BgStop1" Color="#F212151E" Offset="0.0" />
                    <GradientStop x:Name="Ps5BgStop2" Color="#F51B2030" Offset="0.6" />
                    <GradientStop x:Name="Ps5BgStop3" Color="#F224293D" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="16,12,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="56"
                        Height="56"
                        CornerRadius="16"
                        Background="#28FFFFFF"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Grid>
                        <Path x:Name="Ps5FallbackGlyph"
                              Data="M7,4 H17 V8 C17,11.3 14.8,13.8 12,14.6 V17 H15 V19 H9 V17 H12 V14.6 C9.2,13.8 7,11.3 7,8 Z M5,5 H7 V8 C5.8,8 5,7 5,5.8 Z M17,5 H19 V5.8 C19,7 18.2,8 17,8 Z"
                              Fill="#FBBF24"
                              Stretch="Uniform"
                              Width="28"
                              Height="28"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                        <Image x:Name="Ps5IconImage"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="Ps5GradeLabel"
                               Text="已获得奖杯 · 金杯"
                               Foreground="#FCD34D"
                               FontSize="11.5"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="Ps5TitleText"
                               Text="奖杯名称"
                               Foreground="#FFFFFF"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="Ps5DescText"
                               Text="奖杯条件描述"
                               Foreground="#CBD5E1"
                               FontSize="12"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Right Trophy Crest -->
                <Border x:Name="Ps5CrestBadge"
                        Grid.Column="3"
                        Width="34"
                        Height="34"
                        CornerRadius="17"
                        Background="#26FBBF24"
                        BorderBrush="#66FBBF24"
                        BorderThickness="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                    <Path x:Name="Ps5CrestPath"
                          Data="M7,4 H17 V8 C17,11.3 14.8,13.8 12,14.6 V17 H15 V19 H9 V17 H12 V14.6 C9.2,13.8 7,11.3 7,8 Z"
                          Fill="#FBBF24"
                          Stretch="Uniform"
                          Width="17"
                          Height="17"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- Theme 3: Xbox Rare Purple Diamond Capsule                      -->
        <!-- ============================================================== -->
        <Border x:Name="XboxCard"
                Visibility="Collapsed"
                CornerRadius="26"
                BorderThickness="1.2"
                BorderBrush="#66A855F7"
                ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="XboxBgStop1" Color="#F413111C" Offset="0.0" />
                    <GradientStop x:Name="XboxBgStop2" Color="#F51E1633" Offset="0.55" />
                    <GradientStop x:Name="XboxBgStop3" Color="#F415222E" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="14,12,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="56"
                        Height="56"
                        CornerRadius="28"
                        Background="#2E8B5CF6"
                        BorderBrush="#88A855F7"
                        BorderThickness="1.2"
                        ClipToBounds="True">
                    <Grid>
                        <Path x:Name="XboxFallbackGlyph"
                              Data="M12,2 L21,12 L12,22 L3,12 Z"
                              Fill="#C084FC"
                              Stretch="Uniform"
                              Width="24"
                              Height="24"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                        <Image x:Name="XboxIconImage"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="XboxHeaderText"
                               Text="稀有成就已解锁"
                               Foreground="#C084FC"
                               FontSize="11.5"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="XboxTitleText"
                               Text="成就名称"
                               Foreground="#FFFFFF"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="XboxDescText"
                               Text="成就解锁条件"
                               Foreground="#D8B4FE"
                               FontSize="12"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Diamond Rarity Pill -->
                <Border x:Name="XboxDiamondBadge"
                        Grid.Column="3"
                        CornerRadius="12"
                        Background="#33A855F7"
                        BorderBrush="#88C084FC"
                        BorderThickness="1"
                        Padding="8,4"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M6,0 L12,6 L6,12 L0,6 Z"
                              Fill="#E9D5FF"
                              Width="10"
                              Height="10"
                              Stretch="Uniform"
                              Margin="0,0,5,0"
                              VerticalAlignment="Center" />
                        <TextBlock x:Name="XboxPercentText"
                                   Text="4.2%"
                                   Foreground="#F3E8FF"
                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas, Microsoft YaHei UI, Microsoft YaHei"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Shared Diagonal Specular Shimmer Sweep -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle x:Name="ShimmerBand"
                       Width="96"
                       Height="160"
                       Canvas.Top="-24"
                       Canvas.Left="-130"
                       Opacity="0.0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0.0" />
                        <GradientStop Color="#36FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <SkewTransform AngleX="-24" />
                        <TranslateTransform x:Name="ShimmerTranslate" X="0" />
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>
    </Grid>
</Window>
